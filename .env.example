# Aggregate Analytics - Environment Configuration Example
# Copy this file to .env.local and adjust the values for your deployment

###> symfony/framework-bundle ###
APP_ENV=prod
APP_SECRET=CHANGE_ME_TO_RANDOM_STRING
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Database connection
# PostgreSQL (recommended):
DATABASE_URL="postgresql://app:CHANGE_PASSWORD@database:5432/app?serverVersion=16&charset=utf8"
# MySQL:
# DATABASE_URL="mysql://app:CHANGE_PASSWORD@database:3306/app?serverVersion=8.0&charset=utf8mb4"
# SQLite (development only):
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Message queue transport
# Database-backed (simple, good for small/medium deployments):
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
# RabbitMQ (recommended for high-volume production):
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@rabbitmq:5672/%2f/messages
# Redis:
# MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages
###< symfony/messenger ###

###> aggregate analytics ###
# REQUIRED: Random secret used for daily IP hashing
# Generate with: openssl rand -base64 32
DAILY_SALT_SECRET=CHANGE_ME_TO_RANDOM_STRING

# Optional: Rate limit per IP per minute (default: 100)
# RATE_LIMIT_PER_MINUTE=100

# Optional: Public hostname for documentation
# APP_HOST=https://analytics.example.com
 you
# Optional: JavaScript namespace (default: MyAnalytics)
# Controls the global variable name: window.{JS_NAMESPACE}
# Examples: MyAnalytics, Company1Analytics, Tracker, etc.
# JS_NAMESPACE=MyAnalytics
###< aggregate analytics ###

###> symfony/mailer ###
# Only needed if sending emails
MAILER_DSN=null://null
###< symfony/mailer ###

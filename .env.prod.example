# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=prod
APP_DEBUG=0
# IMPORTANT: Generate a secure secret with: openssl rand -base64 32
APP_SECRET=CHANGE_ME_TO_RANDOM_SECRET
# Comma-separated exact proxy IPs/CIDRs only. Leave blank for direct traffic.
TRUSTED_PROXIES=
###< symfony/framework-bundle ###

# Database Configuration (required)
#
# Examples:
# PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/dbname?serverVersion=16"
# MySQL:      DATABASE_URL="mysql://user:password@localhost:3306/dbname?serverVersion=8.0"
# SQLite:     DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
#
# For Docker: set DOCKER_DATABASE_URL for non-MySQL profiles
# For Native: set DATABASE_URL directly
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"

###> symfony/mailer ###
# For production, configure a real mailer DSN
# Examples:
# MAILER_DSN=smtp://user:pass@smtp.example.com:587
# MAILER_DSN=sendmail://default
MAILER_DSN=null://null
###< symfony/mailer ###

###> symfony/messenger ###
# Quick mode (default, no worker required):
MESSENGER_TRANSPORT_DSN=sync://
# Async scale-up mode (worker required):
# MESSENGER_TRANSPORT_DSN=doctrine://default
###< symfony/messenger ###

# Analytics Configuration
# Main analytics settings are stored in config/aggregate.yaml.
# Available there:
#   - rate_limit_per_minute
#   - app_host
#   - js_namespace
#   - dashboard_enabled
#   - anonymous_tracking_enabled
#   - anonymous_excluded_paths
#   - anonymous_geo_enabled
#   - anonymous_geo_level
#   - anonymous_geo_database_path
#
# BI disclosure thresholds are managed in the dashboard and stored in
# analytics_privacy_settings.
#
# Optional env override for API-only mode:
# DASHBOARD_ENABLED=0
# ANONYMOUS_TRACKING_ENABLED=0
# ANONYMOUS_GEO_ENABLED=0
# TRUSTED_PROXIES accepts only exact proxy IPs/narrow CIDRs; never use
# 0.0.0.0/0, ::/0, or the REMOTE_ADDR shortcut.
# After changing DASHBOARD_ENABLED, run: php bin/console cache:clear

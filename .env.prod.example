# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=prod
# IMPORTANT: Generate a secure secret with: openssl rand -base64 32
APP_SECRET=CHANGE_ME_TO_RANDOM_SECRET
###< symfony/framework-bundle ###

# Database Configuration
# Configure your main database connection in config/aggregate.yaml instead
# This is kept here for Symfony compatibility
#
# Examples:
# PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/dbname?serverVersion=16"
# MySQL:      DATABASE_URL="mysql://user:password@localhost:3306/dbname?serverVersion=8.0"
# SQLite:     DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
#
# For Docker: This is automatically set by docker-compose
# For Native: Set this or use config/aggregate.yaml
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"

###> symfony/mailer ###
# For production, configure a real mailer DSN
# Examples:
# MAILER_DSN=smtp://user:pass@smtp.example.com:587
# MAILER_DSN=sendmail://default
MAILER_DSN=null://null
###< symfony/mailer ###

###> symfony/messenger ###
# Configure message queue in config/aggregate.yaml for environment-specific settings
# This is a fallback only
# MESSENGER_TRANSPORT_DSN=doctrine://default
###< symfony/messenger ###

# Analytics Configuration
# IMPORTANT: Main configuration should be in config/aggregate.yaml
# That file supports environment-specific settings (dev, prod, test)
#
# Required in config/aggregate.yaml:
#   - daily_salt_secret (generate with: openssl rand -base64 32)
#   - database_url
#   - messenger_transport_dsn
#
# Optional:
#   - rate_limit_per_minute (default: 100)
#   - app_host (for documentation)
#   - js_namespace (default: Aggregate)

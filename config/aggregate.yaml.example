# Aggregate Analytics — App Configuration
# Copy this file to config/aggregate.yaml and adjust values.
#
# DATABASE_URL and MESSENGER_TRANSPORT_DSN are standard Symfony env vars.
# Set them in your .env file (see .env.dev for local dev, your server's .env for prod).
# They do NOT belong here.

# Where updates come from (also editable on the dashboard Updates page):
#   auto    - Git pull when this directory is a Git checkout, release packages otherwise
#   release - signed release ZIPs from the repository's GitHub Releases; works for any
#             installation, including Plesk Git deployments and copied files
#   git     - fast-forward pulls of a Git checkout in this directory
updates_source: auto
# Git pulls use this branch; release packages must have been published from it.
# Source pulls require the local checkout to be on this branch.
updates_branch: master
# GitHub repository (owner/name) for both sources. YAML only; the dashboard shows
# but cannot change it. Releases from another repository must be signed with a key
# this installation trusts (see updates_signing_public_key).
# updates_repository: Subschema-LLC/aggregate
# Normally packages ship config/release-signing.pub. To use a separately trusted
# public key instead, set this base64 Ed25519 public key in the active environment:
# updates_signing_public_key: 'BASE64_PUBLIC_KEY'
# Never put the private release signing key in application configuration.

# Deployment-wide feature flags, managed through the Feature flags admin page
# or this YAML. No uppercase environment-variable overrides. See docs/FEATURE-FLAGS.md.
# An active environment's entire feature_flags mapping replaces this shared one.
feature_flags:
  updates:
    enabled: true
    hide_from_navigation: false
# enabled: false blocks update routes/services/commands. Independently, true
# hide_from_navigation removes their navigation entries. A disabled visible
# feature appears as an inactive item without a link. Use YAML booleans only.

# Optional shared tag configuration, selected as Shared configuration in
# Collection → Tag manager. Per-website tags/CMP use separate files at
# config/tag-manager/sites/<site-id>.yaml; run app:tag-manager:sites to list IDs.
# New website instances do not inherit this mapping. No database storage or
# uppercase environment override. An active environment replaces this whole
# mapping. Tags default to analytics consent; explicitly use none for an action
# that needs no consent. See docs/TAG-MANAGER.md.
tag_manager:
  enabled: false
  variables: {}
  # variables: { order_total: ecommerce.total_minor, first_sku: 'ecommerce.items[0].sku' }
  tags: []
  # tags:
  #   - { id: metrics, src: 'https://stats.example.com/client.js', enabled: true, consent: analytics }
  #   - { id: preferences, src: 'https://static.example.com/preferences.js', enabled: true, consent: functional }
  #   - { id: essential, src: 'https://static.example.com/essential.js', enabled: true, consent: none }
  #   - id: purchase
  #     type: call
  #     method: Aggregate.emit
  #     args: [purchase, {total_minor: {$var: order_total}}]
  #     consent: analytics
  #     trigger: {type: data_layer, event: purchase}

# Shared custom data model; active environments can replace either mapping.
# All UTMs require enhanced consent by default. For anonymous attribution,
# prefer only utm_medium with broad channel values (email/social/cpc).
# You MAY override this advice with consent_required: false on any property.
# WARNING: finer source/campaign/term/content/id data can reveal campaigns,
# searches, or identifiers. Review values and disclosures. Even utm_medium
# can contain identifiers; whitelisting a key does not anonymize its values.
# Edit via the Data model UI or YAML; see docs/DATA-MODEL.md.
# Optional page depth on all events, including anonymous events. Default off.
# Carries a number (1..20, with 20 meaning 20+) using the method below.
# Review the method's storage/URL disclosures and consent requirements.
page_sequence_enabled: false
page_sequence_method: session_storage # session_storage (default) or url_parameter
# url_parameter uses ?aggregate_page_sequence=2 on ordinary internal links,
# without counter Web Storage, then removes it from the address bar after capture.
# Clean-URL reloads restart at 1. Initial requests can still log the parameter.
# Review SEO/canonicals, signed URLs, router integration and sharing.
custom_data_properties:
  utm_source: { description: 'Campaign source.', consent_required: true, column: utm_source }
  utm_medium: { description: 'Broad marketing channel, such as email, social, or cpc.', consent_required: true, column: utm_medium }
  utm_campaign: { description: 'Campaign name.', consent_required: true, column: utm_campaign }
  utm_term: { description: 'Campaign search term.', consent_required: true, column: utm_term }
  utm_content: { description: 'Campaign creative or content variant.', consent_required: true, column: utm_content }
  utm_id: { description: 'Campaign identifier.', consent_required: true, column: utm_id }
  # orgInternalTraffic: { description: 'Shared organization marker.', consent_required: true, column: organization_traffic }
  # Optional typed properties: omit type (or use scalar) to keep existing behavior.
  # Types: scalar, string, integer, float, double, boolean; null is always allowed.
  # column stays text. A separate numeric_column requires integer/float/double.
  # Use distinct aliases and review/regenerate views; never repurpose a text alias.
  # currency: { type: string, consent_required: true, column: currency }
  # page_sequence: { type: integer, consent_required: false, numeric_column: page_sequence_number }
  # The page_sequence definition only adds reporting metadata; the switch above
  # controls collection. Never map URL parameters to this tracker-generated key.
  # total_minor: { type: integer, consent_required: true, column: total_minor_text, numeric_column: total_minor_number }
  # discount_rate: { type: double, consent_required: true, numeric_column: discount_rate_number }
  # Money: use integer minor units plus currency. float/double are approximate.
  # Send numeric/boolean values through emit(); query strings are not coerced.
  # See docs/EVENT-EXAMPLES.md for a flat ecommerce recipe and headless export.
# Declared BI metadata only; publishes codes and text to routine BI users.
# Do not include personal text. Consent-gated property codes become public to BI
# users when declared here. Goals keep default labels in config/goals.yaml.
# See docs/BI-GLOSSARY.md. No environment-variable override; an environment
# mapping replaces this entire block. Run app:analytics:glossary:sync after edits.
# bi_glossary:
#   default_locale: en
#   locales: [en, es, fr-CA]
#   values:
#     device_class:
#       tablet:
#         label: { es: 'Tableta' }
#     event_name:
#       newsletter_signup:
#         label: 'Newsletter sign-up'
#         description: 'Sent after double opt-in confirmation.'
#     utm_medium:
#       cpc: { label: 'Paid search', sort: 10 }
#   columns:
#     bi_anonymous_events_v1:
#       event_count: { label: { es: 'Eventos' } }
query_parameter_mappings:
  utm_source: utm_source
  utm_medium: utm_medium
  utm_campaign: utm_campaign
  utm_term: utm_term
  utm_content: utm_content
  utm_id: utm_id
  # campaign: utm_campaign # Alias: first nonblank value in mapping order wins.
# Use query_parameter_mappings: {} to disable automatic query capture.
# Apply reporting aliases with UI/CLI view regeneration after saving.
# Numeric aliases follow text aliases. Later text additions can require an
# explicit reporting migration when numeric aliases have already been deployed.

environments:
  dev:
    rate_limit_per_minute: 1000
    app_host: "http://localhost"
    brand_name: "Aggregate Analytics"
    brand_logo_text: "Aggregate Analytics"
    brand_logo_path: ""
    brand_primary_color: "#00D1B2"
    brand_accent_color: "#485FC7"
    brand_navbar_color: "#14161A"
    brand_background_color: "#F5F5F5"
    brand_surface_color: "#FFFFFF"
    brand_text_color: "#363636"
    brand_font_family: "system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif"
    brand_heading_font_family: "system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif"
    js_namespace: "Aggregate"
    dashboard_enabled: true
    internal_traffic_storage: cookie
    internal_traffic_name: orgInternalTraffic
    internal_traffic_value: 'true'
    internal_traffic_cookie_domain: ''
    internal_traffic_share_token: ''
    collection_profile: standard
    anonymous_tracking_enabled: true
    anonymous_excluded_paths: []
    anonymous_geo_enabled: false
    anonymous_geo_level: "macro_region"
    anonymous_geo_database_path: ""
    analytics_archiving_enabled: false
    analytics_archive_after_days: 90
    analytics_retention_enabled: false
    analytics_anonymous_retention_days: 365
    analytics_enhanced_retention_days: 90
    analytics_archive_retention_days: 730
    analytics_maintenance_batch_size: 1000

  prod:
    rate_limit_per_minute: 100
    app_host: "https://analytics.example.com"
    brand_name: "Aggregate Analytics"
    brand_logo_text: "Aggregate Analytics"
    brand_logo_path: ""
    brand_primary_color: "#00D1B2"
    brand_accent_color: "#485FC7"
    brand_navbar_color: "#14161A"
    brand_background_color: "#F5F5F5"
    brand_surface_color: "#FFFFFF"
    brand_text_color: "#363636"
    brand_font_family: "system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif"
    brand_heading_font_family: "system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif"
    js_namespace: "Aggregate"
    dashboard_enabled: true
    internal_traffic_storage: cookie
    internal_traffic_name: orgInternalTraffic
    internal_traffic_value: 'true'
    internal_traffic_cookie_domain: ''
    internal_traffic_share_token: ''
    collection_profile: standard
    anonymous_tracking_enabled: true
    anonymous_excluded_paths: []
    anonymous_geo_enabled: false
    anonymous_geo_level: "macro_region"
    anonymous_geo_database_path: ""
    analytics_archiving_enabled: false
    analytics_archive_after_days: 90
    analytics_retention_enabled: false
    analytics_anonymous_retention_days: 365
    analytics_enhanced_retention_days: 90
    analytics_archive_retention_days: 730
    analytics_maintenance_batch_size: 1000

  test:
    rate_limit_per_minute: 1000
    brand_name: "Aggregate Analytics"
    brand_logo_text: "Aggregate Analytics"
    brand_logo_path: ""
    brand_primary_color: "#00D1B2"
    brand_accent_color: "#485FC7"
    brand_navbar_color: "#14161A"
    brand_background_color: "#F5F5F5"
    brand_surface_color: "#FFFFFF"
    brand_text_color: "#363636"
    brand_font_family: "system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif"
    brand_heading_font_family: "system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif"
    js_namespace: "Aggregate"
    dashboard_enabled: true
    internal_traffic_storage: cookie
    internal_traffic_name: orgInternalTraffic
    internal_traffic_value: 'true'
    internal_traffic_cookie_domain: ''
    internal_traffic_share_token: ''
    collection_profile: standard
    anonymous_tracking_enabled: true
    anonymous_excluded_paths: []
    anonymous_geo_enabled: false
    anonymous_geo_level: "macro_region"
    anonymous_geo_database_path: ""
    analytics_archiving_enabled: false
    analytics_archive_after_days: 90
    analytics_retention_enabled: false

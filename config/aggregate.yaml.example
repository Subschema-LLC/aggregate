# Aggregate Analytics — App Configuration
# Copy this file to config/aggregate.yaml and adjust values.
#
# DATABASE_URL and MESSENGER_TRANSPORT_DSN are standard Symfony env vars.
# Set them in your .env file (see .env.dev for local dev, your server's .env for prod).
# They do NOT belong here.

environments:
  dev:
    rate_limit_per_minute: 1000
    app_host: "http://localhost"
    js_namespace: "Aggregate"
    dashboard_enabled: true
    anonymous_tracking_enabled: true
    anonymous_excluded_paths: []
    anonymous_geo_enabled: false
    anonymous_geo_level: "macro_region"
    anonymous_geo_database_path: ""

  prod:
    rate_limit_per_minute: 100
    app_host: "https://analytics.example.com"
    js_namespace: "Aggregate"
    dashboard_enabled: true
    anonymous_tracking_enabled: true
    anonymous_excluded_paths: []
    anonymous_geo_enabled: false
    anonymous_geo_level: "macro_region"
    anonymous_geo_database_path: ""

  test:
    rate_limit_per_minute: 1000
    js_namespace: "Aggregate"
    dashboard_enabled: true
    anonymous_tracking_enabled: true
    anonymous_excluded_paths: []
    anonymous_geo_enabled: false
    anonymous_geo_level: "macro_region"
    anonymous_geo_database_path: ""

# Configuration options:
#
# rate_limit_per_minute (optional, default: 100)
#   Maximum API requests per IP per minute.
#
# app_host (optional)
#   Public hostname used in dashboard integration snippets.
#   Example: https://analytics.example.com
#
# js_namespace (optional, default: Aggregate)
#   JavaScript global variable name: window.{js_namespace}
#   Examples: Aggregate, MyAnalytics, Tracker
#
# dashboard_enabled (optional, default: true)
#   Enable dashboard/install/login UI routes.
#   Set to false for API-only headless deployments managed via CLI/YAML.
#
# anonymous_tracking_enabled (optional, default: true)
#   Administrative collection kill switch. Set to false to reject both anonymous
#   and consented enhanced events at the ingestion boundary.
#
# anonymous_excluded_paths (optional, default: [])
#   Paths that must never be collected in either mode. Supports glob patterns
#   such as /account/*, /checkout/**, and /health.
#
# anonymous_geo_enabled (optional, default: false)
#   Derive a coarse area from the request IP for accepted analytics events. Requires
#   a local GeoLite2-Country-compatible MMDB. The IP and detailed lookup record
#   are not added to the event or queue. A lookup failure produces no geo area
#   and does not reject the event.
#
# anonymous_geo_level (optional, default: macro_region)
#   Stored granularity: macro_region or country. Macro-region stores only the
#   MMDB continent code. City, subdivision, postcode, and coordinates are never
#   retained.
#
# anonymous_geo_database_path (optional, default: "")
#   Local GeoLite2-Country-compatible .mmdb file. Use an absolute path
#   (recommended) or a path contained by the project root. Mount it read-only
#   and make it readable by the ingestion process. URI schemes and relative
#   project-root escapes are rejected, as are UNC/network-share and Windows
#   device paths. The app never downloads or sends lookups to a GeoIP service.

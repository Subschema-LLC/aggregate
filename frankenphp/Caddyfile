# frankenphp/Caddyfile

{
    frankenphp
    auto_https off
}

:9002 {
    root * /app/public

    # Handle assets first - before the route block
        @assets path /assets/*
        handle @assets {
            file_server
        }

    # A route block is mandatory to order the request handlers.
    route {
        # The tracking script includes runtime YAML settings from Symfony.
        @tracker path /aggregate.js
        rewrite @tracker /index.php

        # This single directive is the most robust way to handle
        # a front-controller pattern like Symfony's. It will:
        # 1. Look for a static file matching the path (e.g., /style.css).
        # 2. If not found, it internally rewrites the path to /index.php,
        #    keeping the original URL so Symfony's router can see it.
        try_files {path} /index.php?{query}

        # The request is then passed to php_server. It will either serve
        # the static file found by try_files, or execute the rewritten
        # index.php request.
        php_server
    }

    # Access logging is intentionally disabled here. Tracking requests expose
    # network identifiers before application-level anonymization can run.
}

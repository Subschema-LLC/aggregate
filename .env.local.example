# =============================================================================
# .env.local — Production environment overrides for Plesk deployment
# =============================================================================
# Copy this file to .env.local and fill in the values.
# This file is NOT committed to git and should stay on the server only.
#
# Generate APP_SECRET with:   openssl rand -hex 32
# =============================================================================

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_hex_32

# Infrastructure settings belong in .env/.env.local:
# - DATABASE_URL
# - MESSENGER_TRANSPORT_DSN
# - APP_SECRET
#
# App-level analytics settings belong in config/aggregate.yaml:
# - daily_salt_secret
# - rate_limit_per_minute
# - app_host
# - js_namespace
# - dashboard_enabled
#
# Optional env override for API-only mode:
# DASHBOARD_ENABLED=0
# After changing DASHBOARD_ENABLED, run: php bin/console cache:clear

DATABASE_URL="mysql://db_user:db_pass@localhost:3306/db_name?serverVersion=8.0"
# Quick mode (default, no worker required):
MESSENGER_TRANSPORT_DSN=sync://
# Async scale-up mode (worker required):
# MESSENGER_TRANSPORT_DSN=doctrine://default
MAILER_DSN=null://null

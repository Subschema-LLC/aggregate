# =============================================================================
# .env.local — Production environment overrides for Plesk deployment
# =============================================================================
# Copy this file to .env.local and fill in the values.
# This file is NOT committed to git and should stay on the server only.
#
# Generate APP_SECRET with:   openssl rand -hex 32
# =============================================================================

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_hex_32

# NOTE: Database credentials and other app settings go in config/aggregate.yaml,
# NOT here. The database_url below is kept for Symfony compatibility only and
# will be overridden by config/aggregate.yaml at runtime.
#
# DATABASE_URL is read from config/aggregate.yaml — you do not need to set it here.

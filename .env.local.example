# =============================================================================
# .env.local — Production environment overrides for this server
# =============================================================================
# Copy this file to .env.local and fill in the values.
# This file is NOT committed to git and should stay on the server only.
#
# Generate APP_SECRET with:   openssl rand -hex 32
# =============================================================================

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_hex_32
# Comma-separated exact proxy IPs/CIDRs only. Leave blank for direct traffic.
TRUSTED_PROXIES=

# Infrastructure settings belong in .env/.env.local:
# - DATABASE_URL
# - REPORTING_DATABASE_URL (optional; see docs/REPORTING-DATABASE.md)
# - MESSENGER_TRANSPORT_DSN
# - APP_SECRET
# - TRUSTED_PROXIES (blank unless exact proxy addresses/CIDRs are known)
#
# App-level analytics settings belong in config/aggregate.yaml:
# - rate_limit_per_minute
# - app_host
# - js_namespace
# - dashboard_enabled
# - anonymous_tracking_enabled
# - anonymous_excluded_paths
# - anonymous_geo_enabled
# - anonymous_geo_level
# - anonymous_geo_database_path
#
# BI disclosure thresholds (anonymous_min_cell_count,
# anonymous_geo_min_cell_count) live in config/aggregate.yaml. These overrides
# take precedence; run app:analytics:bi-views:regenerate after changing either.
# ANONYMOUS_MIN_CELL_COUNT=5
# ANONYMOUS_GEO_MIN_CELL_COUNT=25
#
# Optional env override for API-only mode:
# DASHBOARD_ENABLED=0
# ANONYMOUS_TRACKING_ENABLED=0
# ANONYMOUS_GEO_ENABLED=0
# Never use 0.0.0.0/0, ::/0, or REMOTE_ADDR as a trusted-proxy shortcut.
# After changing DASHBOARD_ENABLED, run: php bin/console cache:clear

# MySQL example. For MariaDB, use its reported version and retain the MariaDB
# marker, for example: serverVersion=11.4.0-MariaDB
DATABASE_URL="mysql://db_user:db_pass@localhost:3306/db_name?serverVersion=8.0.0"
# Optional second database that receives copies of the reporting views for BI
# users; written like DATABASE_URL. See docs/REPORTING-DATABASE.md.
# REPORTING_DATABASE_URL="postgresql://aggregate_sync:password@localhost:5432/aggregate_reporting?serverVersion=16"
# Quick mode (default, no worker required):
MESSENGER_TRANSPORT_DSN=sync://
# Async scale-up mode (worker required):
# MESSENGER_TRANSPORT_DSN=doctrine://default
MAILER_DSN=null://null

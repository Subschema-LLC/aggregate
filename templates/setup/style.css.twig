.setup-steps ol { display: flex; flex-wrap: wrap; gap: .75rem; list-style: none; margin: 0; padding: 0; }
.setup-steps a { display: block; padding: .65rem 1rem; border: 1px solid var(--app-brand-border); border-radius: .35rem; }
#setup-wizard .setup-steps a[aria-current="step"], #setup-wizard .setup-steps a[aria-current="step"]:hover, #setup-wizard .setup-steps a[aria-current="step"]:focus { background: var(--app-brand-primary); color: var(--app-brand-primary-contrast); font-weight: 700; }
.setup-code { max-height: 24rem; overflow: auto; white-space: pre; }
.setup-tour-target { outline: 4px solid var(--app-brand-focus) !important; outline-offset: 4px; }
.setup-callout { background: var(--app-brand-surface); border: 2px solid var(--app-brand-focus); border-radius: .4rem; box-shadow: 0 3px 18px #0003; color: var(--app-brand-text); max-height: calc(100vh - 2rem); overflow: auto; padding: 1rem; position: fixed; width: min(26rem, calc(100vw - 2rem)); z-index: 100; }
.setup-callout[hidden], #setup-tour-start[hidden] { display: none; }
.setup-callout-arrow { background: var(--app-brand-focus); height: .6rem; left: var(--setup-arrow-left, 1rem); position: absolute; top: 0; transform: rotate(45deg); width: .6rem; }
.setup-callout[data-side="above"] .setup-callout-arrow { bottom: 0; top: auto; }
.setup-callout .title { margin: .4rem 0 .75rem; }
.setup-callout .buttons { margin-bottom: 0; }
.setup-callout .buttons .button { white-space: normal; height: auto; min-height: 2.5rem; }
.setup-step-navigation { justify-content: space-between; }
#setup-wizard .select, #setup-wizard select { max-width: 100%; }

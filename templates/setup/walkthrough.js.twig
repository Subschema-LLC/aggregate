(function () {
    'use strict';
    function initialize() {
        var root = document.getElementById('setup-wizard');
        if (!root || root.dataset.initialized) return;
        root.dataset.initialized = 'true';
        var start = document.getElementById('setup-tour-start');
        var callout = document.getElementById('setup-callout');
        var targets = Array.from(root.querySelectorAll('[data-tour-title]'));
        var title = document.getElementById('setup-callout-title');
        var description = document.getElementById('setup-callout-text');
        var previous = document.getElementById('setup-tour-previous');
        var next = document.getElementById('setup-tour-next');
        var index = -1;
        var priorDescription = null;
        start.hidden = targets.length === 0;

        function clearTarget() {
            if (index < 0) return;
            targets[index].classList.remove('setup-tour-target');
            if (priorDescription === null) targets[index].removeAttribute('aria-describedby');
            else targets[index].setAttribute('aria-describedby', priorDescription);
        }
        function place() {
            if (index < 0 || callout.hidden) return;
            var rect = targets[index].getBoundingClientRect();
            var width = callout.offsetWidth;
            var height = callout.offsetHeight;
            var left = Math.max(16, Math.min(rect.left, window.innerWidth - width - 16));
            var below = rect.bottom + height + 16 <= window.innerHeight;
            var top = below ? rect.bottom + 12 : Math.max(16, rect.top - height - 12);
            callout.style.left = left + 'px';
            callout.style.top = Math.min(top, Math.max(16, window.innerHeight - height - 16)) + 'px';
            callout.dataset.side = below ? 'below' : 'above';
            callout.style.setProperty('--setup-arrow-left', Math.max(10, Math.min(width - 20, rect.left + rect.width / 2 - left)) + 'px');
        }
        function show(position) {
            clearTarget();
            index = position;
            var target = targets[index];
            priorDescription = target.getAttribute('aria-describedby');
            target.setAttribute('aria-describedby', ((priorDescription || '') + ' setup-callout-text').trim());
            target.classList.add('setup-tour-target');
            title.textContent = target.dataset.tourTitle;
            description.textContent = target.dataset.tourText;
            document.getElementById('setup-callout-position').textContent = 'Tip ' + (index + 1) + ' of ' + targets.length;
            previous.disabled = index === 0;
            next.textContent = index === targets.length - 1 ? 'Finish walkthrough' : 'Next tip';
            callout.hidden = false;
            target.scrollIntoView({block: 'center', behavior: 'auto'});
            place();
            title.focus({preventScroll: true});
        }
        function close() {
            clearTarget();
            index = -1;
            callout.hidden = true;
            start.focus();
        }
        start.addEventListener('click', function () { show(0); });
        previous.addEventListener('click', function () { if (index > 0) show(index - 1); });
        next.addEventListener('click', function () { if (index + 1 < targets.length) show(index + 1); else close(); });
        document.getElementById('setup-tour-close').addEventListener('click', close);
        document.addEventListener('keydown', function (event) { if (event.key === 'Escape' && !callout.hidden) close(); });
        window.addEventListener('resize', place);
        window.addEventListener('scroll', place, {passive: true});

        root.querySelectorAll('[data-copy-setup]').forEach(function (button) {
            button.addEventListener('click', async function () {
                var code = document.getElementById(button.dataset.copySetup);
                var feedback = document.getElementById('setup-copy-status');
                try {
                    if (!navigator.clipboard || !navigator.clipboard.writeText) throw new Error('Clipboard unavailable');
                    await navigator.clipboard.writeText(code.textContent);
                    feedback.textContent = 'Copied to clipboard.';
                } catch (error) {
                    var range = document.createRange();
                    range.selectNodeContents(code);
                    var selection = window.getSelection();
                    selection.removeAllRanges();
                    selection.addRange(range);
                    feedback.textContent = 'Clipboard access is unavailable. The code is selected; copy it with your keyboard or use Download.';
                }
            });
        });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initialize);
    else initialize();
})();

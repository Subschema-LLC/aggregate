<nav class="section-tabs-nav mb-5" aria-label="Users pages">
    <div class="tabs section-underline-tabs">
        <ul>
            {% for item in [
                {route: 'app_users', label: 'Users', icon: 'fas fa-user-gear'},
                {route: 'app_permission_groups', label: 'Permission groups', icon: 'fas fa-user-shield'}
            ] %}
                <li class="{% if current_tab == item.route %}is-active{% endif %}">
                    <a href="{{ path(item.route) }}"{% if current_tab == item.route %} aria-current="page"{% endif %}>
                        <span class="icon is-small mr-1"><i class="{{ item.icon }}" aria-hidden="true"></i></span>
                        <span>{{ item.label }}</span>
                    </a>
                </li>
            {% endfor %}
        </ul>
    </div>
</nav>

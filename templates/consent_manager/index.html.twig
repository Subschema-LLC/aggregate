{% extends 'base.html.twig' %}

{% block title %}Consent manager - {{ app_branding.name }}{% endblock %}

{% block stylesheets %}
    {# The banner's own stylesheet, so the preview matches what visitors see. #}
    <link rel="stylesheet" href="{{ asset('consent.css') }}">
{% endblock %}

{% block body %}
<div class="consent-settings">
    <h1 class="title">Consent manager lite</h1>
    <p class="subtitle">The built-in privacy banner that loads with the tag manager: whether it shows, its wording, colors and buttons.</p>
    {{ component('Ui:DocsLink', {topic: 'tracking.consent-manager', label: 'Consent manager guide'}) }}
    {{ component('TagManager:Navigation', {current_page: 'app_consent_manager', selected_site: selected_site}) }}

    {% if sites is empty %}
        <p class="notification is-info is-light">Register a website first. Each website has its own consent manager settings.</p>
    {% else %}
    <form method="get" action="{{ path('app_consent_manager') }}" class="box">
        <div class="field">
            <label class="label" for="consent-manager-site">Website</label>
            <div class="control select"><select id="consent-manager-site" name="site">
                {% for website in sites %}<option value="{{ website.id }}"{% if selected_site == website.id %} selected{% endif %}>{{ website.name }} ({{ website.domain }})</option>{% endfor %}
            </select></div>
        </div>
        <button type="submit" class="button">Open website settings</button>
    </form>

    <h2 class="title is-4" id="consent-manager-scope">{{ site.name }}</h2>
    <div class="content">
        <p>Saved in <code>config/tag-manager/sites/{{ selected_site }}.yaml</code> under <code>consent_manager</code>, where you can also edit them directly. The same validation applies to both. Its categories are enhanced analytics, the ones you add below, and those this website’s enabled tags use on the <a href="{{ path('app_tag_manager', {site: selected_site}) }}">Tag manager</a> page.</p>
        <p>The hosted banner changes within five minutes, as browsers reuse it that long. A banner you downloaded from <a href="{{ path('app_setup', {website: site.token, step: 3, tags: '1'}) }}">Setup</a> to host yourself is a snapshot: download it again after saving. The <a href="{{ path('app_standalone_consent', {siteId: selected_site}) }}">standalone banner</a> is configured separately.</p>
    </div>

    {% if configuration_error %}
        <div class="notification is-danger" role="alert">{{ configuration_error }}</div>
    {% else %}
    <div class="columns" data-controller="pages--consent-manager--index"
         data-pages--consent-manager--index-name-value="{{ form.name }}">
        <div class="column is-7">
        {% component 'Ui:Validation' with {action: path('app_consent_manager_save'), method: 'post', id: 'consent-manager-form', 'aria-labelledby': 'consent-manager-scope', 'data-action': 'input->pages--consent-manager--index#update change->pages--consent-manager--index#update'} %}
        {% block content %}
            {% if restored_form %}
                <div class="notification is-warning" role="alert">
                    <span class="icon is-small mr-1"><i class="fas fa-clock-rotate-left" aria-hidden="true"></i></span>
                    <strong>Values preserved:</strong> Nothing was saved. The settings you entered are shown below so you can correct the error and save again without retyping.
                </div>
            {% endif %}
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('consent_manager_settings') }}">
            <input type="hidden" name="site" value="{{ selected_site }}">

            <div class="box"><fieldset class="consent-settings-fieldset">
                <legend class="title is-5">Banner</legend>
                <div class="field">
                    <label class="label" for="consent-enabled">Built-in consent manager</label>
                    <div class="control select"><select id="consent-enabled" name="enabled" required aria-describedby="consent-enabled-help">
                        <option value="1"{% if form.enabled %} selected{% endif %}>Enabled</option>
                        <option value="0"{% if not form.enabled %} selected{% endif %}>Disabled — use your existing CMP</option>
                    </select></div>
                    <p class="help" id="consent-enabled-help">Disabling it does not grant consent. Connect your own CMP to pass explicit choices to the tag manager and tracker.</p>
                </div>
                <div class="field">
                    <label class="label" for="consent-name">Name</label>
                    <div class="control"><input class="input" id="consent-name" name="name" value="{{ form.name }}" maxlength="120" required data-pages--consent-manager--index-target="nameInput"></div>
                    <p class="help">Shown in the title wherever it contains <code>{name}</code>.</p>
                </div>
                <div class="field">
                    <label class="label" for="consent-privacy-url">Privacy notice URL</label>
                    <div class="control"><input class="input" type="url" id="consent-privacy-url" name="privacy_policy_url" value="{{ form.privacy_policy_url }}" maxlength="2048" placeholder="https://www.example.com/privacy" pattern="https://.+" autocomplete="off"></div>
                    <p class="help">Optional. An HTTPS link to your privacy notice, shown in the banner.</p>
                </div>
            </fieldset></div>

            <div class="box"><fieldset class="consent-settings-fieldset">
                <legend class="title is-5">Categories and other tags</legend>
                <p class="help mb-4">The banner always asks about enhanced analytics and the categories this website’s enabled tag manager tags use. Add categories and tags here for scripts your website loads another way, such as an advertising pixel in your theme or a tag in Google Tag Manager.{% if docs_url('tracking.consent-manager-tags') %} <a href="{{ docs_url('tracking.consent-manager-tags') }}" target="_blank" rel="noopener noreferrer">How other tags work<span class="is-sr-only"> (opens in a new tab)</span></a>{% endif %}</p>
                <div class="field">
                    <label class="label" for="consent-categories">Additional categories</label>
                    <div class="control"><input class="input" id="consent-categories" name="categories" value="{{ form.extra_categories }}" maxlength="1024" placeholder="functional, preferences" autocomplete="off" aria-describedby="consent-categories-help"></div>
                    <p class="help" id="consent-categories-help">Up to 10, separated by commas: lowercase letters, digits, underscores or hyphens, beginning with a letter. The banner asks about them even when no tag uses them. Save to set their labels under <strong>Wording</strong>.</p>
                </div>
                <fieldset class="field">
                    <legend class="label">Tags loaded another way</legend>
                    <p class="help mb-3" id="consent-tags-help">Each tag is named to visitors under its category and starts only once that category is allowed. In your page, give each of its scripts <code>type="text/plain"</code> and the tag’s ID, for example <code>&lt;script type="text/plain" data-consent-tag="meta-pixel" src="https://…"&gt;&lt;/script&gt;</code>. A category not listed above is added. Clear a row to remove its tag.</p>
                    <div class="table-container">
                        <table class="table is-fullwidth is-narrow consent-tags-table">
                            <thead><tr><th scope="col" id="consent-tags-id">ID</th><th scope="col" id="consent-tags-name">Name shown to visitors</th><th scope="col" id="consent-tags-category">Category</th></tr></thead>
                            <tbody>
                                {% set blank_rows = min(3, max_external_tags - form.external_tags|length) %}
                                {% set rows = form.external_tags %}
                                {% if blank_rows > 0 %}{% for i in 1..blank_rows %}{% set rows = rows|merge([{id: '', name: '', category: ''}]) %}{% endfor %}{% endif %}
                                {% for tag in rows %}
                                    <tr>
                                        <td><input class="input is-small" id="consent-tag-{{ loop.index0 }}-id" name="external_tags[{{ loop.index0 }}][id]" value="{{ tag.id }}" maxlength="64" pattern="[A-Za-z][A-Za-z0-9_\-]{0,63}" autocomplete="off" aria-labelledby="consent-tags-id consent-tag-{{ loop.index0 }}-number"></td>
                                        <td><input class="input is-small" id="consent-tag-{{ loop.index0 }}-name" name="external_tags[{{ loop.index0 }}][name]" value="{{ tag.name }}" maxlength="120" autocomplete="off" aria-labelledby="consent-tags-name consent-tag-{{ loop.index0 }}-number"></td>
                                        <td><input class="input is-small" id="consent-tag-{{ loop.index0 }}-category" name="external_tags[{{ loop.index0 }}][category]" value="{{ tag.category }}" maxlength="32" list="consent-category-options" pattern="[a-z][a-z0-9_\-]{0,31}" autocomplete="off" aria-labelledby="consent-tags-category consent-tag-{{ loop.index0 }}-number"><span class="is-sr-only" id="consent-tag-{{ loop.index0 }}-number">tag {{ loop.index }}</span></td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <datalist id="consent-category-options">{% for category in categories %}<option value="{{ category }}"></option>{% endfor %}</datalist>
                    <p class="help">Up to {{ max_external_tags }} tags; save to get more empty rows. Only listed IDs ever start. A tag that already ran keeps running until the visitor reloads the page, even after they withdraw.</p>
                </fieldset>
            </fieldset></div>

            <div class="box"><fieldset class="consent-settings-fieldset">
                <legend class="title is-5">Wording</legend>
                <p class="help mb-4">Each field starts with its current wording. Text that matches the default is not saved, so later improvements to the default wording still reach your banner. Clear a field to restore its default. Text is shown as plain text; HTML is not interpreted.</p>
                <div class="field">
                    <label class="label" for="consent-text-title">Title</label>
                    <div class="control"><input class="input" id="consent-text-title" name="text[title]" value="{{ form.text.title }}" placeholder="{{ default_text.title }}" maxlength="120" data-default="{{ default_text.title }}"></div>
                </div>
                <div class="field">
                    <label class="label" for="consent-text-description">Description</label>
                    <div class="control"><textarea class="textarea" id="consent-text-description" name="text[description]" rows="3" maxlength="1000" placeholder="{{ default_text.description }}" data-default="{{ default_text.description }}">{{ form.text.description }}</textarea></div>
                </div>
                <div class="field">
                    <span class="label" id="consent-details-label">Additional paragraphs</span>
                    {% for paragraph in form.details %}
                        <div class="control mb-2"><textarea class="textarea" id="consent-text-details-{{ loop.index0 }}" name="text[details][]" rows="2" maxlength="1000" aria-labelledby="consent-details-label consent-details-{{ loop.index0 }}-number">{{ paragraph }}</textarea><span class="is-sr-only" id="consent-details-{{ loop.index0 }}-number">paragraph {{ loop.index }}</span></div>
                    {% endfor %}
                    <p class="help">Up to {{ max_details }} paragraphs. Leave them all empty to show none. The defaults explain that anonymous measurement can continue after rejection and what withdrawal does; keep your wording accurate for this website.</p>
                </div>
                <div class="field">
                    <label class="label" for="consent-text-categories-legend">Category list heading</label>
                    <div class="control"><input class="input" id="consent-text-categories-legend" name="text[categories_legend]" value="{{ form.text.categories_legend }}" placeholder="{{ default_text.categories_legend }}" maxlength="120" data-default="{{ default_text.categories_legend }}"></div>
                </div>
                <div class="field">
                    <span class="label">Category labels and default state</span>
                    <p class="help mb-3">Enhanced analytics, the categories added above, and those this website’s tags use. Check <strong>Pre-check</strong> if the category’s checkbox should start selected for new visitors.</p>
                    {% for category, label in form.categories %}
                        <div class="field is-horizontal mb-2">
                            <div class="field-label is-normal"><label class="label has-text-weight-normal" for="consent-category-{{ category }}"><code>{{ category }}</code></label></div>
                            <div class="field-body">
                                <div class="control is-expanded"><input class="input" id="consent-category-{{ category }}" name="text[categories][{{ category }}]" value="{{ label }}" placeholder="{{ default_labels[category] }}" maxlength="120" data-default="{{ default_labels[category] }}" data-category="{{ category }}"></div>
                                <div class="control is-flex is-align-items-center ml-2">
                                    <label class="checkbox is-size-7" for="consent-precheck-{{ category }}">
                                        <input type="checkbox" name="precheck_categories[]" value="{{ category }}" id="consent-precheck-{{ category }}"{% if category in form.precheck_categories %} checked{% endif %} data-precheck-category="{{ category }}" data-action="change->pages--consent-manager--index#update">
                                        Pre-check
                                    </label>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                    <p class="help">Unchecked categories start unselected for new visitors. In regions such as the EU/UK under GDPR, pre-ticked boxes do not constitute valid consent; keep optional categories unselected where opt-in consent is required.</p>
                </div>
                <div class="columns is-multiline">
                    {% for key, label in {reject: 'Reject button', accept: 'Accept button', save: 'Save button', reopen: 'Reopen button', privacy_link: 'Privacy notice link', dismiss: 'Close button (×), US-style', dismiss_reject: 'Close button (×), EU-style', category_tags: 'Tag list under a category'} %}
                        <div class="column is-half">
                            <label class="label" for="consent-text-{{ key }}">{{ label }}</label>
                            <div class="control"><input class="input" id="consent-text-{{ key }}" name="text[{{ key }}]" value="{{ form.text[key] }}" placeholder="{{ default_text[key] }}" maxlength="120" data-default="{{ default_text[key] }}"{% if key == 'category_tags' %} pattern=".*\{tags\}.*" title="Keep {tags} where the tag names go." aria-describedby="consent-category-tags-help"{% endif %}></div>
                            {% if key == 'category_tags' %}<p class="help" id="consent-category-tags-help"><code>{tags}</code> becomes the names of the category’s other tags.</p>{% endif %}
                        </div>
                    {% endfor %}
                </div>
                <p class="help mb-4">The close button shows only ×; its label is read by screen readers and shown as a tooltip. Which label is used depends on the region’s consent type.</p>
                <details>
                    <summary class="has-text-weight-semibold">Screen reader announcements</summary>
                    <p class="help mt-2">Announced after a choice, not shown on screen.</p>
                    {% for key, label in {status_applied: 'After a choice', status_not_saved: 'Added when the browser could not save the choice', status_other_tab: 'After a choice in another tab'} %}
                        <div class="field mt-3">
                            <label class="label" for="consent-text-{{ key }}">{{ label }}</label>
                            <div class="control"><input class="input" id="consent-text-{{ key }}" name="text[{{ key }}]" value="{{ form.text[key] }}" placeholder="{{ default_text[key] }}" maxlength="1000"></div>
                        </div>
                    {% endfor %}
                </details>
            </fieldset></div>

            <div class="box"><fieldset class="consent-settings-fieldset">
                <legend class="title is-5">Colors</legend>
                <p class="help mb-4">Text needs at least 4.5:1 contrast against its background, and buttons need a visible edge (3:1). Saving checks this. Every action button uses the same colors, so no choice looks preferred.</p>
                <div class="columns is-multiline is-mobile">
                    {% for key, label in {background: 'Background', text: 'Text', accent: 'Links, focus and checkboxes', border: 'Banner border', button_background: 'Button background', button_text: 'Button text', button_border: 'Button border'} %}
                        <div class="column is-half-tablet is-full-mobile">
                            <label class="label" for="consent-theme-{{ key }}">{{ label }}</label>
                            <div class="control consent-color"><input type="color" id="consent-theme-{{ key }}" name="theme[{{ key }}]" value="{{ form.theme[key]|lower }}" data-default="{{ default_theme[key]|lower }}" data-theme-key="{{ key }}"><code data-pages--consent-manager--index-target="colorValue" data-theme-key="{{ key }}">{{ form.theme[key] }}</code></div>
                        </div>
                    {% endfor %}
                </div>
                <p class="help" role="status" aria-live="polite" data-pages--consent-manager--index-target="contrast"></p>
                <button type="button" class="button is-small" data-action="pages--consent-manager--index#resetColors">Use default colors</button>
            </fieldset></div>

            <div class="box"><fieldset class="consent-settings-fieldset">
                <legend class="title is-5">Layout and buttons</legend>
                <div class="field">
                    <label class="label" for="consent-layout">Layout</label>
                    <div class="control select"><select id="consent-layout" name="layout" aria-describedby="consent-layout-help">
                        {% for value, label in layouts %}<option value="{{ value }}"{% if form.layout == value %} selected{% endif %}>{{ label }}</option>{% endfor %}
                    </select></div>
                    <p class="help" id="consent-layout-help">The card sits in the bottom-right corner. The bar spans the bottom of the window, with its buttons to the right of the text on wide screens and below it on phones.</p>
                </div>
                <div class="field">
                    <label class="label" for="consent-buttons-show">Buttons and order</label>
                    <div class="control select"><select id="consent-buttons-show" name="buttons[show]" aria-describedby="consent-buttons-help">
                        {% for value, label in arrangements %}<option value="{{ value }}"{% if form.show == value %} selected{% endif %}>{{ label }}</option>{% endfor %}
                    </select></div>
                    <p class="help" id="consent-buttons-help">A reject button is always included, so refusing takes one click, like accepting. Without <strong>Save selection</strong>, the banner has no category checkboxes and the choice is all or nothing.</p>
                </div>
                <div class="field">
                    <label class="label" for="consent-buttons-reopen">Reopen button</label>
                    <div class="control select"><select id="consent-buttons-reopen" name="buttons[reopen]" aria-describedby="consent-reopen-help">
                        {% for value, label in reopen_positions %}<option value="{{ value }}"{% if form.reopen == value %} selected{% endif %}>{{ label }}</option>{% endfor %}
                    </select></div>
                    <p class="help" id="consent-reopen-help">Lets visitors change their choice later. If you hide it, add a link on every page, for example in your footer, that calls <code>AggregateConsent.open()</code>; the guide has an example. Withdrawing consent must stay as easy as giving it.</p>
                </div>
            </fieldset></div>

            <div class="box"><fieldset class="consent-settings-fieldset">
                <legend class="title is-5">Consent behavior</legend>
                <p class="help mb-4">The banner’s consent signal decides whether the tracker uses enhanced or anonymous analytics. Set these to match your legal team’s advice for the visitors this banner serves; regions below can set their own.{% if docs_url('tracking.consent-behavior') %} <a href="{{ docs_url('tracking.consent-behavior') }}" target="_blank" rel="noopener noreferrer">How consent behavior works<span class="is-sr-only"> (opens in a new tab)</span></a>{% endif %}</p>
                <div class="columns is-multiline">
                    <div class="column is-half-tablet">
                        <label class="label" for="consent-type">Consent type</label>
                        <div class="control select is-fullwidth"><select id="consent-type" name="consent_type" aria-describedby="consent-types-help">
                            {% for value, label in consent_types %}<option value="{{ value }}"{% if form.consent_type == value %} selected{% endif %}>{{ label }}</option>{% endfor %}
                        </select></div>
                        <p class="help">Used without regions, and by regions that name no type.</p>
                    </div>
                    <div class="column is-half-tablet">
                        <label class="label" for="consent-close-button">Close button (×)</label>
                        <div class="control select is-fullwidth"><select id="consent-close-button" name="close_button" aria-describedby="consent-close-help">
                            <option value=""{% if form.close_button == '' %} selected{% endif %}>Follow the consent type</option>
                            {% for value, label in close_buttons %}<option value="{{ value }}"{% if form.close_button == value %} selected{% endif %}>{{ label }}</option>{% endfor %}
                        </select></div>
                        <p class="help" id="consent-close-help">By default × rejects all in EU-style and closes without a choice in US-style. Closing without a choice lasts until the visitor’s next browser-tab session.</p>
                    </div>
                </div>
                <fieldset class="field">
                    <legend class="label">Default-on categories (implicit, US-style only)</legend>
                    <input type="hidden" name="default_granted[]" value="">
                    <div class="control">
                        {% for category in categories %}
                            <label class="checkbox mr-4" for="consent-default-granted-{{ category }}">
                                <input type="checkbox" id="consent-default-granted-{{ category }}" name="default_granted[]" value="{{ category }}"{% if category in form.default_granted %} checked{% endif %}>
                                <code>{{ category }}</code>
                            </label>
                        {% endfor %}
                    </div>
                    <p class="help">Allowed before the visitor chooses, until they opt out. Explicit types start every optional category off. Enhanced analytics is on by default in implicit mode.</p>
                </fieldset>
                <div class="field">
                    <input type="hidden" name="respect_gpc" value="0">
                    <label class="checkbox" for="consent-respect-gpc">
                        <input type="checkbox" id="consent-respect-gpc" name="respect_gpc" value="1"{% if form.respect_gpc %} checked{% endif %}>
                        Honor Global Privacy Control
                    </label>
                    <p class="help">When a visitor’s browser sends this signal, nothing is on by default, even in implicit mode. The visitor can still accept.</p>
                </div>
            </fieldset></div>

            <div class="box"><fieldset class="consent-settings-fieldset">
                <legend class="title is-5">Regional consent rules</legend>
                <p class="help mb-3">Optional. Define visitor regions to customize messaging and consent behavior. When 2 or more regions are configured, the banner includes a region dropdown selector; visitors pick their own region. Leave empty to use the consent behavior above for everyone.</p>
                <div class="content is-small mb-4" id="consent-types-help">
                    <p class="mb-1">Consent types:</p>
                    <ul class="mt-1">
                        <li><strong>Implicit, US-style</strong>: a notice. The default-on categories (enhanced analytics unless changed) are allowed until the visitor opts out; × closes without a choice.</li>
                        <li><strong>Explicit, US-style</strong>: optional categories start off; × closes without a choice and keeps them off. Nothing is saved.</li>
                        <li><strong>Explicit, EU-style</strong>: optional categories start off; × rejects them all and saves that choice, like the reject button.</li>
                    </ul>
                    <p>Implicit mode allows enhanced analytics before any choice. Use it only where your legal team has decided that notice and opt-out are lawful for this website.{% if docs_url('tracking.consent-manager-regions') %} <a href="{{ docs_url('tracking.consent-manager-regions') }}" target="_blank" rel="noopener noreferrer">How regions work<span class="is-sr-only"> (opens in a new tab)</span></a>{% endif %}</p>
                </div>

                <div class="field mb-4">
                    <label class="label is-small" for="consent-default-region">Default region to show on banner</label>
                    <div class="control select is-small">
                        <select id="consent-default-region" name="default_region">
                            <option value="">First configured region (default)</option>
                            {% for r in form.regions %}
                                {% if r.id is defined and r.id %}
                                    <option value="{{ r.id }}"{% if (form.default_region|default('')) == r.id or (not form.default_region and r.default) %} selected{% endif %}>
                                        {{ r.name|default(r.id) }} ({{ r.id }})
                                    </option>
                                {% endif %}
                            {% endfor %}
                        </select>
                    </div>
                    <p class="help">The default region shown to new visitors who have not yet selected a region.</p>
                </div>

                <div id="consent-regions-list">
                    {% for index, region in form.regions %}
                        <div class="box is-light mb-3">
                            <div class="columns is-multiline">
                                <div class="column is-half-tablet is-3-widescreen">
                                    <label class="label is-small" for="region-{{ index }}-id">Region ID</label>
                                    <input class="input is-small" id="region-{{ index }}-id" name="regions[{{ index }}][id]" value="{{ region.id }}" placeholder="e.g. eu_eea, us, global" pattern="[a-z0-9_\-]{1,32}">
                                </div>
                                <div class="column is-half-tablet is-4-widescreen">
                                    <label class="label is-small" for="region-{{ index }}-name">Display Name</label>
                                    <input class="input is-small" id="region-{{ index }}-name" name="regions[{{ index }}][name]" value="{{ region.name }}" placeholder="e.g. European Union" maxlength="120">
                                </div>
                                <div class="column is-half-tablet is-4-widescreen">
                                    <label class="label is-small" for="region-{{ index }}-consent-type">Consent type</label>
                                    <div class="select is-small is-fullwidth">
                                        {% set region_type = region.consent_type|default(region.consentType|default(default_consent_type)) %}
                                        <select id="region-{{ index }}-consent-type" name="regions[{{ index }}][consent_type]" aria-describedby="consent-types-help">
                                            {% for value, label in consent_types %}<option value="{{ value }}"{% if region_type == value %} selected{% endif %}>{{ label }}</option>{% endfor %}
                                        </select>
                                    </div>
                                </div>
                                <div class="column is-half-tablet is-1-widescreen is-flex is-align-items-center is-justify-content-center">
                                    <label class="checkbox is-size-7" title="Default region for new visitors">
                                        <input type="checkbox" name="regions[{{ index }}][default]" value="1"{% if region.default %} checked{% endif %}>
                                        Default
                                    </label>
                                </div>
                            </div>
                            <details class="mt-2">
                                <summary class="is-size-7 has-text-weight-semibold">Region overrides (optional)</summary>
                                <div class="columns is-multiline mt-2">
                                    <div class="column is-12">
                                        <label class="label is-small" for="region-{{ index }}-title">Title override</label>
                                        <input class="input is-small" id="region-{{ index }}-title" name="regions[{{ index }}][text][title]" value="{{ region.text.title|default('') }}" placeholder="Leave empty for global title" maxlength="120">
                                    </div>
                                    <div class="column is-12">
                                        <label class="label is-small" for="region-{{ index }}-description">Description override</label>
                                        <textarea class="textarea is-small" id="region-{{ index }}-description" name="regions[{{ index }}][text][description]" rows="2" placeholder="Leave empty for global description" maxlength="1000">{{ region.text.description|default('') }}</textarea>
                                    </div>
                                    <div class="column is-6">
                                        <label class="label is-small" for="region-{{ index }}-accept">Accept / Acknowledge button</label>
                                        <input class="input is-small" id="region-{{ index }}-accept" name="regions[{{ index }}][text][accept]" value="{{ region.text.accept|default('') }}" placeholder="Leave empty for default" maxlength="120">
                                    </div>
                                    <div class="column is-6">
                                        <label class="label is-small" for="region-{{ index }}-reject">Reject / Opt-out button</label>
                                        <input class="input is-small" id="region-{{ index }}-reject" name="regions[{{ index }}][text][reject]" value="{{ region.text.reject|default('') }}" placeholder="Leave empty for default" maxlength="120">
                                    </div>
                                    <div class="column is-6">
                                        <label class="label is-small" for="region-{{ index }}-close-button">Close button (×)</label>
                                        <div class="select is-small is-fullwidth"><select id="region-{{ index }}-close-button" name="regions[{{ index }}][close_button]">
                                            <option value="">Same as the banner</option>
                                            {% for value, label in close_buttons %}<option value="{{ value }}"{% if region.close_button|default('') == value %} selected{% endif %}>{{ label }}</option>{% endfor %}
                                        </select></div>
                                    </div>
                                    <div class="column is-12">
                                        <fieldset>
                                            <legend class="label is-small">Default-on categories (implicit, US-style regions only)</legend>
                                            <label class="checkbox is-size-7 mr-4" for="region-{{ index }}-default-granted-override">
                                                <input type="checkbox" id="region-{{ index }}-default-granted-override" name="regions[{{ index }}][default_granted_override]" value="1"{% if region.default_granted_override is defined or (region.default_granted is defined and '' not in region.default_granted) %} checked{% endif %}>
                                                Use these instead of the banner’s:
                                            </label>
                                            <input type="hidden" name="regions[{{ index }}][default_granted][]" value="">
                                            {% for category in categories %}<label class="checkbox is-size-7 mr-3" for="region-{{ index }}-default-granted-{{ category }}"><input type="checkbox" id="region-{{ index }}-default-granted-{{ category }}" name="regions[{{ index }}][default_granted][]" value="{{ category }}"{% if category in region.default_granted|default([]) %} checked{% endif %}> <code>{{ category }}</code></label>{% endfor %}
                                        </fieldset>
                                    </div>
                                </div>
                            </details>
                        </div>
                    {% endfor %}
                </div>

                <div class="box is-light mb-3">
                    <h4 class="title is-6 mb-2">Add a region</h4>
                    <div class="columns is-multiline">
                        <div class="column is-half-tablet is-3-widescreen">
                            <label class="label is-small" for="new-region-id">Region ID</label>
                            <input class="input is-small" id="new-region-id" name="regions[{{ form.regions|length }}][id]" placeholder="e.g. us, ca, global" pattern="[a-z0-9_\-]{1,32}">
                        </div>
                        <div class="column is-half-tablet is-4-widescreen">
                            <label class="label is-small" for="new-region-name">Display Name</label>
                            <input class="input is-small" id="new-region-name" name="regions[{{ form.regions|length }}][name]" placeholder="e.g. United States" maxlength="120">
                        </div>
                        <div class="column is-half-tablet is-4-widescreen">
                            <label class="label is-small" for="new-region-consent-type">Consent type</label>
                            <div class="select is-small is-fullwidth">
                                <select id="new-region-consent-type" name="regions[{{ form.regions|length }}][consent_type]" aria-describedby="consent-types-help">
                                    {% for value, label in consent_types %}<option value="{{ value }}"{% if value == default_consent_type %} selected{% endif %}>{{ label }}</option>{% endfor %}
                                </select>
                            </div>
                        </div>
                        <div class="column is-half-tablet is-1-widescreen is-flex is-align-items-center is-justify-content-center">
                            <label class="checkbox is-size-7">
                                <input type="checkbox" name="regions[{{ form.regions|length }}][default]" value="1">
                                Default
                            </label>
                        </div>
                    </div>
                    <details class="mt-2">
                        <summary class="is-size-7 has-text-weight-semibold">Region overrides (optional)</summary>
                        <div class="columns is-multiline mt-2">
                            <div class="column is-12">
                                <label class="label is-small" for="new-region-title">Title override</label>
                                <input class="input is-small" id="new-region-title" name="regions[{{ form.regions|length }}][text][title]" placeholder="Leave empty for global title" maxlength="120">
                            </div>
                            <div class="column is-12">
                                <label class="label is-small" for="new-region-description">Description override</label>
                                <textarea class="textarea is-small" id="new-region-description" name="regions[{{ form.regions|length }}][text][description]" rows="2" placeholder="Leave empty for global description" maxlength="1000"></textarea>
                            </div>
                            <div class="column is-6">
                                <label class="label is-small" for="new-region-accept">Accept / Acknowledge button</label>
                                <input class="input is-small" id="new-region-accept" name="regions[{{ form.regions|length }}][text][accept]" placeholder="Leave empty for default" maxlength="120">
                            </div>
                            <div class="column is-6">
                                <label class="label is-small" for="new-region-reject">Reject / Opt-out button</label>
                                <input class="input is-small" id="new-region-reject" name="regions[{{ form.regions|length }}][text][reject]" placeholder="Leave empty for default" maxlength="120">
                            </div>
                            <div class="column is-6">
                                <label class="label is-small" for="new-region-close-button">Close button (×)</label>
                                <div class="select is-small is-fullwidth"><select id="new-region-close-button" name="regions[{{ form.regions|length }}][close_button]">
                                    <option value="">Same as the banner</option>
                                    {% for value, label in close_buttons %}<option value="{{ value }}">{{ label }}</option>{% endfor %}
                                </select></div>
                            </div>
                            <div class="column is-12">
                                <fieldset>
                                    <legend class="label is-small">Default-on categories (implicit, US-style regions only)</legend>
                                    <label class="checkbox is-size-7 mr-4" for="new-region-default-granted-override">
                                        <input type="checkbox" id="new-region-default-granted-override" name="regions[{{ form.regions|length }}][default_granted_override]" value="1">
                                        Use these instead of the banner’s:
                                    </label>
                                    <input type="hidden" name="regions[{{ form.regions|length }}][default_granted][]" value="">
                                    {% for category in categories %}<label class="checkbox is-size-7 mr-3" for="new-region-default-granted-{{ category }}"><input type="checkbox" id="new-region-default-granted-{{ category }}" name="regions[{{ form.regions|length }}][default_granted][]" value="{{ category }}"> <code>{{ category }}</code></label>{% endfor %}
                                </fieldset>
                            </div>
                        </div>
                    </details>
                </div>
            </fieldset></div>

            <button class="button is-primary" type="submit">Save consent manager settings</button>
        {% endblock %}
        {% endcomponent %}
        </div>

        <div class="column is-5">
            <figure class="consent-preview-figure">
                <figcaption class="has-text-weight-semibold mb-2">Preview</figcaption>
                <p class="help mb-3">How the banner looks to a visitor who has not chosen yet. It updates as you edit; nothing here is saved or sent.</p>
                <div data-pages--consent-manager--index-target="barNote"{% if form.layout != 'bar' %} hidden{% endif %}><p class="help mb-3">On the website the bar spans the bottom of the window, with the buttons to the right of the text on wide screens.</p></div>
                {% set theme_style %}{% for key, color in form.theme %}--ac-{{ key|replace({'_': '-'}) }}: {{ color }};{% endfor %}{% endset %}
                <div class="consent-preview" inert>
                    <section class="ac-consent{% if form.layout == 'bar' %} ac-consent--bar{% endif %}" style="{{ theme_style|trim }}" data-pages--consent-manager--index-target="banner">
                        <button type="button" class="ac-consent-close" aria-label="{{ form.text.dismiss_reject }}" title="{{ form.text.dismiss_reject }}" data-pages--consent-manager--index-target="close">×</button>
                        <h2 data-pages--consent-manager--index-target="title">{{ form.text.title|replace({'{name}': form.name}) }}</h2>
                        <p data-pages--consent-manager--index-target="description">{{ form.text.description }}</p>
                        <div data-pages--consent-manager--index-target="details">{% for paragraph in form.details|filter(p => p|trim is not empty) %}<p>{{ paragraph }}</p>{% endfor %}</div>
                        <p data-pages--consent-manager--index-target="privacy"{% if not form.privacy_policy_url %} hidden{% endif %}><a href="#">{{ form.text.privacy_link }}</a></p>
                        <fieldset data-pages--consent-manager--index-target="categories"{% if 'save' not in form.show %} hidden{% endif %}>
                            <legend data-pages--consent-manager--index-target="legend">{{ form.text.categories_legend }}</legend>
                            {% for category, label in form.categories %}<label class="ac-consent-category"><input type="checkbox"{% if category in form.precheck_categories %} checked{% endif %} data-preview-checkbox="{{ category }}"> <span data-category="{{ category }}">{{ label }}</span>{% if form.category_tags[category] is defined %}<span class="ac-consent-category-tags" data-category-tags="{{ form.category_tags[category] }}">{{ form.text.category_tags|replace({'{tags}': form.category_tags[category]}) }}</span>{% endif %}</label>{% endfor %}
                        </fieldset>
                        <div class="ac-consent-actions" data-pages--consent-manager--index-target="buttons">
                            {% for name in form.show|split(',') %}<button type="button" data-button="{{ name }}">{{ form.text[name] }}</button>{% endfor %}
                        </div>
                    </section>
                    <button type="button" class="ac-consent-open{% if form.reopen == 'bottom-right' %} ac-consent-open--right{% endif %}" style="{{ theme_style|trim }}"{% if form.reopen == 'hidden' %} hidden{% endif %} data-pages--consent-manager--index-target="reopen">{{ form.text.reopen }}</button>
                </div>
            </figure>
        </div>
    </div>
    {% endif %}
    {% endif %}
</div>
{% endblock %}

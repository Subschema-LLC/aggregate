{% extends 'base.html.twig' %}

{% block title %}Feature flags - {{ app_branding.name }}{% endblock %}

{% block body %}
    <div class="level">
        <div class="level-left">
            <div>
                <h1 class="title">Feature flags</h1>
                <p class="subtitle">Control optional features for this deployment. These settings apply to the active configuration across all websites.</p>
                {{ component('Ui:DocsLink', {topic: 'feature-flags', label: 'Feature flags guide'}) }}
            </div>
        </div>
        <div class="level-right">
            {{ component('Ui:CardControls', {class: 'page-card-controls mb-0'}) }}
        </div>
    </div>

    <div class="content">
        <p>Turning a feature off blocks its pages, commands and other actions. Its menu entry then stays in the menu, greyed out with an <span class="tag is-light">Off</span> tag, unless you hide it. Hide it when people would otherwise wonder whether something is broken.</p>
        <p>Hiding only removes the menu entry. A feature that is on and hidden still works for authorized users who go to its address.</p>
    </div>

    {% if configuration_error %}
        <div class="notification is-danger" role="alert">{{ configuration_error }}</div>
    {% else %}
        <form action="{{ path('app_feature_flags_save') }}" method="post">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('feature_flags_settings') }}">

            {% for name, definition in definitions %}
                <div class="box">
                    <fieldset aria-describedby="feature-{{ name }}-description">
                        <legend class="title is-4">{{ definition.label }}</legend>
                        <p id="feature-{{ name }}-description" class="mb-4">{{ definition.description }}</p>

                        <div class="field">
                            <label class="label" for="feature-{{ name }}-enabled">Availability</label>
                            <div class="control">
                                <div class="select">
                                    <select id="feature-{{ name }}-enabled" name="feature_flags[{{ name }}][enabled]" required>
                                        <option value="1"{% if settings[name].enabled %} selected{% endif %}>On</option>
                                        <option value="0"{% if not settings[name].enabled %} selected{% endif %}>Off</option>
                                    </select>
                                </div>
                            </div>
                            <p class="help">YAML: <code>enabled: {{ settings[name].enabled ? 'true' : 'false' }}</code></p>
                        </div>

                        <div class="field">
                            <label class="label" for="feature-{{ name }}-navigation">Menu entry</label>
                            <div class="control">
                                <div class="select">
                                    <select id="feature-{{ name }}-navigation" name="feature_flags[{{ name }}][hide_from_navigation]" required aria-describedby="feature-{{ name }}-navigation-help">
                                        <option value="0"{% if not settings[name].hide_from_navigation %} selected{% endif %}>Show in the menu</option>
                                        <option value="1"{% if settings[name].hide_from_navigation %} selected{% endif %}>Hide from the menu</option>
                                    </select>
                                </div>
                            </div>
                            <p class="help" id="feature-{{ name }}-navigation-help">
                                {%- if definition.navigation is defined and not definition.navigation -%}
                                    This feature has no menu entry, so this setting has no visible effect.
                                {%- else -%}
                                    While off, a shown entry is greyed out with an Off tag; a hidden one is left out of the menu.
                                {%- endif %} YAML: <code>hide_from_navigation: {{ settings[name].hide_from_navigation ? 'true' : 'false' }}</code>
                            </p>
                        </div>
                    </fieldset>
                </div>
            {% endfor %}

            <button class="button is-primary" type="submit">Save feature flags</button>
        </form>

        <details class="box mt-5">
            <summary class="has-text-weight-semibold">YAML for these settings</summary>
            <p class="mt-3">Saving writes every feature with both settings to the active aggregate YAML (<code>config/aggregate.yaml</code>, or the environment's own file or entry), so the file says what is on and what shows. To manage flags without the dashboard, put this mapping there.</p>
            <pre class="mt-3"><code>{{ yaml }}</code></pre>
        </details>
    {% endif %}
{% endblock %}

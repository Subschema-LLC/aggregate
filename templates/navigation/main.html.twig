{% macro link(item, classes, is_brand = false) %}
    {% if item.role is not defined or is_granted(item.role) %}
        {% set state = navigation_feature_state(item) %}
        {% if not state.hidden %}
            {% set tag = state.enabled ? 'a' : 'span' %}
            {% if state.enabled %}
                {% set url = item.route is defined ? path(item.route, item.route_parameters|default({})) : item.url|default(null) %}
            {% endif %}
            <{{ tag }} class="{{ classes }}" {% if state.enabled %}href="{{ url }}"{% else %}role="link" aria-disabled="true"{% endif %}>
                {% if is_brand %}
                    {% include 'branding/identity.html.twig' %}
                {% else %}
                    <span class="icon-text">
                        {% if item.icon|default(null) %}
                            <span class="icon">
                                <i class="{{ item.icon }}" aria-hidden="true"></i>
                            </span>
                        {% endif %}
                        <span>{{ item.label }}</span>
                    </span>
                {% endif %}
                {% if not state.enabled %}
                    <span class="ml-1" aria-hidden="true">(disabled)</span>
                {% endif %}
            </{{ tag }}>
        {% endif %}
    {% endif %}
{% endmacro %}

{% set account = main_navigation.account %}

<nav class="navbar is-dark" role="navigation" aria-label="main navigation">
    <div class="navbar-brand">
        {{ _self.link(main_navigation.brand, 'navbar-item', true) }}

        {% for item in main_navigation.items %}
            {{ _self.link(item, 'navbar-item') }}
        {% endfor %}
    </div>

    <div class="navbar-menu">
        <div class="navbar-end">
            <div class="navbar-item">
                <span class="icon-text">
                    {% if account.user_icon|default(null) %}
                        <span class="icon">
                            <i class="{{ account.user_icon }}" aria-hidden="true"></i>
                        </span>
                    {% endif %}
                    <span>{{ app.user.username }}</span>
                </span>
            </div>
            <div class="navbar-item">
                {{ _self.link(account.logout, 'button is-light') }}
            </div>
        </div>
    </div>
</nav>

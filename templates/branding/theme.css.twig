{# Every value is canonicalized by BrandingTheme before CSS serialization. #}
:root {
    --app-brand-primary: {{ theme.primary_color|raw }};
    --app-brand-primary-contrast: {{ theme.primary_contrast_color|raw }};
    --app-brand-primary-text: {{ theme.primary_text_color|raw }};
    --app-brand-accent: {{ theme.accent_color|raw }};
    --app-brand-accent-contrast: {{ theme.accent_contrast_color|raw }};
    --app-brand-accent-text: {{ theme.accent_text_color|raw }};
    --app-brand-focus: {{ theme.focus_color|raw }};
    --app-brand-navbar: {{ theme.navbar_color|raw }};
    --app-brand-navbar-contrast: {{ theme.navbar_contrast_color|raw }};
    --app-brand-background: {{ theme.background_color|raw }};
    --app-brand-surface: {{ theme.surface_color|raw }};
    --app-brand-text: {{ theme.text_color|raw }};
    --app-brand-font-family: {{ theme.font_family_css|raw }};
    --app-brand-heading-font-family: {{ theme.heading_font_family_css|raw }};
}

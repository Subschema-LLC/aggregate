<span class="app-branding-identity">
    {% if app_branding.has_logo %}
        <img
            class="app-branding-logo"
            src="{{ path('app_branding_logo', {v: app_branding.logo_version}) }}"
            alt="{{ app_branding.logo_text is empty ? app_branding.name : '' }}"
        >
    {% endif %}
    <strong>{{ app_branding.logo_text }}</strong>
</span>

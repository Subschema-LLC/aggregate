<fieldset class="website-domain-fields" aria-describedby="{{ field_prefix }}-help">
    <legend class="label">Event source domains</legend>
    <div class="field">
        <label class="label" for="{{ field_prefix }}-mode">Domain restrictions</label>
        <div class="control">
            <div class="select">
                <select id="{{ field_prefix }}-mode" name="domain_mode">
                    <option value="restricted"{% if domain_settings.mode == 'restricted' %} selected{% endif %}>Listed domains only</option>
                    <option value="all"{% if domain_settings.mode == 'all' %} selected{% endif %}>Allow all domains</option>
                </select>
            </div>
        </div>
    </div>
    <div class="field">
        <label class="label" for="{{ field_prefix }}-domains">Allowed domains</label>
        <div class="control">
            <textarea class="textarea" id="{{ field_prefix }}-domains" name="allowed_domains" rows="3" maxlength="16384" placeholder="example.com&#10;*.example.com" aria-describedby="{{ field_prefix }}-help">{{ domain_settings.domains|join('\n') }}</textarea>
        </div>
        <p class="help" id="{{ field_prefix }}-help">Enter up to 32 hostnames, one per line, without a protocol, port, or path. <code>example.com</code> permits only that host. <code>*.example.com</code> permits subdomains at any depth, but excludes <code>example.com</code>; list both to allow both. Regex and other wildcard forms are unsupported.</p>
        {% if new_website|default(false) %}
            <p class="help">When adding a website with restricted domains, an empty list allows only the primary domain entered above.</p>
        {% endif %}
        <p class="help">Allow all accepts events from any website or other client using this website token. The list is inactive in that mode and is kept for switching back.</p>
    </div>
</fieldset>

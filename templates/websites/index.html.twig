{% extends 'base.html.twig' %}

{% block title %}Websites | {{ app_branding.name }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    #add-website-modal { border: 0; margin: auto; max-height: calc(100vh - 3rem); max-width: 36rem; overflow: auto; width: calc(100% - 3rem); }
    #add-website-modal:not([open]) { display: none; }
    #add-website-modal::backdrop { background: rgba(0, 0, 0, 0.6); }
    .website-domain-fields { min-width: 0; }
    .website-domain-fields .select, .website-domain-fields select { max-width: 100%; }
    .website-domain-fields .help { overflow-wrap: anywhere; }
</style>
{% endblock %}

{% block body %}
<div class="level">
    <div class="level-left">
        <div>
            <h1 class="title">Websites</h1>
            <p class="subtitle">Manage website tokens, allowed domains, and tracker installation.</p>
        </div>
    </div>
    <div class="level-right">
        <button type="button" class="button is-primary" id="add-website-trigger">
            <span class="icon" aria-hidden="true"><i class="fas fa-plus"></i></span>
            <span>Add Website</span>
        </button>
    </div>
</div>

{% if websites is empty %}
    <div class="notification is-info is-light">
        Add your first website to get its token and installation code.
    </div>
{% endif %}

{% for website in websites %}
    <details class="box"{% if loop.first %} open{% endif %}>
        <summary class="has-text-weight-semibold" style="overflow-wrap: anywhere;">{{ website.name }} <span class="has-text-weight-normal">— {{ website.domain }}</span></summary>
        <div class="content mt-4">
            <p><strong>Website token:</strong> <code style="overflow-wrap: anywhere;">{{ website.token }}</code></p>
            <h2 class="title is-5">Allowed domains</h2>
            {% if website.domain_settings_invalid %}
                <div class="notification is-warning">This website's domain rules are invalid. Events are rejected until valid rules are saved.</div>
            {% elseif website.domain_policy is not defined %}
                <p class="help mb-3">This existing registration permits its primary domain and its subdomains. The list below preserves that behavior; save to make the rules explicit.</p>
            {% endif %}
            <form action="{{ path('app_website_domains', {token: website.token}) }}" method="post" class="mb-5">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('website_domains_' ~ website.token) }}">
                {% include 'websites/_domain_fields.html.twig' with {field_prefix: 'website-domains-' ~ loop.index, domain_settings: website.domain_settings} only %}
                <button type="submit" class="button is-primary mt-3">Save domain rules</button>
            </form>
            <h2 class="title is-5">Integration code</h2>
            <p>Add this code to your website's <code>&lt;head&gt;</code> section.</p>
            {% set integration_code = '<script>\n  window[' ~ (js_namespace|json_encode(15)) ~ '] = {\n    endpoint: ' ~ ((app_host|trim('/') ~ '/api/receive')|json_encode(15)) ~ ',\n    websiteToken: ' ~ (website.token|json_encode(15)) ~ '\n  };\n</script>\n<script src="' ~ ((app_host|trim('/') ~ '/aggregate.js')|escape('html')) ~ '" defer referrerpolicy="no-referrer"></script>' %}
            <pre><code id="code-{{ loop.index }}">{{ integration_code }}</code></pre>
            <button type="button" class="button is-small is-info copy-btn" data-clipboard-target="code-{{ loop.index }}">Copy to Clipboard</button>
            <span class="copy-status is-size-7 ml-2" role="status"></span>
            <form class="mt-5" action="{{ path('app_website_delete', {token: website.token}) }}" method="post" onsubmit="return confirm('Delete this website token? Existing tracker installations using it will stop collecting.');">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('delete_website_' ~ website.token) }}">
                <button type="submit" class="button is-danger is-outlined is-small">Delete Website</button>
            </form>
        </div>
    </details>
{% endfor %}

{% include 'websites/_tracker_guidance.html.twig' %}

<dialog id="add-website-modal" class="box" aria-labelledby="add-website-title">
    <h2 class="title is-4" id="add-website-title">Add website</h2>
    <form action="{{ path('app_website_create') }}" method="post">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('create_website') }}">
        <div class="field">
            <label class="label" for="website-name">Website name</label>
            <div class="control">
                <input class="input" type="text" id="website-name" name="name" placeholder="Example website" required autofocus>
            </div>
        </div>
        <div class="field">
            <label class="label" for="website-domain">Primary domain</label>
            <div class="control">
                <input class="input" type="text" id="website-domain" name="domain" placeholder="example.com" required>
            </div>
            <p class="help">The website's main hostname, without a protocol or path. It also identifies internal referrers; allowed event sources are configured below.</p>
        </div>
        {% include 'websites/_domain_fields.html.twig' with {field_prefix: 'new-website-domains', domain_settings: {mode: 'restricted', domains: []}, new_website: true} only %}
        <div class="buttons mt-5">
            <button type="submit" class="button is-primary">Create Website</button>
            <button type="button" class="button" id="cancel-add-website">Cancel</button>
        </div>
    </form>
</dialog>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const dialog = document.getElementById('add-website-modal');
        document.getElementById('add-website-trigger').addEventListener('click', () => dialog.showModal());
        document.getElementById('cancel-add-website').addEventListener('click', () => dialog.close());
        document.querySelectorAll('.copy-btn').forEach(button => {
            button.addEventListener('click', async () => {
                const code = document.getElementById(button.dataset.clipboardTarget);
                const status = button.nextElementSibling;
                try {
                    await navigator.clipboard.writeText(code.textContent);
                    status.textContent = 'Copied.';
                } catch (error) {
                    status.textContent = 'Clipboard unavailable. Select and copy the code above.';
                }
            });
        });
    });
</script>
{% endblock %}

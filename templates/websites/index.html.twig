{% extends 'base.html.twig' %}

{% block title %}Websites | {{ app_branding.name }}{% endblock %}

{% block body %}
{% set is_admin = is_granted('ROLE_ADMIN') %}

<div class="websites-page" data-controller="pages--websites--index" data-action="turbo:before-cache@document->pages--websites--index#reset">
<div class="level">
    <div class="level-left">
        <div>
            <h1 class="title">Websites</h1>
            <p class="subtitle">Manage website tokens, allowed domains, and tracker installation.</p>
        </div>
    </div>
    <div class="level-right">
        <button type="button" class="button is-primary" id="add-website-trigger" data-pages--websites--index-target="trigger" data-action="pages--websites--index#open">
            <span class="icon" aria-hidden="true"><i class="fas fa-plus"></i></span>
            <span>Add Website</span>
        </button>
    </div>
</div>

{% if websites is empty %}
    <div class="notification is-info is-light">
        Add your first website to get its token and installation code.
    </div>
{% endif %}

{% if websites is not empty %}
    <div class="box">
        <h2 class="title is-5" id="website-installation-method">Installation method</h2>
        <nav class="buttons" aria-labelledby="website-installation-method">
            <a class="button{% if not include_tags and snippet_format == 'window' %} is-primary{% endif %}" href="{{ path('app_dashboard', {format: 'window'}) }}"{% if not include_tags and snippet_format == 'window' %} aria-current="true"{% endif %}>Window configuration</a>
            <a class="button{% if not include_tags and snippet_format == 'query' %} is-primary{% endif %}" href="{{ path('app_dashboard', {format: 'query'}) }}"{% if not include_tags and snippet_format == 'query' %} aria-current="true"{% endif %}>URL query parameters</a>
            <a class="button{% if include_tags %} is-primary{% endif %}" href="{{ path('app_dashboard', {format: 'window', tags: '1'}) }}"{% if include_tags %} aria-current="true"{% endif %}>Tag manager</a>
        </nav>
        {% if include_tags %}
            <p>Install the website's tag container and enabled consent controls. Configure a script action in the Tag manager to load the tracker URL shown below.</p>
        {% elseif snippet_format == 'query' %}
            <p>Load the tracker with its public website token, endpoint, and initial denied consent in the script URL.</p>
        {% else %}
            <p>Configure the tracker through <code>window</code> before loading it. The website's enabled consent controls load first.</p>
        {% endif %}
    </div>
{% endif %}

{% for website in websites %}
    {{ component('Websites:SiteCard', {website: website, index: loop.index, include_tags: include_tags, snippet_format: snippet_format, is_admin: is_admin}) }}
{% endfor %}

<details class="box">
    <summary class="has-text-weight-semibold">Custom events and consent</summary>
    <div class="content mt-4">
        <p>The tracker automatically sends an anonymous <code>view</code> event. Named interactions use <code>emit(...)</code>. Keep event codes fixed and non-identifying: start with a letter and use at most 100 characters from letters, numbers, <code>_ . : -</code>. Never insert user-entered text into a code.</p>
        <pre><code>window[{{ js_namespace|json_encode(15) }}].emit('button_click');</code></pre>
        <p>Custom properties require an explicit consent-free setting in the saved data model or enhanced analytics consent. Goals require an enabled definition in <code>config/goals.yaml</code>; anonymous goals must also permit anonymous use. A disallowed goal is dropped while the event remains recorded.</p>
        <h2 class="title is-5">Enhanced analytics consent</h2>
        <p>Enable identifiers, properties requiring consent, and exact dimensions only after the visitor accepts enhanced analytics.</p>
        <pre><code>// Accept enhanced analytics after explicit consent
window[{{ js_namespace|json_encode(15) }}].setConsent(true);

// Reject or withdraw enhanced analytics
window[{{ js_namespace|json_encode(15) }}].setConsent(false);</code></pre>
        <p>Withdrawal removes browser identifiers and stops future enhanced detail. Previously stored history remains. Coarse anonymous collection, including permitted consent-free properties, may continue unless the administrator disables collection or excludes the path.</p>
    </div>
</details>

{{ component('Websites:CreateDialog') }}
</div>
{% endblock %}

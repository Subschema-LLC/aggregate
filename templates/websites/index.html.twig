{% extends 'base.html.twig' %}

{% block title %}Websites | {{ app_branding.name }}{% endblock %}

{% block body %}
{% set is_admin = is_granted('ROLE_ADMIN') %}

<div class="websites-page" data-controller="pages--websites--index pages--websites--activity" data-pages--websites--activity-url-value="{{ path('app_website_activity') }}" data-action="turbo:before-cache@document->pages--websites--index#reset">
<div class="level mb-5">
    <div class="level-left">
        <div>
            <h1 class="title mb-1">Websites</h1>
            <p class="subtitle is-6">Manage website tokens, allowed domains, and tracker installation.</p>
            {{ component('Ui:DocsLink', {topic: 'configuration.websites', label: 'Website domains guide'}) }}
        </div>
    </div>
    <div class="level-right">
        <button type="button" class="button is-primary" id="add-website-trigger" data-pages--websites--index-target="trigger" data-action="pages--websites--index#open">
            <span class="icon" aria-hidden="true"><i class="fas fa-plus"></i></span>
            <span>Add Website</span>
        </button>
    </div>
</div>

{% if websites is empty %}
    <div class="box has-text-centered py-6 mb-5">
        <span class="icon is-large has-text-primary mb-3">
            <i class="fas fa-globe fa-3x" aria-hidden="true"></i>
        </span>
        <h2 class="title is-4 mb-2">Welcome to {{ app_branding.name }}</h2>
        <p class="subtitle is-6 mb-4">Add your first website to get its token and installation code.</p>
        {% if is_admin %}
            <button type="button" class="button is-primary" data-action="pages--websites--index#open">
                <span class="icon" aria-hidden="true"><i class="fas fa-plus"></i></span>
                <span>Add Your First Website</span>
            </button>
        {% endif %}
    </div>
{% endif %}

{% if websites is not empty %}
    <div class="box mb-5">
        <h2 class="title is-5 mb-3" id="website-installation-method">Installation method</h2>
        <nav class="buttons mb-3" aria-labelledby="website-installation-method">
            <a class="button is-small{% if not include_tags and snippet_format == 'window' %} is-primary{% endif %}" href="{{ path('app_dashboard', {format: 'window'}) }}"{% if not include_tags and snippet_format == 'window' %} aria-current="true"{% endif %}>Window configuration</a>
            <a class="button is-small{% if not include_tags and snippet_format == 'query' %} is-primary{% endif %}" href="{{ path('app_dashboard', {format: 'query'}) }}"{% if not include_tags and snippet_format == 'query' %} aria-current="true"{% endif %}>URL query parameters</a>
            <a class="button is-small{% if include_tags %} is-primary{% endif %}" href="{{ path('app_dashboard', {format: 'window', tags: '1'}) }}"{% if include_tags %} aria-current="true"{% endif %}>Tag manager</a>
        </nav>
        <p class="help">
            {% if include_tags %}
                Install the website's tag container and enabled consent controls. Configure a script action in the Tag manager to load the tracker URL shown below.
            {% elseif snippet_format == 'query' %}
                Load the tracker with its public website token, endpoint, and initial denied consent in the script URL.
            {% else %}
                Configure the tracker through <code>window</code> before loading it. The website's enabled consent controls load first.
            {% endif %}
        </p>
    </div>
{% endif %}

{% if websites|length > 1 %}
    <div class="level mb-4">
        <div class="level-left">
            <div class="field mb-0">
                <div class="control has-icons-left">
                    <input type="search" class="input is-small is-rounded" placeholder="Filter websites by name or domain..." aria-label="Filter websites" data-action="input->pages--websites--index#filter">
                    <span class="icon is-small is-left">
                        <i class="fas fa-search" aria-hidden="true"></i>
                    </span>
                </div>
            </div>
        </div>
        <div class="level-right">
            <div class="buttons are-small mb-0">
                <button type="button" class="button is-light" data-action="pages--websites--index#expandAll">
                    <span class="icon"><i class="fas fa-angles-down" aria-hidden="true"></i></span>
                    <span>Expand all</span>
                </button>
                <button type="button" class="button is-light" data-action="pages--websites--index#collapseAll">
                    <span class="icon"><i class="fas fa-angles-up" aria-hidden="true"></i></span>
                    <span>Collapse all</span>
                </button>
            </div>
        </div>
    </div>
    <div id="websites-filter-empty" class="notification is-light mb-4" hidden>
        No websites match the current filter.
    </div>
{% endif %}

{% for website in websites %}
    {{ component('Websites:SiteCard', {website: website, index: loop.index, include_tags: include_tags, snippet_format: snippet_format, is_admin: is_admin}) }}
{% endfor %}

<details class="box mt-5">
    <summary class="has-text-weight-semibold">
        <span class="icon-text">
            <span class="icon"><i class="fas fa-book-bookmark" aria-hidden="true"></i></span>
            <span>Custom events and consent reference</span>
        </span>
    </summary>
    <div class="content mt-4">
        <p>The tracker automatically sends an anonymous <code>view</code> event. Named interactions use <code>emit(...)</code>. Keep event codes fixed and non-identifying: start with a letter and use at most 100 characters from letters, numbers, <code>_ . : -</code>. Never insert user-entered text into a code.</p>
        <pre><code>window[{{ js_namespace|json_encode(15) }}].emit('button_click');</code></pre>
        <p>Or mark clicks and form submissions in your HTML, without JavaScript. Properties can sit on the element or any element around it; the nearest wins. Only these attributes are read, never the element's text, link addresses or form fields.</p>
        <pre><code>&lt;button {{ tracking_attributes.event }}="plan_click" {{ tracking_attributes.prop }}plan="pro" {{ tracking_attributes.goal }}="signup"&gt;Choose Pro&lt;/button&gt;
&lt;form {{ tracking_attributes.event }}="newsletter_submit"&gt;…&lt;/form&gt;</code></pre>
        {{ component('Ui:DocsLink', {topic: 'tracking.attributes', label: 'Data attribute tracking'}) }}
        <p>Custom properties require an explicit consent-free setting in the saved data model or enhanced analytics consent. Goals require an enabled definition in <code>config/goals.yaml</code>; anonymous goals must also permit anonymous use. A disallowed goal is dropped while the event remains recorded.</p>
        <h2 class="title is-5 mt-4">Enhanced analytics consent</h2>
        <p>Enable identifiers, properties requiring consent, and exact dimensions only after the visitor accepts enhanced analytics.</p>
        <pre><code>// Accept enhanced analytics after explicit consent
window[{{ js_namespace|json_encode(15) }}].setConsent(true);

// Reject or withdraw enhanced analytics
window[{{ js_namespace|json_encode(15) }}].setConsent(false);</code></pre>
        <p class="help">Withdrawal removes browser identifiers and stops future enhanced detail. Previously stored history remains. Coarse anonymous collection, including permitted consent-free properties, may continue unless the administrator disables collection or excludes the path.</p>
    </div>
</details>

{{ component('Websites:CreateDialog') }}
</div>
{% endblock %}

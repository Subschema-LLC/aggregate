{% extends 'base.html.twig' %}

{% block title %}Collection controls | {{ app_branding.name }}{% endblock %}

{% block body %}
<div class="settings-page">
{% set retry_settings = tracking_retry_settings %}
{% set retry_overrides = tracking_retry_environment_overrides %}
<h1 class="title">Collection controls</h1>
<p class="subtitle">Manage collection and local geography for this deployment.</p>
{{ component('Ui:DocsLink', {topic: 'privacy.controls', label: 'Collection controls in the privacy guide'}) }}
<div class="columns is-centered">
<div class="column is-9-desktop">
<div class="box">
<p class="mb-4">Save collection controls in <code>config/aggregate.yaml</code>, or edit the active YAML configuration directly. Server environment variables take precedence.</p>
    <form action="{{ path('app_anonymous_settings_save') }}" method="post">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('anonymous_settings') }}">

        <fieldset class="field" aria-describedby="collection-profile-help">
            <legend class="label">Collection profile</legend>
            <div class="control">
                <label class="radio">
                    <input type="radio" name="collection_profile" value="standard" {% if collection_profile == 'standard' %}checked{% endif %}>
                    Standard
                </label>
                <label class="radio">
                    <input type="radio" name="collection_profile" value="strict" {% if collection_profile == 'strict' %}checked{% endif %}>
                    Strict
                </label>
            </div>
            <div id="collection-profile-help" class="help content">
                <p><strong>Standard</strong> uses the settings on this page and in the data model, including consented enhanced analytics.</p>
                <p><strong>Strict</strong> records every event in anonymous mode with only the sanitized page path, event name and approved goal. The tracker reads no screen size or referrer, sends no consent state, organization marker or identifiers, and does not read, write or remove cookies or browser storage. The server ignores any other submitted dimension and performs no geographic lookup. Custom properties, page depth, coarse geography and enhanced analytics stay configured but are not used while strict is selected.</p>
                <p>Strict limits what this tracker touches on a visitor's device; it does not by itself make collection exempt from consent in every jurisdiction. See the privacy guide before relying on it.</p>
            </div>
            {% component 'Ui:PageSpeedNote' with {enabled: tracker_omit_unused_features} %}
                {% block content %}With the strict profile, visitors get a tracker about half the size, without the code only the standard profile uses.{% endblock %}
            {% endcomponent %}
            {% if collection_profile_env_override %}
                <p class="help is-warning">The <code>COLLECTION_PROFILE</code> environment variable is set, so the <strong>{{ collection_profile }}</strong> profile is in effect regardless of the value saved here.</p>
            {% endif %}
        </fieldset>

        <hr>

        <div class="field">
            <label class="checkbox">
                <input type="checkbox" name="anonymous_tracking_enabled" value="1" {% if anonymous_tracking_enabled %}checked{% endif %}>
                Enable analytics collection
            </label>
            <p class="help">When disabled, the server rejects anonymous and consented enhanced events.</p>
        </div>

        <div class="field">
            <label class="label" for="anonymous-excluded-paths">Excluded paths</label>
            <div class="control">
                <textarea class="textarea is-family-monospace" id="anonymous-excluded-paths" name="anonymous_excluded_paths" rows="6" placeholder="/account/*&#10;/checkout/**&#10;/health">{{ anonymous_excluded_paths|join('\n') }}</textarea>
            </div>
            <p class="help">One path or glob per line. Query strings and fragments are never accepted. Matching paths are excluded from anonymous and enhanced collection.</p>
        </div>

        <hr>
        <h2 class="title is-5">Coarse geography (optional)</h2>

        <div class="field">
            <label class="checkbox">
                <input type="checkbox" name="anonymous_geo_enabled" value="1" {% if anonymous_geo_enabled %}checked{% endif %}>
                Derive coarse geography from the request IP
            </label>
            <p class="help">Off by default. The lookup uses only a local MMDB file; the IP and detailed lookup record are not added to the event or queue. Failed lookups leave geography empty without rejecting the event.</p>
        </div>

        <div class="field">
            <label class="label" for="anonymous-geo-level">Stored geography level</label>
            <div class="control">
                <div class="select is-fullwidth">
                    <select id="anonymous-geo-level" name="anonymous_geo_level" required>
                        <option value="macro_region" {% if anonymous_geo_level == 'macro_region' %}selected{% endif %}>Macro-region</option>
                        <option value="country" {% if anonymous_geo_level == 'country' %}selected{% endif %}>Country</option>
                    </select>
                </div>
            </div>
            <p class="help">Macro-region is recommended and stores a continent-level code such as <code>continent:NA</code>. Country stores an ISO country code such as <code>country:US</code>. This is approximate network-exit geography—not a visitor's precise physical location. City, subdivision, postcode, and coordinates are never retained.</p>
        </div>

        <div class="field">
            <label class="label" for="anonymous-geo-database-path">Local GeoIP database path</label>
            <div class="control">
                <input class="input is-family-monospace" type="text" id="anonymous-geo-database-path" name="anonymous_geo_database_path" value="{{ anonymous_geo_database_path }}" maxlength="4096" placeholder="/var/lib/GeoIP/GeoLite2-Country.mmdb">
            </div>
            <p class="help">Use a local absolute path (recommended) or a path inside the project root to a read-only GeoLite2-Country-compatible <code>.mmdb</code>. URI schemes, project-directory escapes, UNC/network shares, and Windows device paths are rejected. The application does not download a database or call a GeoIP web service.</p>
        </div>

        <hr>
        <h2 class="title is-5">Enhanced tracking retry</h2>
        <p class="mb-4">When an enhanced event cannot be stored, Aggregate records a failed task and keeps the message in Messenger&apos;s failed transport for retry.</p>
        <div class="field">
            <label class="checkbox">
                <input type="checkbox" name="tracking_retry_enabled" value="1" {% if retry_settings.tracking_retry_enabled %}checked{% endif %}{% if retry_overrides.tracking_retry_enabled %} disabled{% endif %}>
                Enable manual retries for failed enhanced tracking messages
            </label>
            <p class="help">{% if retry_overrides.tracking_retry_enabled %}Controlled by <code>TRACKING_RETRY_ENABLED</code>.{% else %}When disabled, retry actions from the dashboard and CLI are blocked.{% endif %}</p>
        </div>
        <div class="field">
            <label class="label" for="tracking-retry-batch-size">Retry batch size</label>
            <div class="control">
                <input class="input" id="tracking-retry-batch-size" name="tracking_retry_batch_size" type="number" min="1" max="1000" step="1" required value="{{ retry_settings.tracking_retry_batch_size }}"{% if retry_overrides.tracking_retry_batch_size %} disabled aria-describedby="tracking-retry-batch-size-help"{% endif %}>
            </div>
            <p class="help" id="tracking-retry-batch-size-help">{% if retry_overrides.tracking_retry_batch_size %}Controlled by <code>TRACKING_RETRY_BATCH_SIZE</code>.{% else %}Maximum failed tracking messages retried per run (1–1000).{% endif %}</p>
        </div>
        <div class="notification is-light">
            <p class="has-text-weight-semibold">Tracking failure status</p>
            <p>
                {% if tracking_last_failure %}
                    Last failure: {{ tracking_last_failure.started_at|date('Y-m-d H:i', 'UTC') }} UTC{% if tracking_last_failure.subject %} (website token {{ tracking_last_failure.subject }}){% endif %}{% if tracking_last_failure.details %}: {{ tracking_last_failure.details }}{% endif %}
                {% else %}
                    No failed enhanced tracking write has been recorded yet.
                {% endif %}
            </p>
            <p class="mt-2">
                {% if tracking_last_ingestion_failure %}
                    Last ingestion failure: {{ tracking_last_ingestion_failure.started_at|date('Y-m-d H:i', 'UTC') }} UTC{% if tracking_last_ingestion_failure.subject %} ({{ tracking_last_ingestion_failure.subject }}){% endif %}{% if tracking_last_ingestion_failure.details %}: {{ tracking_last_ingestion_failure.details }}{% endif %}
                {% else %}
                    No anonymous/enhanced ingestion failure has been recorded yet.
                {% endif %}
            </p>
            <p class="mt-2">
                {% if tracking_last_retry %}
                    Last retry run: {{ tracking_last_retry.started_at|date('Y-m-d H:i', 'UTC') }} UTC, {% if tracking_last_retry.status == 'succeeded' %}succeeded{% elseif tracking_last_retry.status == 'failed' %}<strong>failed</strong>{% else %}running{% endif %}{% if tracking_last_retry.details %}: {{ tracking_last_retry.details }}{% endif %}
                {% else %}
                    No retry run has been recorded yet.
                {% endif %}
            </p>
            <p class="help mt-2">CLI: <code>php bin/console app:tracking:retry-failed</code></p>
            <button type="submit" class="button is-warning mt-3" form="tracking-retry-form" {% if not retry_settings.tracking_retry_enabled %}disabled{% endif %}>
                <span class="icon"><i class="fas fa-rotate-right"></i></span>
                <span>Retry failed tracking messages now</span>
            </button>
        </div>

        <div class="field">
            <div class="control">
                <button type="submit" class="button is-link">
                    <span class="icon"><i class="fas fa-shield-alt"></i></span>
                    <span>Save Collection Settings</span>
                </button>
            </div>
        </div>
    </form>
</div>
    <details class="message is-warning is-light mt-5">
        <summary class="message-header is-clickable">
            <p><span class="icon mr-1"><i class="fas fa-shield-halved" aria-hidden="true"></i></span> What rejection means (privacy & legal boundaries)</p>
            <span class="message-toggle" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"/></svg></span>
        </summary>
        <div class="message-body content">
            <p><strong>Reject</strong> disables enhanced analytics: no visitor ID, session ID, analytics session cookie, properties requiring consent, or exact dimensions.</p>
            <p>Anonymous rows retain a safe event name, UTC hour bucket, sanitized path, coarse referrer/device/viewport buckets, optional coarse geography, and configured anonymous goals and consent-free properties. They may still be personal data in context; the <code>bi_anonymous_*</code> views group them and suppress low-volume cells.</p>
            <p>With the strict collection profile, every event is anonymous and keeps only the sanitized path, safe event name, UTC hour bucket and approved goal. Referrer, device and viewport are stored as <code>unknown</code>.</p>
            <p>IP geolocation is itself processing of personal data in many jurisdictions, even though the analytics event does not retain the IP. Enable it only after documenting a legal basis and notice appropriate to the deployment.</p>
        </div>
    </details>
    <form id="tracking-retry-form" action="{{ path('app_tracking_retry_now') }}" method="post">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('tracking_retry_now') }}">
    </form>
</div>
</div>
</div>
{% endblock %}

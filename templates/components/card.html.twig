<!-- Expandable Card -->
<div class="card mb-4 card-expandable"
     data-controller="card"
     data-card-expandable-value="true"
     data-card-expanded-value="false"
     data-card-expanded-class="card-expanded"
     data-action="click->card#toggle">
    <div class="card-content">
        <div class="media">
            <div class="media-content">
                <p class="title is-4">Expandable Card</p>
                <p class="subtitle is-6">Click to expand</p>
            </div>
        </div>
        <div class="content" data-card-target="content" style="display: none;">
            <p>This content is hidden by default and shows when expanded.</p>
            <p>You can put any content here - images, forms, lists, etc.</p>
            <ul>
                <li>Feature 1</li>
                <li>Feature 2</li>
                <li>Feature 3</li>
            </ul>
        </div>
    </div>
</div>

{# A link to a documentation site topic (App\Service\DocumentationLinks::TOPICS).
   Renders nothing when documentation links are turned off. #}
{% props topic, label = 'Documentation' %}
{% set url = docs_url(topic) %}
{% if url %}
<p {{ attributes.defaults({class: 'docs-link'}) }}>
    <a href="{{ url }}" target="_blank" rel="noopener noreferrer">
        <span class="icon-text">
            <span class="icon"><i class="fas fa-book-open" aria-hidden="true"></i></span>
            <span>{{ label }}</span>
        </span>
        <span class="is-sr-only">(opens in a new tab)</span>
    </a>
</p>
{% endif %}

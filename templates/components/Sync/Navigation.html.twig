{% props current, destinations %}

{# One tab per sync destination; each tab says whether that destination is on. #}
{% set sync_items = [] %}
{% for destination in destinations %}
    {% set badge = destination.on is same as(true) ? 'On' : (destination.on is same as(false) ? 'Off' : 'Needs attention') %}
    {% set badge_class = destination.on is same as(true) ? 'is-success is-light' : (destination.on is same as(false) ? 'is-light' : 'is-warning is-light') %}
    {% set sync_items = sync_items|merge([{route: destination.route, label: destination.label, badge: badge, badge_class: badge_class}]) %}
{% endfor %}
{{ component('Ui:SectionTabs', {label: 'Sync destinations', current: current, items: sync_items}) }}

{% set search_descriptions = {
    'Websites': {desc: 'Manage website tokens, allowed domains, and snippets', kw: 'sites domains tokens script install'},
    'Setup': {desc: 'Step-by-step installation wizard and drop-in downloads', kw: 'wizard snippet guide download consent'},
    'Tag manager lite': {desc: 'Configure tags, triggers, variables, and CMP controls', kw: 'tags scripts triggers variables cmp analytics'},
    'Collection controls': {desc: 'Standard/strict collection profiles, excluded paths, and GeoIP', kw: 'profile strict standard exclude paths geoip geography'},
    'Data model': {desc: 'Custom properties, UTM parameter mappings, and page depth', kw: 'properties parameters utm campaign sequence depth'},
    'Event examples': {desc: 'Synthetic anonymous and enhanced request JSON', kw: 'examples json payload ecommerce curl test'},
    'Organization traffic': {desc: 'Shared browser marker to filter internal team traffic', kw: 'internal traffic marker team filter cookie'},
    'Reporting views': {desc: 'Regenerate custom analytics SQL reporting views', kw: 'sql views database reporting custom schema'},
    'BI glossary': {desc: 'Labels, descriptions, and translations for BI tools', kw: 'glossary labels translations locales columns dimensions'},
    'BI disclosure': {desc: 'Minimum cell count thresholds for anonymous reporting views', kw: 'disclosure threshold cell privacy suppression minimum'},
    'BI connection guide': {desc: 'Database schema, view specifications, and query examples', kw: 'views tables sql tableau powerbi connection bi schema'},
    'General settings': {desc: 'Application host URL, JS namespace, and rate limits', kw: 'host namespace rate limit url config'},
    'Branding': {desc: 'Brand name, logo upload, color palette, and fonts', kw: 'logo identity colors theme appearance font dark'},
    'Users': {desc: 'Manage user accounts, passwords, and admin privileges', kw: 'users accounts password admin security'},
    'Data lifecycle': {desc: 'Archiving, retention schedules, and deletion policies', kw: 'lifecycle archive retention deletion maintain cleanup'},
    'Updates': {desc: 'Version status, git updates, and signed release packages', kw: 'updates version git release upgrade'},
    'Feature flags': {desc: 'Enable or disable optional system capabilities', kw: 'flags features experimental toggle'},
    'Documentation': {desc: 'Architecture, privacy mode vs enhanced analytics', kw: 'how it works docs documentation privacy guide'}
} %}
{% set search_items = [] %}
{% for item in navigation.items %}
    {% if item.children is defined %}
        {% for child in item.children %}
            {% if child.enabled %}
                {% set info = search_descriptions[child.label]|default({desc: child.label ~ ' settings and tools', kw: ''}) %}
                {% set search_items = search_items|merge([{
                    title: child.label,
                    category: item.label,
                    url: child.url,
                    icon: child.icon|default('fas fa-link'),
                    description: info.desc,
                    keywords: info.kw
                }]) %}
            {% endif %}
        {% endfor %}
    {% else %}
        {% if item.enabled %}
            {% set info = search_descriptions[item.label]|default({desc: item.label ~ ' page', kw: ''}) %}
            {% set search_items = search_items|merge([{
                title: item.label,
                category: 'General',
                url: item.url,
                icon: item.icon|default('fas fa-link'),
                description: info.desc,
                keywords: info.kw
            }]) %}
        {% endif %}
    {% endif %}
{% endfor %}
{% props navigation, username %}
{% macro label(item) %}
    <span class="icon-text">
        {% if item.icon %}
            <span class="icon"><i class="{{ item.icon }}" aria-hidden="true"></i></span>
        {% endif %}
        <span>{{ item.label }}</span>
    </span>
{% endmacro %}

{% macro link(item, classes, is_brand = false) %}
    {% if item %}
        {% set tag = item.enabled ? 'a' : 'span' %}
        <{{ tag }} class="{{ classes }}" {% if item.enabled %}href="{{ item.logout ? logout_path('main') : item.url }}"{% else %}role="link" aria-disabled="true"{% endif %}>
            {% if is_brand %}
                {{ component('Branding:Identity', {branding: app_branding}) }}
            {% else %}
                {{ _self.label(item) }}
            {% endif %}
            {% if not item.enabled %}
                <span class="ml-1" aria-hidden="true">(disabled)</span>
            {% endif %}
        </{{ tag }}>
    {% endif %}
{% endmacro %}



<nav class="navbar is-dark app-navigation" aria-label="main navigation">
    <div class="navbar-brand">
        {{ _self.link(navigation.brand, 'navbar-item', true) }}
    </div>

    <div class="app-navigation-items">
        {% for item in navigation.items %}
            {% if item.children is defined %}
                <details class="app-navigation-group" name="main-navigation-group">
                    <summary class="navbar-item">{{ _self.label(item) }}</summary>
                    <div class="app-navigation-children">
                        {% for child in item.children %}
                            {{ _self.link(child, 'navbar-item') }}
                        {% endfor %}
                    </div>
                </details>
            {% else %}
                {{ _self.link(item, 'navbar-item') }}
            {% endif %}
        {% endfor %}
    </div>

        <div class="app-navigation-search" data-controller="components--layout--quick-search" data-components--layout--quick-search-items-value="{{ search_items|json_encode|e('html_attr') }}">
        <div class="quick-search-wrapper">
            <input type="search" class="quick-search-input" placeholder="Search... (Ctrl+K)" aria-label="Search pages and settings" autocomplete="off" data-components--layout--quick-search-target="input" data-action="input->components--layout--quick-search#filter keydown->components--layout--quick-search#navigate focus->components--layout--quick-search#show">
            <span class="quick-search-icon"><i class="fas fa-search" aria-hidden="true"></i></span>
            <span class="quick-search-shortcut"><kbd>Ctrl+K</kbd></span>
        </div>
        <div class="quick-search-results" data-components--layout--quick-search-target="results" hidden role="listbox"></div>
    </div>

    <div class="app-navigation-account">
        <div class="navbar-item app-navigation-user">
            <span class="icon-text">
                {% if navigation.account.user_icon %}
                    <span class="icon"><i class="{{ navigation.account.user_icon }}" aria-hidden="true"></i></span>
                {% endif %}
                <span>{{ username }}</span>
            </span>
        </div>
        {{ component('Layout:ThemeToggle') }}
        <div class="navbar-item">
            {{ _self.link(navigation.account.logout, 'button is-light') }}
        </div>
    </div>
</nav>

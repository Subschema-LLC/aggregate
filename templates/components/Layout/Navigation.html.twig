{% set search_items = quick_search_items(navigation) %}
{% props navigation, username %}
{% macro label(item) %}
    <span class="icon-text">
        {% if item.icon %}
            <span class="icon"><i class="{{ item.icon }}" aria-hidden="true"></i></span>
        {% endif %}
        <span>{{ item.label }}</span>
    </span>
{% endmacro %}

{% macro link(item, classes, is_brand = false) %}
    {% if item %}
        {% set tag = item.enabled ? 'a' : 'span' %}
        <{{ tag }} class="{{ classes }}" {% if item.enabled %}href="{{ item.logout ? logout_path('main') : item.url }}"{% else %}role="link" aria-disabled="true"{% endif %}>
            {% if is_brand %}
                {{ component('Branding:Identity', {branding: app_branding}) }}
            {% else %}
                {{ _self.label(item) }}
            {% endif %}
            {% if not item.enabled %}
                <span class="ml-1" aria-hidden="true">(disabled)</span>
            {% endif %}
        </{{ tag }}>
    {% endif %}
{% endmacro %}



<nav class="navbar is-dark app-navigation" aria-label="main navigation">
    <div class="navbar-brand">
        {{ _self.link(navigation.brand, 'navbar-item', true) }}
    </div>

    <div class="app-navigation-items">
        {% for item in navigation.items %}
            {% if item.children is defined %}
                <details class="app-navigation-group" name="main-navigation-group">
                    <summary class="navbar-item">{{ _self.label(item) }}</summary>
                    <div class="app-navigation-children">
                        {% for child in item.children %}
                            {{ _self.link(child, 'navbar-item') }}
                        {% endfor %}
                    </div>
                </details>
            {% else %}
                {{ _self.link(item, 'navbar-item') }}
            {% endif %}
        {% endfor %}
    </div>

    <div class="app-navigation-search" data-controller="components--layout--quick-search" data-components--layout--quick-search-items-value="{{ search_items|json_encode|e('html_attr') }}">
        <div class="quick-search-wrapper">
            <input type="search" class="quick-search-input" placeholder="Search... (Ctrl+K)" aria-label="Search pages and settings" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" data-components--layout--quick-search-target="input" data-action="input->components--layout--quick-search#filter keydown->components--layout--quick-search#navigate focus->components--layout--quick-search#show">
            <span class="quick-search-icon"><i class="fas fa-search" aria-hidden="true"></i></span>
            <button type="button" class="quick-search-clear" aria-label="Clear search" data-action="components--layout--quick-search#clear" hidden>
                <i class="fas fa-xmark" aria-hidden="true"></i>
            </button>
            <span class="quick-search-shortcut"><kbd>Ctrl+K</kbd></span>
        </div>
        <div class="quick-search-results" data-components--layout--quick-search-target="results" hidden role="listbox"></div>
    </div>

    <div class="app-navigation-account">
        <div class="navbar-item app-navigation-user">
            <span class="icon-text">
                {% if navigation.account.user_icon %}
                    <span class="icon"><i class="{{ navigation.account.user_icon }}" aria-hidden="true"></i></span>
                {% endif %}
                <span>{{ username }}</span>
            </span>
        </div>
        {{ component('Layout:ThemeToggle') }}
        <div class="navbar-item">
            {{ _self.link(navigation.account.logout, 'button is-light') }}
        </div>
    </div>
</nav>

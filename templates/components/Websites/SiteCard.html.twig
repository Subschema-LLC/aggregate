{% props website, index, include_tags = false, snippet_format = 'window', is_admin = false %}

<details class="box mb-4"{% if index == 1 %} open{% endif %}>
    <summary class="website-summary has-text-weight-semibold">
        <span class="icon-text">
            <span class="icon has-text-primary"><i class="fas fa-globe" aria-hidden="true"></i></span>
            <span>{{ website.name }} <span class="has-text-weight-normal">— {{ website.domain }}</span></span>
        </span>
    </summary>
    <div class="content mt-4">
        <div class="website-token-display mb-4">
            <div>
                <span class="is-size-7 has-text-weight-semibold has-text-grey is-uppercase">Website token:</span>
                <div><code class="website-token" id="token-{{ index }}">{{ website.token }}</code></div>
            </div>
            <div class="is-flex is-align-items-center">
                {{ component('Ui:CopyButton', {target: 'token-' ~ index, status: 'website-token-status-' ~ index, label: 'Copy token', class: 'button is-small is-light'}) }}
                <span id="website-token-status-{{ index }}" class="copy-status is-size-7 ml-2" role="status" aria-live="polite"></span>
            </div>
        </div>

        <div class="website-card-section">
            <div class="level is-mobile mb-2">
                <div class="level-left">
                    <h2 class="title is-5 mb-0">Integration code</h2>
                </div>
                <div class="level-right">
                    <span class="tag is-success is-light is-rounded">
                        <span class="icon is-small mr-1"><i class="fas fa-check" aria-hidden="true"></i></span>
                        Ready to paste
                    </span>
                </div>
            </div>

            {% if website.integration_code is not null %}
                <p class="help mb-2">Add this code to your website's <code>&lt;head&gt;</code> section.</p>
                <pre><code id="code-{{ index }}">{{ website.integration_code }}</code></pre>
                <div class="is-flex is-align-items-center mt-2">
                    {{ component('Ui:CopyButton', {target: 'code-' ~ index, status: 'website-code-status-' ~ index, label: 'Copy to Clipboard', class: 'button is-small is-info copy-btn'}) }}
                    <span id="website-code-status-{{ index }}" class="copy-status is-size-7 ml-2" role="status" aria-live="polite"></span>
                </div>
                {% if include_tags %}
                    <h3 class="title is-6 mt-4 mb-2">Tracker URL for this website</h3>
                    <p class="help mb-2">Add this URL as a script action in the website's Tag manager settings and enable the tag container. Choose the consent category that permits the tracker to load.</p>
                    <pre><code id="tracker-url-{{ index }}">{{ website.tracker_url }}</code></pre>
                    <div class="is-flex is-align-items-center mt-2">
                        {{ component('Ui:CopyButton', {target: 'tracker-url-' ~ index, status: 'website-tracker-status-' ~ index, label: 'Copy tracker URL', class: 'button is-small is-info copy-btn'}) }}
                        <span id="website-tracker-status-{{ index }}" class="copy-status is-size-7 ml-2" role="status" aria-live="polite"></span>
                    </div>
                {% endif %}
            {% else %}
                <div class="notification is-warning" role="status">Installation code is unavailable for this website. Check its script settings.</div>
            {% endif %}
        </div>

        <div class="website-card-section">
            <h2 class="title is-5 mb-2">Allowed domains</h2>
            {% if website.domain_settings_invalid %}
                <div class="notification is-warning is-light mb-3">This website's domain rules are invalid. Events are rejected until valid rules are saved.</div>
            {% elseif website.domain_policy is not defined %}
                <p class="help mb-3">This existing registration permits its primary domain and its subdomains. The list below preserves that behavior; save to make the rules explicit.</p>
            {% endif %}
            <form action="{{ path('app_website_domains', {token: website.token}) }}" method="post" class="mb-5">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('website_domains_' ~ website.token) }}">
                {{ component('Websites:DomainFields', {field_prefix: 'website-domains-' ~ index, domain_settings: website.domain_settings}) }}
                <button type="submit" class="button is-primary mt-3">Save domain rules</button>
            </form>
        </div>

        {% if is_admin %}
            <p class="mt-4"><a href="{{ path('app_setup', {website: website.token, step: 3, format: snippet_format, tags: include_tags ? '1' : '0'}) }}">Open setup and downloads for this website</a></p>
        {% endif %}

        {% component 'Ui:Confirm' with {message: 'Delete this website token? Existing tracker installations using it will stop collecting.', action: path('app_website_delete', {token: website.token}), method: 'post', class: 'mt-5'} %}
            {% block content %}
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('delete_website_' ~ website.token) }}">
            <button type="submit" class="button is-danger is-outlined is-small">Delete Website</button>
            {% endblock %}
        {% endcomponent %}
    </div>
</details>

{% props current_page, selected_site = null %}

<nav class="section-tabs-nav mb-5" aria-label="Tag and consent manager pages">
    <div class="tabs section-underline-tabs">
        <ul>
            <li class="{% if current_page == "app_tag_manager" %}is-active{% endif %}">
                <a href="{{ path("app_tag_manager", selected_site ? {site: selected_site} : {}) }}"{% if current_page == "app_tag_manager" %} aria-current="page"{% endif %}>
                    <span class="icon is-small mr-1"><i class="fas fa-tags" aria-hidden="true"></i></span>
                    <span>Tag manager lite</span>
                </a>
            </li>
            <li class="{% if current_page == "app_consent_manager" %}is-active{% endif %}">
                <a href="{{ path("app_consent_manager", selected_site ? {site: selected_site} : {}) }}"{% if current_page == "app_consent_manager" %} aria-current="page"{% endif %}>
                    <span class="icon is-small mr-1"><i class="fas fa-user-shield" aria-hidden="true"></i></span>
                    <span>Consent manager lite</span>
                </a>
            </li>
        </ul>
    </div>
</nav>

{% props index, tag, script_suggestions = false, custom_scripts_enabled = true, custom_templates = [], tag_ids = [], tracker_namespaces = ['Aggregate'] %}
{% set is_new = tag.is_new|default(false) %}
{% set event_data = tag.event is defined and tag.event is iterable ? tag.event : {} %}
{% set event_name_is_var = event_data.eventName is defined and event_data.eventName is iterable and event_data.eventName['$var'] is defined %}
{% set event_name_type = event_name_is_var ? ((event_data.eventName.from|default('recent')) == 'event' ? 'var_event' : 'var') : 'string' %}
{% set event_name_val = event_name_is_var ? event_data.eventName['$var'] : (event_data.eventName|default('')) %}
{% set custom_data_entries = [] %}
{% if event_data.customData is defined and event_data.customData is iterable %}
    {% for cd_key, cd_val in event_data.customData %}
        {% set cd_json = cd_val|json_encode %}
        {% if cd_val is iterable and cd_val['$var'] is defined %}
            {% set cd_var_type = (cd_val.from|default('recent')) == 'event' ? 'var_event' : 'var' %}
            {% set custom_data_entries = custom_data_entries|merge([{key: cd_key, type: cd_var_type, value: cd_val['$var']}]) %}
        {% elseif cd_val is same as(null) %}
            {% set custom_data_entries = custom_data_entries|merge([{key: cd_key, type: 'null', value: ''}]) %}
        {% elseif cd_val is same as(true) or cd_val is same as(false) %}
            {% set custom_data_entries = custom_data_entries|merge([{key: cd_key, type: 'boolean', value: cd_val ? 'true' : 'false'}]) %}
        {% elseif cd_json starts with '"' %}
            {% set custom_data_entries = custom_data_entries|merge([{key: cd_key, type: 'string', value: cd_val}]) %}
        {% else %}
            {% set custom_data_entries = custom_data_entries|merge([{key: cd_key, type: 'number', value: cd_json}]) %}
        {% endif %}
    {% endfor %}
{% endif %}
{% if custom_data_entries is empty %}
    {% set custom_data_entries = [{key: '', type: 'string', value: ''}] %}
{% endif %}
{% set goal_has_key = 'goalEvent' in (event_data|keys) %}
{% set goal_is_var = goal_has_key and event_data.goalEvent is iterable and event_data.goalEvent['$var'] is defined %}
{% set goal_is_null = goal_has_key and event_data.goalEvent is same as(null) %}
{% set goal_type = goal_is_var ? ((event_data.goalEvent.from|default('recent')) == 'event' ? 'var_event' : 'var') : (goal_is_null ? 'null' : 'string') %}
{% set goal_val = goal_is_var ? event_data.goalEvent['$var'] : (goal_is_null ? '' : (event_data.goalEvent|default(''))) %}
{% set page_path_is_var = event_data.pagePath is defined and event_data.pagePath is iterable and event_data.pagePath['$var'] is defined %}
{% set page_path_type = page_path_is_var ? ((event_data.pagePath.from|default('recent')) == 'event' ? 'var_event' : 'var') : 'string' %}
{% set page_path_val = page_path_is_var ? event_data.pagePath['$var'] : (event_data.pagePath|default('')) %}

<div class="box">
    <fieldset class="tag-settings-fieldset" data-tag-row data-controller="components--tag-manager--tag-row" data-components--tag-manager--tag-row-namespaces-value="{{ tracker_namespaces|json_encode }}"{% if is_new and tag.src|default('') %} data-components--tag-manager--tag-row-default-id-value="{{ tag.id }}" data-components--tag-manager--tag-row-default-src-value="{{ tag.src }}"{% endif %} aria-describedby="tag-{{ index }}-help">
        <legend class="title is-5">{% if tag.id and not is_new %}Tag {{ index + 1 }}: {{ tag.id }}{% else %}Add a tag{% endif %}</legend>
        <p class="help mb-3" id="tag-{{ index }}-help">Choose one action and a trigger. Leave a new row's ID, URL, method, event and code empty to keep the current list.</p>
        <div class="field"><label class="label" for="tag-{{ index }}-id">ID</label><div class="control"><input class="input" id="tag-{{ index }}-id" name="tags[{{ index }}][id]" value="{{ tag.id }}" maxlength="64" pattern="[A-Za-z][A-Za-z0-9_\-]{0,63}" autocomplete="off" placeholder="purchase-event"></div></div>
        <div class="field">
            <label class="label" for="tag-{{ index }}-type">Action</label>
            <div class="control select"><select id="tag-{{ index }}-type" name="tags[{{ index }}][type]" data-tag-type data-components--tag-manager--tag-row-target="actionType" data-action="change->components--tag-manager--tag-row#update" required>
                <option value="script"{% if tag.type == 'script' %} selected{% endif %}>Load an HTTPS script</option>
                <option value="event"{% if tag.type == 'event' %} selected{% endif %}>Send an Aggregate event</option>
                <option value="call"{% if tag.type == 'call' %} selected{% endif %}>Call a library method</option>
                {% if custom_scripts_enabled or tag.type == 'custom' %}<option value="custom"{% if tag.type == 'custom' %} selected{% endif %}>Run custom JavaScript</option>{% endif %}
            </select></div>
        </div>
        <div data-components--tag-manager--tag-row-target="actionFields" data-action-fields="script">
            <div class="field"><label class="label" for="tag-{{ index }}-src">HTTPS script URL</label><div class="control"><input class="input" type="text" id="tag-{{ index }}-src" name="tags[{{ index }}][src]" value="{{ tag.src|default('') }}" maxlength="2048" autocomplete="off" placeholder="https://scripts.example.com/helper.js"{% if script_suggestions %} list="tag-script-suggestions"{% endif %} data-components--tag-manager--tag-row-target="source" data-action="input->components--tag-manager--tag-row#normalizeSource"></div><p class="help">Use a fixed HTTPS host; optional variable placeholders belong in the path or query.{% if script_suggestions and not tag.src|default('') %} Start typing <code>https</code> to choose this website's tracker URL.{% endif %}</p><p class="help is-info" role="status" data-components--tag-manager--tag-row-target="sourceNote" hidden>Replaced HTML <code>&amp;amp;</code> separators with <code>&amp;</code>, as the browser needs.</p></div>
        </div>
        <div data-components--tag-manager--tag-row-target="actionFields" data-action-fields="call">
            <div class="field"><label class="label" for="tag-{{ index }}-method">Library method</label><div class="control"><input class="input" id="tag-{{ index }}-method" name="tags[{{ index }}][method]" value="{{ tag.method|default('') }}" maxlength="128" autocomplete="off" placeholder="{{ tracker_namespaces|first }}.emit" data-components--tag-manager--tag-row-target="method" data-action="input->components--tag-manager--tag-row#checkArguments"></div><p class="help">Use a named method such as <code>{{ tracker_namespaces|first }}.emit</code> or <code>Acme.track</code>. Its library must already be loaded. Expressions, constructors and JavaScript code are not accepted.</p></div>
            <div class="field"><label class="label" for="tag-{{ index }}-args">Arguments (JSON array)</label><div class="control"><textarea class="textarea" id="tag-{{ index }}-args" name="tags[{{ index }}][args_json]" rows="4" spellcheck="false" data-components--tag-manager--tag-row-target="arguments" data-action="input->components--tag-manager--tag-row#checkArguments" aria-describedby="tag-{{ index }}-args-help tag-{{ index }}-args-status">{{ tag.args_json is defined ? tag.args_json : tag.args|default([])|json_encode(448) }}</textarea></div><p class="help" id="tag-{{ index }}-args-help">Example: <code>["purchase", {"total_minor": 1299, "plan": {"$var": "plan"}}]</code>. To send an Aggregate event, choose <strong>Send an Aggregate event</strong>; with <code>{{ tracker_namespaces|first }}.emit</code> here, the second argument holds the event properties themselves, each one text, a number, true, false or null. Arguments are bounded JSON data; they are never evaluated as code. Leave the URL empty for a method action.</p>
                <div class="notification is-warning is-light mt-2 mb-0 py-3" id="tag-{{ index }}-args-status" role="status" aria-live="polite" data-components--tag-manager--tag-row-target="argumentsStatus" hidden><p data-components--tag-manager--tag-row-target="argumentsMessage"></p><button type="button" class="button is-small mt-2" data-components--tag-manager--tag-row-target="argumentsFix" data-action="components--tag-manager--tag-row#convertToEvent" hidden></button></div></div>
        </div>
        <div data-components--tag-manager--tag-row-target="actionFields" data-action-fields="event">
            <div class="field">
                <div class="level is-mobile mb-2">
                    <div class="level-left">
                        <label class="label mb-0" id="tag-{{ index }}-event-label" for="tag-{{ index }}-event-object">Event (JSON object)</label>
                    </div>
                    <div class="level-right">
                        <div class="buttons has-addons mb-0" role="group" aria-label="Event editor format">
                            <button type="button" class="button is-small" data-event-mode="kv" data-components--tag-manager--tag-row-target="eventModeButton" data-action="components--tag-manager--tag-row#switchEventMode" data-components--tag-manager--tag-row-mode-param="kv" aria-pressed="false">Key-value pairs</button>
                            <button type="button" class="button is-small is-primary is-selected" data-event-mode="json" data-components--tag-manager--tag-row-target="eventModeButton" data-action="components--tag-manager--tag-row#switchEventMode" data-components--tag-manager--tag-row-mode-param="json" aria-pressed="true">JSON</button>
                        </div>
                    </div>
                </div>
                <div data-components--tag-manager--tag-row-target="eventJsonPane">
                    <div class="control"><textarea class="textarea" id="tag-{{ index }}-event-object" name="tags[{{ index }}][event_json]" rows="8" spellcheck="false" autocomplete="off" placeholder="{&quot;eventName&quot;: &quot;login&quot;, &quot;customData&quot;: {&quot;method&quot;: {&quot;$var&quot;: &quot;login_method&quot;}}}" data-components--tag-manager--tag-row-target="event" data-action="input->components--tag-manager--tag-row#checkEvent" aria-describedby="tag-{{ index }}-event-object-status tag-{{ index }}-event-object-help">{{ tag.event_json is defined ? tag.event_json : (tag.event is defined ? tag.event|json_encode(448) : '') }}</textarea></div>
                </div>
                <div class="box is-shadowless p-3 mb-2" data-components--tag-manager--tag-row-target="eventKvPane" hidden>
                    <div class="field">
                        <label class="label is-small" for="tag-{{ index }}-event-name">Event name</label>
                        <div class="field has-addons mb-0">
                            <div class="control">
                                <div class="select is-small">
                                    <select id="tag-{{ index }}-event-name-type" aria-label="Event name source" data-components--tag-manager--tag-row-target="eventNameType" data-action="change->components--tag-manager--tag-row#syncEventFromKv">
                                        <option value="string"{% if event_name_type == 'string' %} selected{% endif %}>Fixed name</option>
                                        <option value="var"{% if event_name_type == 'var' %} selected{% endif %}>Variable (most recent)</option>
                                        <option value="var_event"{% if event_name_type == 'var_event' %} selected{% endif %}>Variable (pushed event)</option>
                                    </select>
                                </div>
                            </div>
                            <div class="control is-expanded">
                                <input class="input is-small" type="text" id="tag-{{ index }}-event-name" value="{{ event_name_val }}" maxlength="100" autocomplete="off" placeholder="{{ event_name_is_var ? 'event_name' : 'login' }}"{% if event_name_is_var %} list="tag-variable-aliases"{% endif %} data-components--tag-manager--tag-row-target="eventNameInput" data-action="input->components--tag-manager--tag-row#syncEventFromKv">
                            </div>
                        </div>
                    </div>
                    <div class="field">
                        <label class="label is-small">Custom data properties (key-value pairs)</label>
                        <div data-components--tag-manager--tag-row-target="customDataRows">
                            {% for prop in custom_data_entries %}
                                {% set prop_is_var = prop.type in ['var', 'var_event'] %}
                                <div class="field is-grouped mb-2" data-custom-data-row>
                                    <div class="control is-expanded">
                                        <input class="input is-small" type="text" data-cd-key value="{{ prop.key }}" maxlength="64" autocomplete="off" placeholder="Property key (e.g. plan)" aria-label="Custom data property key" data-action="input->components--tag-manager--tag-row#syncEventFromKv">
                                    </div>
                                    <div class="control">
                                        <div class="select is-small">
                                            <select data-cd-type aria-label="Custom data property type" data-action="change->components--tag-manager--tag-row#syncEventFromKv">
                                                <option value="string"{% if prop.type == 'string' %} selected{% endif %}>Text</option>
                                                <option value="var"{% if prop.type == 'var' %} selected{% endif %}>Variable (most recent)</option>
                                                <option value="var_event"{% if prop.type == 'var_event' %} selected{% endif %}>Variable (pushed event)</option>
                                                <option value="number"{% if prop.type == 'number' %} selected{% endif %}>Number</option>
                                                <option value="boolean"{% if prop.type == 'boolean' %} selected{% endif %}>Boolean</option>
                                                <option value="null"{% if prop.type == 'null' %} selected{% endif %}>Null</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="control is-expanded"{% if prop.type == 'boolean' %} hidden{% endif %} data-cd-value-wrap>
                                        <input class="input is-small" type="text" data-cd-value value="{{ prop.type in ['boolean', 'null'] ? '' : prop.value }}" maxlength="500" autocomplete="off" placeholder="{{ prop_is_var ? 'Variable alias (e.g. plan)' : (prop.type == 'number' ? '0' : (prop.type == 'null' ? 'null' : 'Value')) }}"{% if prop_is_var %} list="tag-variable-aliases"{% endif %}{% if prop.type == 'null' %} disabled{% endif %} aria-label="Custom data property value" data-action="input->components--tag-manager--tag-row#syncEventFromKv">
                                    </div>
                                    <div class="control is-expanded"{% if prop.type != 'boolean' %} hidden{% endif %} data-cd-bool-wrap>
                                        <div class="select is-small is-fullwidth">
                                            <select data-cd-bool aria-label="Custom data boolean value" data-action="change->components--tag-manager--tag-row#syncEventFromKv">
                                                <option value="true"{% if prop.value != 'false' %} selected{% endif %}>true</option>
                                                <option value="false"{% if prop.value == 'false' %} selected{% endif %}>false</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="control">
                                        <button type="button" class="button is-small is-light" data-cd-remove aria-label="Remove property" data-action="components--tag-manager--tag-row#removeCustomDataRow">Remove</button>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                        <button type="button" class="button is-small is-light mt-1" data-components--tag-manager--tag-row-target="addCustomDataButton" data-action="components--tag-manager--tag-row#addCustomDataRow">
                            <span class="icon is-small"><i class="fas fa-plus" aria-hidden="true"></i></span>
                            <span>Add property</span>
                        </button>
                    </div>
                    <div class="columns is-multiline mb-0">
                        <div class="column is-half py-1">
                            <div class="field">
                                <label class="label is-small" for="tag-{{ index }}-goal-event">Goal code (optional)</label>
                                <div class="field has-addons mb-0">
                                    <div class="control">
                                        <div class="select is-small">
                                            <select id="tag-{{ index }}-goal-event-type" aria-label="Goal code source" data-components--tag-manager--tag-row-target="goalEventType" data-action="change->components--tag-manager--tag-row#syncEventFromKv">
                                                <option value="string"{% if goal_type == 'string' %} selected{% endif %}>Goal code</option>
                                                <option value="var"{% if goal_type == 'var' %} selected{% endif %}>Variable (most recent)</option>
                                                <option value="var_event"{% if goal_type == 'var_event' %} selected{% endif %}>Variable (pushed event)</option>
                                                <option value="null"{% if goal_type == 'null' %} selected{% endif %}>Null</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="control is-expanded">
                                        <input class="input is-small" type="text" id="tag-{{ index }}-goal-event" value="{{ goal_val }}" maxlength="100" autocomplete="off" placeholder="{{ goal_is_var ? 'goal_code' : (goal_type == 'null' ? 'null' : 'signup') }}"{% if goal_is_var %} list="tag-variable-aliases"{% endif %}{% if goal_type == 'null' %} disabled{% endif %} data-components--tag-manager--tag-row-target="goalEventInput" data-action="input->components--tag-manager--tag-row#syncEventFromKv">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="column is-half py-1">
                            <div class="field">
                                <label class="label is-small" for="tag-{{ index }}-page-path">Virtual page path (optional)</label>
                                <div class="field has-addons mb-0">
                                    <div class="control">
                                        <div class="select is-small">
                                            <select id="tag-{{ index }}-page-path-type" aria-label="Virtual page path source" data-components--tag-manager--tag-row-target="pagePathType" data-action="change->components--tag-manager--tag-row#syncEventFromKv">
                                                <option value="string"{% if page_path_type == 'string' %} selected{% endif %}>Page path</option>
                                                <option value="var"{% if page_path_type == 'var' %} selected{% endif %}>Variable (most recent)</option>
                                                <option value="var_event"{% if page_path_type == 'var_event' %} selected{% endif %}>Variable (pushed event)</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="control is-expanded">
                                        <input class="input is-small" type="text" id="tag-{{ index }}-page-path" value="{{ page_path_val }}" maxlength="512" autocomplete="off" placeholder="{{ page_path_is_var ? 'page_path' : '/checkout/step-2' }}"{% if page_path_is_var %} list="tag-variable-aliases"{% endif %} data-components--tag-manager--tag-row-target="pagePathInput" data-action="input->components--tag-manager--tag-row#syncEventFromKv">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <p class="help custom-code-status" id="tag-{{ index }}-event-object-status" role="status" aria-live="polite" data-components--tag-manager--tag-row-target="eventStatus"></p>
                <p class="help" id="tag-{{ index }}-event-object-help">Sends an event through this website's tracker, as <code>{{ tracker_namespaces|first }}.emit({…})</code> would. <code>eventName</code> names it; <code>customData</code> holds its own properties, each text, a number, true, false or null, <code>{"$var": "alias"}</code> for the most recent <code>dataLayer</code> value, or <code>{"$var": "alias", "from": "event"}</code> for the pushed event's value. Toggle between <strong>Key-value pairs</strong> and <strong>JSON</strong> to edit properties either way. <code>goalEvent</code> and <code>pagePath</code>, a virtual page path, are optional. The tag waits for the tracker to load, so it needs no tag chaining. {% if docs_url('tracking.tag-manager') %}<a href="{{ docs_url('tracking.tag-manager') }}#send-an-aggregate-event" target="_blank" rel="noopener noreferrer">Aggregate events<span class="is-sr-only"> (opens in a new tab)</span></a>{% endif %}</p>
            </div>
        </div>
        <div data-components--tag-manager--tag-row-target="actionFields" data-action-fields="custom">
            {% if not custom_scripts_enabled %}<p class="notification is-warning is-light">Custom JavaScript is turned off for this installation on the Feature flags page. This tag is kept but not served, and its code cannot be changed.</p>{% endif %}
            {% if custom_templates is not empty %}
            <div class="field">
                <label class="label" for="tag-{{ index }}-template">Start from a template</label>
                <div class="control"><div class="select"><select id="tag-{{ index }}-template" data-components--tag-manager--tag-row-target="template" data-action="change->components--tag-manager--tag-row#applyTemplate" aria-describedby="tag-{{ index }}-template-help">
                    <option value="">Choose a template…</option>
                    {% for group, templates in custom_templates %}<optgroup label="{{ group }}">{% for template in templates %}<option value="{{ template.id }}" title="{{ template.description }}">{{ template.label }}</option>{% endfor %}</optgroup>{% endfor %}
                </select></div></div>
                <p class="help" id="tag-{{ index }}-template-help">Fills in the code, a trigger, a consent category and, for a new tag, an ID. Review it before saving, especially selectors, event names and addresses.</p>
            </div>
            {% endif %}
            <div class="field">
                <label class="label label-with-tooltip" for="tag-{{ index }}-code">
                    <span class="field-label-wrap">
                        <span>JavaScript</span>
                        <span class="field-tooltip" tabindex="0" role="button" aria-label="How custom JavaScript runs" aria-describedby="tag-{{ index }}-code-tip">
                            <span class="icon is-small has-text-info"><i class="fas fa-circle-question" aria-hidden="true"></i></span>
                            <span class="tooltip-bubble" id="tag-{{ index }}-code-tip" role="tooltip">
                                <strong>How it runs:</strong> your code is the body of <code>function (tag) { 'use strict'; … }</code>. It runs when the trigger fires and consent allows; errors are caught and logged with the tag's ID.
                                <ul class="custom-api">
                                    <li><code>tag.get('alias')</code> reads a variable</li>
                                    <li><code>tag.event</code> trigger, event name and detail</li>
                                    <li><code>tag.data</code> a copy of the dataLayer model</li>
                                    <li><code>tag.consent('marketing')</code> checks a category</li>
                                    <li><code>tag.emit('name', {…})</code> sends an Aggregate event</li>
                                    <li><code>tag.push({event: '…'})</code> adds to the dataLayer</li>
                                    <li><code>tag.loadScript(url)</code> loads HTTPS scripts</li>
                                    <li><code>tag.onCleanup(fn)</code> runs when consent is withdrawn</li>
                                </ul>
                                Not allowed: HTML, <code>eval</code>, <code>new Function</code>, text in timers, <code>document.write</code>, <code>import()</code>, <code>debugger</code>.
                            </span>
                        </span>
                    </span>
                </label>
                <div class="control"><textarea class="textarea custom-code" id="tag-{{ index }}-code" name="tags[{{ index }}][code]" rows="12" spellcheck="false" autocapitalize="off" autocomplete="off" wrap="off" placeholder="// Runs when the trigger fires and consent allows, as the body of
// function (tag) { 'use strict'; ... }. Your variables stay local.
// tag.get('alias')   tag.event   tag.data   tag.consent('marketing')
// tag.emit('name', {key: 'value'})   tag.push({event: 'name'})
// tag.loadScript('https://...')   tag.onCleanup(() => { ... })
tag.emit('newsletter_signup', {plan: tag.get('plan')});" data-components--tag-manager--tag-row-target="code" data-action="input->components--tag-manager--tag-row#checkCode" aria-describedby="tag-{{ index }}-code-status tag-{{ index }}-code-help"{% if not custom_scripts_enabled %} readonly{% endif %}>{{ tag.code|default('') }}</textarea></div>
                <p class="help custom-code-status" id="tag-{{ index }}-code-status" role="status" aria-live="polite" data-components--tag-manager--tag-row-target="codeStatus"></p>
                <p class="help" id="tag-{{ index }}-code-help">Runs on visitors' pages with full access to them, so review code as you would a script on your own site. The server checks it again when you save; up to 20,000 bytes per tag. {% if docs_url('tracking.tag-manager') %}<a href="{{ docs_url('tracking.tag-manager') }}#custom-javascript" target="_blank" rel="noopener noreferrer">Custom JavaScript guide<span class="is-sr-only"> (opens in a new tab)</span></a>{% endif %}</p>
            </div>
        </div>
        <div class="field"><label class="label" for="tag-{{ index }}-consent">Consent category</label><div class="control"><input class="input" id="tag-{{ index }}-consent" name="tags[{{ index }}][consent]" value="{{ tag.consent }}" list="tag-consent-categories" maxlength="32" pattern="[a-z][a-z0-9_\-]{0,31}" required></div><p class="help">Use analytics, functional, marketing, or another lowercase category. Enter none for <strong>No consent required</strong>; that action may run before a choice and after rejection.</p></div>
        <div class="field"><label class="label" for="tag-{{ index }}-enabled">Availability</label><div class="control select"><select id="tag-{{ index }}-enabled" name="tags[{{ index }}][enabled]" required><option value="1"{% if tag.enabled %} selected{% endif %}>Enabled</option><option value="0"{% if not tag.enabled %} selected{% endif %}>Disabled</option></select></div></div>
        <div class="field"><label class="label" for="tag-{{ index }}-trigger">Trigger</label><div class="control select"><select id="tag-{{ index }}-trigger" name="tags[{{ index }}][trigger][type]" data-tag-trigger data-components--tag-manager--tag-row-target="trigger" data-action="change->components--tag-manager--tag-row#update" required>
            {% for type, label in {dom_ready: 'Document ready', window_load: 'Window finished loading', document_event: 'Document event', window_event: 'Window event', data_layer: 'dataLayer event'} %}<option value="{{ type }}"{% if tag.trigger.type == type %} selected{% endif %}>{{ label }}</option>{% endfor %}
        </select></div></div>
        <div class="field" data-event-field data-components--tag-manager--tag-row-target="eventField"><label class="label" for="tag-{{ index }}-event">Event name</label><div class="control"><input class="input" id="tag-{{ index }}-event" name="tags[{{ index }}][trigger][event]" value="{{ tag.trigger.event|default('') }}" maxlength="100" pattern="[A-Za-z][A-Za-z0-9_.:\-]{0,99}" list="tag-event-examples" placeholder="purchase"></div><p class="help">Enter the exact name for a document, window or dataLayer event. Leave empty for document ready or window load. The event is a trigger; its payload is not copied into arguments automatically.</p></div>
        {% set after = tag.after|default('') %}
        <div class="field">
            <label class="label" for="tag-{{ index }}-after">Tag chaining</label>
            <div class="control"><div class="select"><select id="tag-{{ index }}-after" name="tags[{{ index }}][after]" data-tag-after aria-describedby="tag-{{ index }}-after-help">
                <option value="">Not chained: run on the trigger</option>
                {% for id in tag_ids %}{% if id != tag.id %}<option value="{{ id }}"{% if after == id %} selected{% endif %}>Run after {{ id }}</option>{% endif %}{% endfor %}
                {% if after and after not in tag_ids %}<option value="{{ after }}" selected>Run after {{ after }}</option>{% endif %}
            </select></div></div>
            <p class="help" id="tag-{{ index }}-after-help">Run after another tag: this tag waits until that tag has finished, meaning its script has loaded or its method call or custom code is done. Use it to run code after the tracker or a vendor library has loaded. Choose a tag that runs once per page; if it never runs, this one does not either.</p>
        </div>
        {% if tag.id and not is_new %}<label class="checkbox"><input type="checkbox" name="tags[{{ index }}][remove]" value="1"{% if tag.remove|default(false) %} checked{% endif %}> Remove this tag when saving</label>{% endif %}
    </fieldset>
</div>

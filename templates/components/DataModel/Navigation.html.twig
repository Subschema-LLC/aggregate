{% props current_model_page %}

<nav class="buttons mb-5" aria-label="Data model pages">
    {% for route, label in {
        app_data_model: 'Edit model',
        app_event_examples: 'Event examples',
        app_data_model_discovery: 'Observed properties',
        app_data_model_reporting: 'Reporting views'
    } %}
        <a class="button{% if current_model_page == route %} is-link is-light{% endif %}" href="{{ path(route) }}"{% if current_model_page == route %} aria-current="page"{% endif %}>{{ label }}</a>
    {% endfor %}
</nav>

{% extends 'base.html.twig' %}

{% block title %}Tag manager - {{ app_branding.name }}{% endblock %}

{% block body %}
{% set rows = settings.tags %}
{% set existing_tag_ids = rows|map(row => row.id|default(''))|filter(id => id != '') %}
{% set has_new_row = rows|length < max_tags %}
{% set suggest_tracker = tracker_url and not tracker_tag %}
{% set prepopulate_tracker = suggest_tracker and not restored_form|default(false) %}
{% set new_row_id = prepopulate_tracker and (tracker_tag_id|default('aggregate-tracker') not in existing_tag_ids) ? tracker_tag_id|default('aggregate-tracker') : '' %}
{% if has_new_row %}{% set rows = rows|merge([{id: new_row_id, src: prepopulate_tracker ? tracker_url : '', type: 'script', enabled: true, consent: 'analytics', trigger: {type: 'dom_ready'}, is_new: true}]) %}{% endif %}
<div class="tag-settings" data-site-id="{{ selected_site }}" data-controller="pages--tag-manager--index" data-action="input->pages--tag-manager--index#refreshRunAfter input->pages--tag-manager--index#refreshVariableAliases components--tag-manager--tag-row:createVariable->pages--tag-manager--index#createVariable" data-pages--tag-manager--index-max-tags-value="{{ max_tags }}" data-pages--tag-manager--index-max-variables-value="{{ max_variables }}"{% if has_new_row %} data-pages--tag-manager--index-new-row-value="{{ rows|length - 1 }}"{% endif %}>
    <div class="level">
        <div class="level-left">
            <div>
                <h1 class="title">Tag manager lite</h1>
                <p class="subtitle">Choose a website, configure its tags, and download its YAML. Its consent banner has its own page, <a href="{{ path('app_consent_manager', site ? {site: selected_site} : {}) }}">Consent manager lite</a>.</p>
                {{ component('Ui:DocsLink', {topic: 'tracking.tag-manager', label: 'Tag manager guide'}) }}
            </div>
        </div>
        <div class="level-right">
            {{ component('Ui:CardControls', {class: 'page-card-controls mb-0', website_selector: false}) }}
        </div>
    </div>
    {{ component('TagManager:Navigation', {current_page: 'app_tag_manager', selected_site: selected_site}) }}
    <div class="box">
        <div class="columns">
            <div class="column">
                <form method="get" action="{{ path('app_tag_manager') }}">
                    <div class="field">
                        <label class="label" for="tag-manager-site">Website</label>
                        <div class="control select"><select id="tag-manager-site" name="site">
                            {% for website in sites %}<option value="{{ website.id }}"{% if selected_site == website.id %} selected{% endif %}>{{ website.name }} ({{ website.domain }})</option>{% endfor %}
                            {% if can_use_shared is not defined or can_use_shared %}<option value=""{% if selected_site == '' %} selected{% endif %}>Shared configuration</option>{% endif %}
                        </select></div>
                    </div>
                    <div class="buttons">
                        <button type="submit" class="button">Open website settings</button>
                        {% if not configuration_error %}
                            <a class="button" href="{{ path('app_tag_manager_download', {site: selected_site}) }}">Download settings YAML</a>
                        {% endif %}
                    </div>
                </form>
            </div>
            {% if not configuration_error %}
                <div class="column">
                    <div class="field">
                        <label class="label" for="tag-manager-enabled">Tag manager</label>
                        <div class="control select"><select id="tag-manager-enabled" name="enabled" form="tag-manager-form" required aria-describedby="tag-manager-enabled-help">
                            <option value="0"{% if not settings.enabled %} selected{% endif %}>Disabled</option>
                            <option value="1"{% if settings.enabled %} selected{% endif %}>Enabled</option>
                        </select></div>
                        <p class="help" id="tag-manager-enabled-help">Disabling preserves definitions and prevents new page loads from receiving these tags.</p>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
    <h2 class="title is-4" id="tag-manager-scope">{{ site ? site.name : 'Shared configuration' }}</h2>
    <div class="content">
        {% if site %}
            <p>These settings belong to <strong>{{ site.domain }}</strong>. They are saved separately from other websites and shared configuration. New websites start with tags disabled.</p>
        {% else %}
            <p>These shared settings are used by the unscoped tag script. Website-specific scripts use their own files and do not inherit these tags.</p>
        {% endif %}
        <details>
            <summary>Advanced: YAML file and installation scripts</summary>
            {% if site %}<p class="mt-2">Headless configuration: <code>config/tag-manager/sites/{{ selected_site }}.yaml</code>. The same validation applies to UI and YAML changes.</p>{% endif %}
            <p class="mt-2"><a href="{{ path('app_setup', site ? {website: site.token, step: 3, tags: '1'} : {step: 3, tags: '1'}) }}">Open setup to copy or download scripts, or build compact versions.</a></p>
        </details>
    </div>

    {% if tracker_url and not configuration_error %}
        <section class="box" aria-labelledby="tag-manager-tracker-title">
            <h3 class="title is-5" id="tag-manager-tracker-title">Tracker URL for {{ site.domain }}</h3>
            {% if tracker_tag %}
                <p class="mb-3">This website's tracker is loaded by the tag <strong>{{ tracker_tag }}</strong>.</p>
            {% else %}
                <p class="mb-3">To collect analytics through the tag manager, load this URL with a <strong>Load an HTTPS script</strong> action on <strong>Document ready</strong>. Choose <code>none</code> to allow the tracker's anonymous mode before a choice, or <code>analytics</code> to wait for analytics consent. Remove any other tracker installation on the site to avoid duplicate page views.</p>
            {% endif %}
            <pre class="setup-code"><code id="tag-manager-tracker-url">{{ tracker_url }}</code></pre>
            <div class="buttons mt-3">
                {% if not tracker_tag and has_new_row %}
                    <button type="button" class="button is-primary" data-action="pages--tag-manager--index#addTracker" data-pages--tag-manager--index-url-param="{{ tracker_url }}" data-pages--tag-manager--index-id-param="{{ tracker_tag_id }}">
                        <span class="icon is-small"><i class="fas fa-plus" aria-hidden="true"></i></span>
                        <span>Add as a new tag</span>
                    </button>
                {% endif %}
                {{ component('Ui:CopyButton', {target: 'tag-manager-tracker-url', status: 'tag-manager-tracker-status', label: 'Copy tracker URL', class: 'button'}) }}
            </div>
            <p class="help" id="tag-manager-tracker-status" role="status" aria-live="polite" data-pages--tag-manager--index-target="status"></p>
            <details class="help mt-2"><summary>Send custom data with the page view</summary><p class="mt-1">Add <code>&amp;cd.&lt;property&gt;=&lt;value&gt;</code> to the URL, for example <code>&amp;cd.page_type={% verbatim %}{{page_type}}{% endverbatim %}</code> with a variable below. Each property must be defined in the <a href="{{ path('app_data_model') }}">data model</a>, and those requiring consent are recorded only after an analytics choice. If a variable is missing on a page, the whole tag is skipped and the tracker does not load there.</p></details>
        </section>
    {% endif %}

    <details class="box mb-5">
        <summary class="has-text-weight-semibold">
            <span class="icon-text">
                <span class="icon has-text-info"><i class="fas fa-circle-question" aria-hidden="true"></i></span>
                <span>Tag execution, variables & consent rules</span>
            </span>
        </summary>
        <div class="content mt-3">
            <p>A tag loads an HTTPS script or calls a named method in an existing library when its trigger and consent requirement match. Tags marked <strong>No consent required</strong> may run without a visitor choice. Consent-gated event triggers skipped before consent are not replayed.</p>
            <p>Tag definitions, literal arguments and variable paths are public. Use trusted libraries and avoid secrets or personal data. Variables read the current page only when an eligible tag runs.</p>
            <p>Withdrawal prevents later actions requiring that category; it cannot undo a method call, remove an already loaded script, or erase provider cookies or data. Use the provider's withdrawal controls and reload the page.</p>
        </div>
    </details>

    {% if site and consent_settings %}
        <div class="box">
            <p><strong>Consent manager lite:</strong> {{ consent_settings.enabled ? 'enabled' : 'disabled (use your own CMP)' }}. It asks visitors about analytics and each consent category used by this website’s enabled tags.</p>
            <p class="mt-2"><a class="button is-small" href="{{ path('app_consent_manager', {site: selected_site}) }}">Configure the consent banner</a></p>
        </div>
    {% endif %}

    {% if configuration_error %}
        <div class="notification is-danger" role="alert">{{ configuration_error }}</div>
    {% else %}
        {% component 'Ui:Validation' with {action: path('app_tag_manager_save'), method: 'post', id: 'tag-manager-form', 'aria-labelledby': 'tag-manager-scope'} %}
        {% block content %}
            {% if restored_form %}
                <div class="notification is-warning" role="alert">
                    <span class="icon is-small mr-1"><i class="fas fa-clock-rotate-left" aria-hidden="true"></i></span>
                    <strong>Values preserved:</strong> Nothing was saved. The settings you entered are shown below so you can correct the error and save again without retyping.
                </div>
            {% endif %}
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('tag_manager_settings') }}">
            <input type="hidden" name="site" value="{{ selected_site }}">

            {{ component('Ui:ToggleTabs', {
                label: 'Tag manager sections',
                current: 'variables',
                items: [
                    {id: 'variables', label: 'Variables', icon: 'fas fa-code', badge: settings.variables|length},
                    {id: 'tags', label: 'Tags', icon: 'fas fa-tags', badge: settings.tags|length},
                    {id: 'triggers', label: 'Triggers', icon: 'fas fa-bolt'}
                ]
            }) }}

            <div id="pane-variables" class="workspace-pane nested-toggle-pane is-active" role="tabpanel" aria-labelledby="tab-variables" data-toggle-pane="variables" data-pane-name="variables">
                <details class="box" open>
                    <summary class="has-text-weight-semibold">Variables — read values from this page</summary>
                    <div class="content mt-3">
                        <p>Give each value you want to use a name and its path in the data layer. After <code>dataLayer.push({event: 'view_item', page_type: 'program', ecommerce: {items: [{category: 'Nursing'}]}})</code>, the path <code>page_type</code> reads <code>program</code> and <code>ecommerce.items[0].category</code> reads <code>Nursing</code>.</p>
                        <p>Paths read what the page has pushed to <code>window.dataLayer</code>, merged across pushes, and <code>event.detail</code> for document and window events. They do not read other page globals such as <code>window.siteData</code>, and they never run JavaScript. When a value is missing, the tag that uses it is skipped.</p>
                        <details><summary>Use a variable in a script URL, method arguments or event JSON</summary><p class="mt-2">Write <code>{% verbatim %}{{category}}{% endverbatim %}</code> in a script URL's path or query, or <code>{"$var": "category"}</code> in method arguments and event JSON. URL values are encoded; the host stays fixed. The event editor's key-value pairs choose variables for you.</p></details>
                    </div>
                    {% if variable_rows|length < max_variables %}{% set variable_rows = variable_rows|merge([{alias: '', path: ''}]) %}{% endif %}
                    <div data-pages--tag-manager--index-target="variableRows">
                    {% for variable in variable_rows %}
                        {{ component('TagManager:VariableRow', {index: loop.index0, variable: variable}) }}
                    {% endfor %}
                    </div>
                    {# A blank row the page copies for "Add another variable"; __INDEX__ becomes the next row number. #}
                    <template data-pages--tag-manager--index-target="variableTemplate">{{ component('TagManager:VariableRow', {index: '__INDEX__', variable: {alias: '', path: ''}, added: true}) }}</template>
                    <div class="buttons mb-2">
                        <button type="button" class="button is-small" data-pages--tag-manager--index-target="addVariableButton" data-action="pages--tag-manager--index#addVariableRow"{% if variable_rows|length >= max_variables %} disabled{% endif %}>
                            <span class="icon is-small"><i class="fas fa-plus" aria-hidden="true"></i></span>
                            <span>Add another variable</span>
                        </button>
                    </div>
                    <p class="help">Up to {{ max_variables }} variables. Add as many as you need, then save once; a row left empty is not saved.</p>
                </details>
            </div>

            <div id="pane-tags" class="workspace-pane nested-toggle-pane" role="tabpanel" aria-labelledby="tab-tags" data-toggle-pane="tags" data-pane-name="tags" hidden>
                {% set tag_ids = existing_tag_ids %}
                <div data-pages--tag-manager--index-target="tagRows">
                {% for tag in rows %}
                    {{ component('TagManager:TagRow', {index: loop.index0, tag: tag, script_suggestions: suggest_tracker, custom_scripts_enabled: custom_scripts_enabled, custom_templates: custom_templates, tag_ids: tag_ids, tracker_namespaces: tracker_namespaces}) }}
                {% endfor %}
                </div>
                {# A blank tag the page copies for "Add another tag"; __INDEX__ becomes the next row number. #}
                <template data-pages--tag-manager--index-target="tagTemplate">{{ component('TagManager:TagRow', {index: '__INDEX__', tag: {id: '', src: '', type: 'script', enabled: true, consent: 'analytics', trigger: {type: 'dom_ready'}, is_new: true, added: true}, script_suggestions: suggest_tracker, custom_scripts_enabled: custom_scripts_enabled, custom_templates: custom_templates, tag_ids: tag_ids, tracker_namespaces: tracker_namespaces}) }}</template>
                <div class="buttons mb-2">
                    <button type="button" class="button" data-pages--tag-manager--index-target="addTagButton" data-action="pages--tag-manager--index#addTagRow"{% if rows|length >= max_tags %} disabled{% endif %}>
                        <span class="icon is-small"><i class="fas fa-plus" aria-hidden="true"></i></span>
                        <span>Add another tag</span>
                    </button>
                </div>
                <p class="help" role="status" aria-live="polite" data-pages--tag-manager--index-target="rowStatus"></p>
                {% if suggest_tracker %}<datalist id="tag-script-suggestions"><option value="{{ tracker_url }}">This website's tracker</option></datalist>{% endif %}
                <datalist id="tag-variable-aliases">{% for alias in variable_rows|map(row => row.alias|default(''))|filter(alias => alias != '') %}<option value="{{ alias }}"></option>{% endfor %}</datalist>
                {# Starter templates for custom JavaScript, read by the tag row editor. #}
                <script type="application/json" id="tag-custom-templates">{{ custom_templates_json|raw }}</script>
                <datalist id="tag-consent-categories"><option value="analytics">Analytics</option><option value="functional">Functional</option><option value="marketing">Marketing</option><option value="none">No consent required</option></datalist>
                <datalist id="tag-event-examples"><option value="click"></option><option value="submit"></option><option value="change"></option><option value="cart:updated"></option><option value="purchase"></option><option value="checkout_complete"></option></datalist>
                <p class="help mb-3">Up to {{ max_tags }} tags. Add as many as you need, then save once; a new tag left empty is not saved. Hosted scripts and downloaded tag loaders receive saved changes within five minutes; browsers reuse a script that long.</p>
            </div>

            <div id="pane-triggers" class="workspace-pane nested-toggle-pane" role="tabpanel" aria-labelledby="tab-triggers" data-toggle-pane="triggers" data-pane-name="triggers" hidden>
                <details class="box" open><summary class="has-text-weight-semibold">Trigger and event reference</summary><div class="table-container mt-3"><table class="table is-fullwidth"><thead><tr><th>Trigger</th><th>When it runs</th><th>Example</th></tr></thead><tbody>
                    <tr><td>Document ready</td><td>Once the HTML is ready and consent permits</td><td>No event name</td></tr>
                    <tr><td>Window finished loading</td><td>Once the page finishes loading and consent permits</td><td>No event name</td></tr>
                    <tr><td>Document event</td><td>A named event on the document, including events that bubble to it</td><td><code>click</code>, <code>submit</code>, <code>cart:updated</code></td></tr>
                    <tr><td>Window event</td><td>A named event dispatched on the window</td><td><code>account:updated</code></td></tr>
                    <tr><td>dataLayer event</td><td>A new <code>dataLayer.push({event: 'purchase'})</code> entry</td><td><code>purchase</code></td></tr>
                </tbody></table></div><p class="help">Custom names must be emitted by your website. Document/window events and dataLayer entries received before consent are not replayed. Script actions load once per page; method actions can run for each eligible event.</p></details>
            </div>
            <button class="button is-primary mt-3" type="submit">Save script settings</button>
        {% endblock %}
        {% endcomponent %}
    {% endif %}
</div>
{% endblock %}

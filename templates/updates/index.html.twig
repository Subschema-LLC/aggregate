{% extends 'base.html.twig' %}

{% block title %}Updates - {{ app_branding.name }}{% endblock %}

{% macro backup_confirmation(sqlite, id) %}
    {% if sqlite %}
        <p class="help mb-3">This installation uses SQLite; a database snapshot is saved automatically before migrations run.</p>
    {% else %}
        <div class="field">
            <label class="checkbox" for="{{ id }}">
                <input type="checkbox" id="{{ id }}" name="database_backup_confirmed" value="1" required>
                I have a current backup of the database. Migrations cannot be reversed automatically.
            </label>
        </div>
    {% endif %}
{% endmacro %}

{% macro disabled_button(label, reason_id) %}
    <button class="button is-primary" type="button" disabled aria-describedby="{{ reason_id }}">
        <span class="icon"><i class="fas fa-download" aria-hidden="true"></i></span>
        <span>{{ label }}</span>
    </button>
{% endmacro %}

{% macro method_form(selected, detected, busy, docs_url, id_prefix, submit_label) %}
    <form method="post" action="{{ path('app_updates_method') }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('application_updates_method') }}">
        <fieldset>
            <legend class="label">Update method</legend>
            <div class="field">
                <label class="radio is-block ml-0" for="{{ id_prefix }}-release">
                    <input type="radio" id="{{ id_prefix }}-release" name="updates_method" value="release" required{% if selected == 'release' %} checked{% endif %} aria-describedby="{{ id_prefix }}-release-help">
                    <strong>Release ZIP</strong>
                    <span class="tag is-success is-light ml-1">Recommended</span>
                </label>
                <p class="help ml-5" id="{{ id_prefix }}-release-help">Installs signed releases published on GitHub, downloaded by this page or uploaded from your computer. Each release is verified with this installation's trusted key and includes its dependencies and built assets, so the server needs no Git, Composer or Node.{% if detected == 'release' %} Fits this directory.{% endif %}</p>
            </div>
            <div class="field">
                <label class="radio is-block ml-0" for="{{ id_prefix }}-repository">
                    <input type="radio" id="{{ id_prefix }}-repository" name="updates_method" value="repository" required{% if selected == 'repository' %} checked{% endif %} aria-describedby="{{ id_prefix }}-repository-help {{ id_prefix }}-repository-warning">
                    <strong>From the repository</strong>
                    <span class="tag is-warning is-light ml-1">Advanced</span>
                </label>
                <p class="help ml-5" id="{{ id_prefix }}-repository-help">Pulls the newest commit of the configured branch into a Git clone of the repository, then installs dependencies with Composer and builds assets on this server.{% if detected == 'repository' %} Fits this directory: it is a Git clone.{% else %} This directory is not a Git clone, so it must be set up as one first.{% endif %}</p>
            </div>
            <div class="notification is-warning is-light" id="{{ id_prefix }}-repository-warning">
                <p><strong>The repository method is for advanced users.</strong> It installs whatever is on the branch, which is not a signed release, and it needs Git and Composer on the server. Local changes, a different branch or a failed Composer install stop an update, and you fix them on the server with Git. Choose it only if you manage this installation as a Git clone. <a href="{{ docs_url }}#choose-an-update-method">Compare the methods</a></p>
            </div>
        </fieldset>
        {% if busy %}
            <p class="help mb-2" id="{{ id_prefix }}-busy">The method cannot change while an update is running or needs attention.</p>
            <button class="button is-primary" type="button" disabled aria-describedby="{{ id_prefix }}-busy">{{ submit_label }}</button>
        {% else %}
            <button class="button is-primary" type="submit">{{ submit_label }}</button>
        {% endif %}
    </form>
{% endmacro %}

{% block body %}
    {% set is_release = update_status.installation_type|default('git') == 'release' %}
    {% set installed_branch = update_status.installed_branch ?? null %}
    {% set branch_matches = update_status.branch is not null and installed_branch == update_status.branch %}
    {% set can_pull = not is_release and branch_matches and update_status.state in ['available', 'up_to_date'] %}
    {% set statuses = {
        up_to_date: {label: 'Up to date', color: 'success'},
        available: {label: 'Update available', color: 'info'},
        ahead: {label: is_release ? 'Installed version is ahead' : 'Local checkout is ahead', color: 'warning'},
        diverged: {label: 'Local and remote history have diverged', color: 'warning'},
        unknown: {label: 'Update status unknown', color: 'warning'},
        error: {label: 'Update check failed', color: 'danger'},
        unavailable: {label: 'Update checking unavailable', color: 'warning'},
        incompatible: {label: 'Release requirements are not met', color: 'warning'}
    } %}
    {% set status = statuses[update_status.state]|default(statuses.unknown) %}
    {% set run = update_run ?? null %}
    {% set run_busy = run and (run.running or run.status in ['running', 'needs_attention']) %}
    {% set blocking_problems = update_blocking_problems|default([]) %}
    {% set can_install = update_status.state == 'available' and (is_release or can_pull) and not run_busy and blocking_problems is empty %}
    {% set upload_limit = update_upload_limit|default(0) %}
    {% set chosen_method = update_method|default(null) %}
    {% set detected_method = update_detected_method|default('release') %}
    {% set method_mismatch = chosen_method is not null and chosen_method != detected_method %}
    {% set docs_url = update_repository_url ~ '/blob/' ~ (update_status.branch ?? 'master')|url_encode ~ '/docs/UPDATES.md' %}
    {% set check_styles = {
        ok: {label: 'OK', color: 'success'},
        info: {label: 'Info', color: 'info'},
        warning: {label: 'Warning', color: 'warning'},
        error: {label: 'Problem', color: 'danger'}
    } %}
    {% set run_statuses = {
        running: {label: 'Update running', color: 'info'},
        completed: {label: 'Last update completed', color: 'success'},
        failed: {label: 'Last update stopped; nothing was left half-installed', color: 'warning'},
        needs_attention: {label: 'Last update needs attention', color: 'danger'},
        rolled_back: {label: 'Last update was rolled back', color: 'warning'}
    } %}
    {% set install_reason = '' %}
    {% if not can_install %}
        {% if run_busy %}
            {% set install_reason = run.running ? 'An update is running now. Reload this page to follow its progress.' : 'The last update needs attention. Resume it or roll it back on the server first; see Update progress below.' %}
        {% elseif blocking_problems is not empty %}
            {% set install_reason = 'The system check below found ' ~ (blocking_problems|length == 1 ? 'a problem that stops' : blocking_problems|length ~ ' problems that stop') ~ ' updates from the dashboard.' %}
        {% elseif update_status.state == 'up_to_date' %}
            {% set install_reason = 'This installation is up to date. The button becomes available when Check now finds a newer ' ~ (is_release ? 'release' : 'commit') ~ '.' %}
        {% elseif not is_release and update_status.current_commit and not branch_matches %}
            {% set install_reason = 'The installed branch does not match updates_branch, so there is no fast-forward update to install.' %}
        {% else %}
            {% set install_reason = 'There is no installable update right now (' ~ status.label|lower ~ '). The message above explains why; use Check now to look again.' %}
        {% endif %}
    {% endif %}

    <div class="level">
        <div class="level-left">
            <div>
                <h1 class="title">Application updates</h1>
                <p class="subtitle">
                    {%- if chosen_method == 'repository' %}This installation updates directly from the repository (advanced).
                    {%- elseif chosen_method == 'release' %}This installation updates with release ZIPs.
                    {%- else %}Choose how this installation updates.{% endif -%}
                </p>
            </div>
        </div>
        <div class="level-right">
            <a class="button" href="{{ path('app_dashboard') }}">
                <span class="icon"><i class="fas fa-arrow-left" aria-hidden="true"></i></span>
                <span>Dashboard</span>
            </a>
        </div>
    </div>

    {% if not chosen_method %}
        {% if update_status.state == 'error' %}
            <div class="notification is-danger is-light" role="status">
                <p class="has-text-weight-semibold">{{ status.label }}</p>
                <p>{{ update_status.message }}</p>
            </div>
        {% endif %}
        <details class="box update-panel" id="update-method" open>
            <summary>
                <span>
                    <span class="title is-4">Choose how this installation updates</span>
                    <span class="tag is-info is-light ml-2">Not chosen yet</span>
                </span>
            </summary>
            <p class="mb-4">Pick one update method. This page then shows only that method, and an administrator can switch under <strong>Update settings</strong> at any time. {{ detected_method == 'repository' ? 'This directory is a Git clone, so the repository method is selected below; release ZIPs need a new directory.' : 'This directory is not a Git clone, so Release ZIP is selected below.' }} Until a method is chosen, the command line uses the one that fits this directory.</p>
            {{ _self.method_form(detected_method, detected_method, run_busy, docs_url, 'choose-method', 'Use this method') }}
        </details>
    {% else %}
        <div class="notification is-{{ status.color }} is-light" role="status">
            <div class="is-flex is-justify-content-space-between is-align-items-center is-flex-wrap-wrap">
                <p class="has-text-weight-semibold">{{ status.label }}</p>
                <form method="post" action="{{ path('app_updates_refresh') }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('application_updates_refresh') }}">
                    <button class="button is-small" type="submit">
                        <span class="icon"><i class="fas fa-rotate" aria-hidden="true"></i></span>
                        <span>Check now</span>
                    </button>
                </form>
            </div>
            <p>{{ update_status.message }}</p>
            {% if update_status.compare_url %}
                <p class="mt-2"><a href="{{ update_status.compare_url }}">Review changes on GitHub</a></p>
            {% endif %}
            <p class="help mt-2">
                Last checked:
                {% if update_status.checked_at is not null %}
                    <time datetime="{{ update_status.checked_at|date('c', 'UTC') }}">{{ update_status.checked_at|date('Y-m-d H:i:s', 'UTC') }} UTC</time>.
                {% else %}
                    Not checked.
                {% endif %}
                Results are cached for one hour.
            </p>
        </div>

        {% if not is_release and update_status.current_commit and not branch_matches %}
            <div class="notification is-warning is-light">
                <p>The installed branch does not match <code>updates_branch</code>. Switch branches manually or correct <code>config/aggregate.yaml</code> before pulling an update.</p>
            </div>
        {% endif %}

        {% if chosen_method == 'repository' %}
            <details class="box update-panel" id="update-repository" open>
                <summary>
                    <span>
                        <span class="title is-4">From the repository</span>
                        <span class="tag is-warning is-light ml-2">Advanced</span>
                    </span>
                </summary>
                <div class="notification is-warning is-light">
                    <p><strong>Advanced option.</strong> Updates install the newest commit of <code>{{ update_status.branch ?? 'master' }}</code>, which is not a signed release, and run Git and Composer on this server. If an update stops because of local changes, a different branch or a dependency problem, you resolve it on the server. Release ZIPs are the recommended method; switch under <strong>Update settings</strong>. <a href="{{ docs_url }}#update-from-the-repository-advanced">Repository update guide</a></p>
                </div>
                {% if method_mismatch %}
                    <p class="mb-3" id="repository-unavailable">This directory is not a Git clone of <a href="{{ update_repository_url }}">{{ update_repository }}</a>, so there is nothing to pull. <a href="{{ docs_url }}#set-up-a-git-clone">Set it up as a Git clone</a>, or switch back to release ZIPs under <strong>Update settings</strong>.</p>
                    {{ _self.disabled_button('Install update', 'repository-unavailable') }}
                {% else %}
                    <p class="mb-3">Pulls the latest <code>{{ update_status.branch ?? 'master' }}</code> from <a href="{{ update_repository_url }}">{{ update_repository }}</a>, installs changed Composer dependencies and compiles dashboard assets, then runs database migrations and rebuilds the cache.</p>
                    <div class="table-container">
                        <table class="table is-fullwidth is-narrow">
                            <tbody>
                                <tr><th scope="row">Installed branch</th><td>{{ installed_branch ?? (update_status.current_commit ? 'Detached HEAD' : 'Unavailable') }}</td></tr>
                                <tr><th scope="row">Installed commit</th><td>{% if update_status.current_commit %}<code>{{ update_status.current_commit|slice(0, 12) }}</code>{% else %}Unavailable{% endif %}</td></tr>
                                <tr><th scope="row">Latest commit</th><td>{% if update_status.latest_commit %}<code>{{ update_status.latest_commit|slice(0, 12) }}</code>{% else %}Unavailable{% endif %}</td></tr>
                            </tbody>
                        </table>
                    </div>
                    {% if can_install %}
                        <form method="post" action="{{ path('app_updates_install') }}">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('application_updates_install') }}">
                            <input type="hidden" name="method" value="git">
                            {{ _self.backup_confirmation(update_database_sqlite, 'backup-confirmed-repository') }}
                            <button class="button is-primary" type="submit">
                                <span class="icon"><i class="fas fa-download" aria-hidden="true"></i></span>
                                <span>Install update</span>
                            </button>
                        </form>
                    {% else %}
                        <p class="mb-3" id="install-unavailable">{{ install_reason }}</p>
                        {{ _self.disabled_button('Install update', 'install-unavailable') }}
                    {% endif %}
                {% endif %}
            </details>
        {% else %}
            <details class="box update-panel" id="update-zip" open>
                <summary>
                    <span>
                        <span class="title is-4">With a release ZIP</span>
                        <span class="tag is-success is-light ml-2">Recommended</span>
                    </span>
                </summary>
                {% if method_mismatch %}
                    <p class="mb-3" id="zip-unavailable">This directory is a Git clone, and installing a ZIP over it would leave its files out of step with Git. <a href="{{ docs_url }}#switch-methods">Install a release into a new directory</a>, or switch back to repository updates under <strong>Update settings</strong>.</p>
                    {{ _self.disabled_button('Install update', 'zip-unavailable') }}
                {% else %}
                    <p class="mb-3">Installs a signed release in place after verifying it with this installation's trusted key. Release ZIPs include dependencies and built assets, so the server needs no Git, Composer or Node.</p>
                    <div class="table-container">
                        <table class="table is-fullwidth is-narrow">
                            <tbody>
                                <tr><th scope="row">Installed version</th><td>{{ update_status.current_version ?? (update_status.adopting|default(false) ? 'Unknown (no release.json)' : 'Unavailable') }}</td></tr>
                                <tr><th scope="row">Latest release</th><td>{% if update_status.release_url|default(null) %}<a href="{{ update_status.release_url }}">{{ update_status.latest_version ?? 'Unavailable' }}</a>{% else %}{{ update_status.latest_version ?? 'Unavailable' }}{% endif %}</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <h3 class="title is-6 mb-2">Download from GitHub</h3>
                    {% if can_install %}
                        <form method="post" action="{{ path('app_updates_install') }}" class="mb-5">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('application_updates_install') }}">
                            <input type="hidden" name="method" value="release">
                            {{ _self.backup_confirmation(update_database_sqlite, 'backup-confirmed-download') }}
                            <button class="button is-primary" type="submit">
                                <span class="icon"><i class="fas fa-download" aria-hidden="true"></i></span>
                                <span>Install update {{ update_status.latest_version }}</span>
                            </button>
                        </form>
                    {% else %}
                        <p class="mb-3" id="install-unavailable">{{ install_reason }}</p>
                        <div class="mb-5">{{ _self.disabled_button('Install update', 'install-unavailable') }}</div>
                    {% endif %}
                    <h3 class="title is-6 mb-2">Upload a release ZIP</h3>
                    <p class="mb-3">For servers that cannot reach GitHub: from the release page, download <code>aggregate-YYYY.MM.NN.zip</code>, <code>aggregate-release.json</code> and <code>aggregate-release.json.sig</code>, then select all three.{% if upload_limit > 0 and upload_limit < 67108864 %} This server accepts uploads up to {{ (upload_limit / 1048576)|round }} MB, and release ZIPs are about 25 MB; raise <code>upload_max_filesize</code> and <code>post_max_size</code> to upload one.{% endif %}</p>
                    {% if run_busy or blocking_problems is not empty %}
                        <p class="mb-3" id="upload-unavailable">{{ install_reason }}</p>
                        {{ _self.disabled_button('Upload and install', 'upload-unavailable') }}
                    {% else %}
                        <form method="post" action="{{ path('app_updates_upload') }}" enctype="multipart/form-data">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('application_updates_upload') }}">
                            <div class="field">
                                <label class="label" for="release-files">Release files</label>
                                <div class="control">
                                    <input class="input" id="release-files" type="file" name="release_files[]" accept=".zip,.json,.sig" multiple required>
                                </div>
                            </div>
                            {{ _self.backup_confirmation(update_database_sqlite, 'backup-confirmed-upload') }}
                            <button class="button" type="submit">
                                <span class="icon"><i class="fas fa-upload" aria-hidden="true"></i></span>
                                <span>Upload and install</span>
                            </button>
                        </form>
                    {% endif %}
                {% endif %}
            </details>
        {% endif %}
        <p class="help mb-5">Updates keep your configuration: <code>.env.local</code>, <code>config/aggregate.yaml</code>, <code>config/websites.yaml</code>, site tag settings, <code>config/*.local.yaml</code> overrides and everything in <code>var/</code>. Edits to the shipped <code>goals.yaml</code>, <code>navigation.yaml</code> or <code>quick_search.yaml</code> move to their <code>.local.yaml</code> override. Visitors and the collection API receive a maintenance response while files are replaced, and changed files are backed up for rollback.</p>
    {% endif %}

    <details class="box update-panel" id="system-check"{% if blocking_problems is not empty %} open{% endif %}>
        <summary>
            <span>
                <span class="title is-4">System check</span>
                {% if blocking_problems is empty %}
                    <span class="tag is-success is-light ml-2">Ready</span>
                {% else %}
                    <span class="tag is-danger is-light ml-2">{{ blocking_problems|length }} {{ blocking_problems|length == 1 ? 'problem' : 'problems' }}</span>
                {% endif %}
            </span>
        </summary>
        <p class="mb-3">
            {% if blocking_problems is empty %}
                Nothing here stops updates from the dashboard.
            {% else %}
                {{ blocking_problems|length == 1 ? 'One problem stops' : blocking_problems|length ~ ' problems stop' }} updates from the dashboard.
            {% endif %}
            These checks run as the web server user. Run <code>php bin/console app:updates:apply --preflight</code> to check as the user who runs updates on the server.
        </p>
        <div class="table-container">
            <table class="table is-fullwidth">
                <thead>
                    <tr><th scope="col">Status</th><th scope="col">Check</th><th scope="col">Details</th></tr>
                </thead>
                <tbody>
                    {% for check in update_checks|default([]) %}
                        {% set style = check_styles[check.status]|default(check_styles.info) %}
                        <tr>
                            <td><span class="tag is-{{ style.color }} is-light">{{ style.label }}</span></td>
                            <th scope="row">{{ check.label }}{% if check.scope == 'dashboard' %} <span class="has-text-grey has-text-weight-normal">(dashboard)</span>{% endif %}</th>
                            <td>{{ check.detail }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </details>

    {% if run %}
        {% set run_status = run_statuses[run.running ? 'running' : run.status]|default(run_statuses.running) %}
        <details class="box update-panel" id="update-progress"{% if run_busy or run.status == 'failed' %} open{% endif %}>
            <summary>
                <span>
                    <span class="title is-4">Update progress</span>
                    <span class="tag is-{{ run_status.color }} is-light ml-2">{{ run_status.label }}</span>
                </span>
            </summary>
            <div class="notification is-{{ run_status.color }} is-light" role="status">
                <p class="has-text-weight-semibold">{{ run_status.label }}</p>
                <p>
                    {{ run.type == 'release' ? 'Release' : 'Git' }} update {{ run.id }}
                    {%- if run.to.version|default(null) %} to version {{ run.to.version }}{% elseif run.to.commit|default(null) %} to commit <code>{{ run.to.commit|slice(0, 12) }}</code>{% endif %}
                    {%- if run.step and run.status != 'completed' %}, step: {{ run.step|replace({'_': ' '}) }}{% endif %}.
                </p>
                {% if run.error %}<p class="mt-2">{{ run.error }}</p>{% endif %}
                {% if run.running %}<p class="mt-2"><a href="{{ path('app_updates') }}">Reload</a> to follow progress. Visitors see a maintenance page while files are replaced.</p>{% endif %}
            </div>
            {% if run.status == 'needs_attention' and not run.running %}
                <p class="mb-3">The site stays in maintenance mode until this is resolved on the server. After fixing the cause, continue the update or restore the previous files:</p>
                <pre><code>php bin/console app:updates:apply --resume
php bin/console app:updates:rollback</code></pre>
            {% endif %}
            {% set run_files = run.report.files|default({}) %}
            {% if run_files.overrides_created|default([]) is not empty and run.status != 'rolled_back' %}
                <p class="mt-3">Your edits to shipped configuration were moved to {% for override in run_files.overrides_created %}<code>{{ override }}</code>{{ loop.last ? '' : ', ' }}{% endfor %}. Each override replaces the matching shipped setting as a whole; compare it with the new default for entries added by the update.</p>
            {% endif %}
            {% if run.log|default([]) is not empty %}
                <details class="mt-3">
                    <summary class="is-clickable">Update log</summary>
                    <pre class="mt-2">{% for entry in run.log|slice(-12) %}{{ entry.at|date('H:i:s', 'UTC') }}  {{ entry.message }}
{% endfor %}</pre>
                </details>
            {% endif %}
        </details>
    {% endif %}

    <details class="box update-panel" id="update-settings"{% if method_mismatch %} open{% endif %}>
        <summary><span class="title is-4">Update settings</span></summary>
        {% if chosen_method %}
            <h3 class="title is-5 mb-2">Switch update method</h3>
            <p class="mb-3">This installation updates {{ chosen_method == 'repository' ? 'directly from the repository (advanced)' : 'with release ZIPs' }}. Switching changes which method this page shows and which one <code>app:updates:apply</code> uses. It does not change any files; see <a href="{{ docs_url }}#switch-methods">switching methods</a> for what else each one needs.</p>
            <div class="mb-5">
                {{ _self.method_form(chosen_method, detected_method, run_busy, docs_url, 'switch-method', 'Save update method') }}
            </div>
            <hr>
        {% endif %}
        <form method="post" action="{{ path('app_updates_settings') }}" class="mb-4">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('application_updates_settings') }}">
            <label class="label" for="updates-branch">Branch</label>
            <div class="field has-addons mb-1">
                <div class="control is-expanded">
                    <input class="input" id="updates-branch" name="updates_branch" type="text" required maxlength="255" value="{{ update_status.branch ?? 'master' }}" autocomplete="off" spellcheck="false" aria-describedby="updates-branch-help">
                </div>
                <div class="control">
                    <button class="button" type="submit">Save</button>
                </div>
            </div>
            <p class="help" id="updates-branch-help">The branch Git pulls, and the branch release ZIPs must be published from. The default is <code>master</code>.</p>
        </form>
        <p class="mb-2">The same settings in <code>config/aggregate.yaml</code>, for headless installations:</p>
        {% set method_line = chosen_method ? 'updates_method: ' ~ chosen_method ~ '   # release (recommended) or repository (advanced)' : '# updates_method: release   # not chosen yet: release (recommended) or repository (advanced)' %}
        <pre><code>{{ method_line }}
updates_branch: {{ update_status.branch ?? 'master' }}
updates_repository: {{ update_repository }}   # GitHub owner/name; YAML only</code></pre>
        <p class="help">{% if not update_official_repository|default(true) %}This installation does not use the official repository. {% endif %}An optional <code>AGGREGATE_GITHUB_TOKEN</code> in the server environment raises the GitHub API rate limit; the public repository needs no token.</p>
    </details>

    <details class="box update-panel" id="installed-application">
        <summary><span class="title is-4">Installed application</span></summary>
        <div class="table-container">
            <table class="table is-fullwidth">
                <tbody>
                    <tr>
                        <th scope="row">Repository</th>
                        <td><a href="{{ update_repository_url }}">{{ update_repository }}</a></td>
                    </tr>
                    <tr>
                        <th scope="row">Installation</th>
                        <td>{{ detected_method == 'repository' ? 'Git clone' : 'Release package or copied files (no .git folder)' }}</td>
                    </tr>
                    <tr>
                        <th scope="row">Configured branch</th>
                        <td>{{ update_status.branch ?? 'Unavailable' }}</td>
                    </tr>
                    {% if is_release %}
                        <tr>
                            <th scope="row">Installed version</th>
                            <td>{{ update_status.current_version ?? (update_status.adopting|default(false) ? 'Unknown (no release.json)' : 'Unavailable') }}</td>
                        </tr>
                        <tr>
                            <th scope="row">Latest release version</th>
                            <td>{{ update_status.latest_version ?? 'Unavailable' }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <th scope="row">Installed branch</th>
                            <td>{{ installed_branch ?? (update_status.current_commit ? 'Detached HEAD' : 'Unavailable') }}</td>
                        </tr>
                    {% endif %}
                    <tr>
                        <th scope="row">Installed revision</th>
                        <td>{% if update_status.current_commit %}<code>{{ update_status.current_commit }}</code>{% else %}Unavailable{% endif %}</td>
                    </tr>
                    <tr>
                        <th scope="row">Latest remote revision</th>
                        <td>{% if update_status.latest_commit %}<code>{{ update_status.latest_commit }}</code>{% else %}Unavailable{% endif %}</td>
                    </tr>
                </tbody>
            </table>
        </div>
        {% if is_release and update_status.package_url|default(null) %}
            <div class="content">
                <p>Release files:</p>
                <ul>
                    <li><a href="{{ update_status.package_url }}">Release package</a></li>
                    {% if update_status.manifest_url|default(null) %}<li><a href="{{ update_status.manifest_url }}">Release manifest</a></li>{% endif %}
                    {% if update_status.signature_url|default(null) %}<li><a href="{{ update_status.signature_url }}">Manifest signature</a></li>{% endif %}
                </ul>
                <p>The status check does not verify signatures; installing does. To verify downloaded files yourself, run <code>php bin/console app:updates:verify-package PACKAGE MANIFEST SIGNATURE</code>.</p>
            </div>
        {% endif %}
    </details>

    <details class="box content update-panel" id="command-line">
        <summary><span class="title is-4">Command line</span></summary>
        <p>The same updates run from the application directory on the server, including with the dashboard disabled. Run them as the user that owns the application files:</p>
        <pre><code>php bin/console app:updates:method              # show the update method
php bin/console app:updates:method release      # or: repository (advanced)
php bin/console app:updates:check --refresh
php bin/console app:updates:apply --preflight
php bin/console app:updates:apply</code></pre>
        {% if is_release %}
            <p>To install release files you downloaded yourself:</p>
            <pre><code>php bin/console app:updates:apply --package=aggregate-YYYY.MM.NN.zip --manifest=aggregate-release.json --signature=aggregate-release.json.sig</code></pre>
        {% endif %}
        <p>For PostgreSQL, MySQL, MariaDB or SQL Server, back up the database first and add <code>--database-backup-confirmed</code>. If a step fails after files change, the site stays in maintenance mode; continue with <code>--resume</code> or restore the previous files with <code>php bin/console app:updates:rollback</code>. Rolling back files does not reverse database migrations. See the <a href="{{ docs_url }}">update guide</a>.</p>
    </details>
{% endblock %}

{#
    Keep the UI usable if a deployment serves freshly compiled templates before
    its container has registered AppBrandingExtension. The explicit global test
    still makes that deployment error fail CI instead of masking it.
#}
{% set app_branding_defaults = {
    name: 'Aggregate Analytics',
    logo_text: 'Aggregate Analytics',
    has_logo: false,
    logo_version: null,
    name_overridden: false,
    logo_text_overridden: false,
    logo_path_overridden: false,
    theme: {
        color_scheme: 'light',
        primary_color: '#00D1B2',
        primary_contrast_color: '#000000',
        primary_text_color: '#363636',
        accent_color: '#485FC7',
        accent_contrast_color: '#FFFFFF',
        accent_text_color: '#485FC7',
        focus_color: '#485FC7',
        navbar_color: '#14161A',
        navbar_contrast_color: '#FFFFFF',
        background_color: '#F5F5F5',
        surface_color: '#FFFFFF',
        text_color: '#363636',
        font_family: 'system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif',
        heading_font_family: 'system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif',
        font_family_css: 'system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
        heading_font_family_css: 'system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
        contrast_fallback: false,
        primary_color_overridden: false,
        accent_color_overridden: false,
        navbar_color_overridden: false,
        background_color_overridden: false,
        surface_color_overridden: false,
        text_color_overridden: false,
        font_family_overridden: false,
        heading_font_family_overridden: false,
        all_overridden: false
    }
} %}
{% set app_branding = app_branding_defaults|merge(app_branding|default({})) %}
{% set app_branding = app_branding|merge({
    theme: app_branding_defaults.theme|merge(app_branding.theme|default({}))
}) %}
<!DOCTYPE html>
<html lang="en" data-theme="{{ app_branding.theme.color_scheme }}" data-theme-default="{{ app_branding.theme.color_scheme }}" data-theme-storage-key="aggregate.ui.theme">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ app_branding.name }}{% endblock %}</title>
    {% set csp_nonce = app is defined and app.request is defined and app.request ? app.request.attributes.get('csp_nonce', '') : (csp_nonce|default('')) %}
    {# Apply a saved preference before styles paint; interaction belongs to ThemeToggle. #}
    <script src="{{ asset('theme-preference.js') }}"{% if csp_nonce %} nonce="{{ csp_nonce }}"{% endif %}></script>
    <link rel="stylesheet" href="{{ asset('styles/vendor/bulma/bulma.min.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    <link rel="stylesheet" href="{{ path('app_branding_theme') }}">
    {% block stylesheets %}{% endblock %}
    {% block javascripts %}{{ importmap('app', csp_nonce ? {nonce: csp_nonce} : {}) }}{% endblock %}
</head>
<body>

    {% include 'partials/navigation/navigation.html.twig' %}

    <section class="section">
        <div class="container" data-controller="components--ui--cards" data-action="invalid->components--ui--cards#revealInvalid:capture">
            {% for message in app.flashes('success') %}
                {{ component('Ui:Notification', {message: message, type: 'success'}) }}
            {% endfor %}

            {% for message in app.flashes('warning') %}
                {{ component('Ui:Notification', {message: message, type: 'warning'}) }}
            {% endfor %}

            {% for message in app.flashes('error') %}
                {{ component('Ui:Notification', {message: message, type: 'danger'}) }}
            {% endfor %}

            {% if app.user is defined and app.user and main_navigation is defined and app.request is defined and app.request %}
                {% set current_path = app.request.pathInfo %}
                {% set nav_menu = navigation_menu(main_navigation) %}
                {% set top_site_tabs = nav_menu.items|default([])|filter(item => item.children is not defined and item.enabled|default(false) and item.url|default('') in ['/dashboard', '/dashboard/website-groups']) %}
                {% if current_path in ['/dashboard', '/dashboard/website-groups'] and top_site_tabs|length > 1 %}
                    {{ component('Ui:SectionTabs', {
                        label: 'Website management pages',
                        current: current_path,
                        items: top_site_tabs
                    }) }}
                {% endif %}
                {% for group in nav_menu.items|default([]) %}
                    {% if group.children is defined %}
                        {% set internal_children = group.children|filter(c => c.enabled and not c.external|default(false) and c.url) %}
                        {% set matches_group = internal_children|filter(c => c.url == current_path)|length > 0 %}
                        {% if matches_group and internal_children|length > 1 %}
                            {{ component('Ui:SectionTabs', {
                                label: group.label ~ ' pages',
                                current: current_path,
                                items: internal_children
                            }) }}
                        {% endif %}
                    {% endif %}
                {% endfor %}
            {% endif %}

            {% block card_controls %}
                {% if not (app.request.pathInfo starts with '/login') %}
                    {{ component('Ui:CardControls') }}
                {% endif %}
            {% endblock %}

            {# On a page the user can only view, forms that save are turned off and the server refuses changes. #}
            {% set page_access = app.user is defined and app.user ? dashboard_page_access() : null %}
            {% if page_access and page_access.level == 'view' %}
                <div class="notification is-info is-light view-only-notice" role="status">
                    <span class="icon-text">
                        <span class="icon"><i class="fas fa-eye" aria-hidden="true"></i></span>
                        <span>You have view-only access to {{ page_access.label }}. Ask an administrator if you need to make changes.</span>
                    </span>
                </div>
                <div data-controller="components--layout--view-only">
                    {% block body %}{% endblock %}
                </div>
            {% else %}
                {{ block('body') }}
            {% endif %}
        </div>
    </section>

    {% include 'partials/footer/footer.html.twig' %}

</body>
</html>

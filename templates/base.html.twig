{#
    Keep the UI usable if a deployment serves freshly compiled templates before
    its container has registered AppBrandingExtension. The explicit global test
    still makes that deployment error fail CI instead of masking it.
#}
{% set app_branding_defaults = {
    name: 'Aggregate Analytics',
    logo_text: 'Aggregate Analytics',
    has_logo: false,
    logo_version: null,
    name_overridden: false,
    logo_text_overridden: false,
    logo_path_overridden: false,
    theme: {
        primary_color: '#00D1B2',
        primary_contrast_color: '#000000',
        primary_text_color: '#363636',
        accent_color: '#485FC7',
        accent_contrast_color: '#FFFFFF',
        accent_text_color: '#485FC7',
        focus_color: '#485FC7',
        navbar_color: '#14161A',
        navbar_contrast_color: '#FFFFFF',
        background_color: '#F5F5F5',
        surface_color: '#FFFFFF',
        text_color: '#363636',
        font_family: 'system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif',
        heading_font_family: 'system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif',
        font_family_css: 'system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
        heading_font_family_css: 'system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
        contrast_fallback: false,
        primary_color_overridden: false,
        accent_color_overridden: false,
        navbar_color_overridden: false,
        background_color_overridden: false,
        surface_color_overridden: false,
        text_color_overridden: false,
        font_family_overridden: false,
        heading_font_family_overridden: false,
        all_overridden: false
    }
} %}
{% set app_branding = app_branding_defaults|merge(app_branding|default({})) %}
{% set app_branding = app_branding|merge({
    theme: app_branding_defaults.theme|merge(app_branding.theme|default({}))
}) %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ app_branding.name }}{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@1.0.2/css/bulma.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        {% include 'branding/theme.css.twig' %}
        {% include 'navigation/style.css.twig' %}

        .app-branding-identity {
            align-items: center;
            display: inline-flex;
            gap: 0.5rem;
        }

        .app-branding-logo {
            height: auto;
            max-height: 2rem;
            max-width: 10rem;
            object-fit: contain;
            width: auto;
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
    {% if app.user %}
        {% include 'navigation/main.html.twig' %}
    {% else %}
        <nav class="navbar is-dark" role="navigation" aria-label="public navigation">
            <div class="navbar-brand">
                <a class="navbar-item" href="{{ path('app_home') }}">
                    {% include 'branding/identity.html.twig' %}
                </a>
            </div>
        </nav>
    {% endif %}

    <section class="section">
        <div class="container">
            {% for message in app.flashes('success') %}
                <div class="notification is-success is-light" role="status">
                    <button type="button" class="delete" aria-label="Dismiss notification"></button>
                    {{ message }}
                </div>
            {% endfor %}

            {% for message in app.flashes('warning') %}
                <div class="notification is-warning is-light" role="status">
                    <button type="button" class="delete" aria-label="Dismiss notification"></button>
                    {{ message }}
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="notification is-danger is-light" role="alert">
                    <button type="button" class="delete" aria-label="Dismiss notification"></button>
                    {{ message }}
                </div>
            {% endfor %}

            {% block body %}{% endblock %}
        </div>
    </section>

    {% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            (document.querySelectorAll('.notification .delete') || []).forEach(($delete) => {
                const $notification = $delete.parentNode;
                $delete.addEventListener('click', () => {
                    $notification.parentNode.removeChild($notification);
                });
            });
        });
    </script>
    {% endblock %}
</body>
</html>

{% extends 'base.html.twig' %}

{% block title %}Configuration Error{% endblock %}

{% block body %}
<div class="columns is-centered">
    <div class="column is-6">
        <div class="box">
            <h1 class="title has-text-danger">
                <span class="icon-text">
                    <span class="icon">
                        <i class="fas fa-exclamation-triangle"></i>
                    </span>
                    <span>Configuration Error</span>
                </span>
            </h1>

            <div class="content">
                <p>The application cannot start because required configuration is missing.</p>

                <h2 class="subtitle">Errors:</h2>
                <ul>
                    {% for error in errors %}
                        <li class="has-text-danger">{{ error }}</li>
                    {% endfor %}
                </ul>

                <h2 class="subtitle mt-5">To fix this:</h2>
                <ol>
                    <li>Create a <code>.env</code> file in the project root with at minimum:
                        <pre class="mt-2"><code>APP_ENV=prod
APP_SECRET=your-secret-here
DATABASE_URL="mysql://user:pass@localhost:3306/dbname?serverVersion=8.0"
MESSENGER_TRANSPORT_DSN=doctrine://default</code></pre>
                    </li>
                    <li>Generate <code>APP_SECRET</code> with: <code>openssl rand -hex 32</code></li>
                    <li>Refresh this page</li>
                </ol>
            </div>

            <div class="buttons mt-5">
                <a href="{{ path('app_install') }}" class="button is-primary">
                    <span class="icon"><i class="fas fa-sync"></i></span>
                    <span>Retry</span>
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Install Aggregate Analytics{% endblock %}

{% block body %}
<div class="columns is-centered">
    <div class="column is-6">
        <div class="box">
            <h1 class="title has-text-primary">
                <span class="icon-text">
                    <span class="icon">
                        <i class="fas fa-download"></i>
                    </span>
                    <span>Install Aggregate Analytics</span>
                </span>
            </h1>

            {% for message in app.flashes('error') %}
                <div class="notification is-danger is-light">{{ message }}</div>
            {% endfor %}

            <div class="content">
                <p>Welcome! Create your admin account to complete the setup.</p>
                <div class="notification is-info is-light">
                    <p><strong>What will happen:</strong></p>
                    <ul>
                        <li>Database migrations will be run automatically</li>
                        <li>Anonymous-mode events will use sanitized dimensions and server-generated UTC hour buckets</li>
                        <li>Your admin account will be created</li>
                        <li>Worker setup is optional and only needed for async ingestion mode</li>
                    </ul>
                </div>
            </div>

            <form action="{{ path('app_install_execute') }}" method="post">
                <div class="field">
                    <label class="label">Admin Username</label>
                    <div class="control has-icons-left">
                        <input class="input" type="text" name="admin_username" placeholder="admin" required autofocus>
                        <span class="icon is-left"><i class="fas fa-user"></i></span>
                    </div>
                </div>

                <div class="field">
                    <label class="label">Admin Password</label>
                    <div class="control has-icons-left">
                        <input class="input" type="password" name="admin_password" placeholder="Minimum 8 characters" required minlength="8">
                        <span class="icon is-left"><i class="fas fa-lock"></i></span>
                    </div>
                    <p class="help">Choose a strong password. You can add more users later from Dashboard Settings.</p>
                </div>

                <div class="field">
                    <label class="label">JS Namespace</label>
                    <div class="control has-icons-left">
                        <input class="input" type="text" name="js_namespace" placeholder="Aggregate" value="Aggregate">
                        <span class="icon is-left"><i class="fas fa-code"></i></span>
                    </div>
                    <p class="help">The global variable name on tracked sites: <code>window.Aggregate</code></p>
                </div>

                <div class="field mt-5">
                    <div class="control">
                        <button type="submit" class="button is-primary is-fullwidth is-medium">
                            <span class="icon"><i class="fas fa-rocket"></i></span>
                            <span>Install Now</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% import 'email_settings/_macros.html.twig' as help %}
<div class="columns is-multiline">
    <div class="column is-half field">
        <label class="label" for="email-smtp-host">Host</label>
        <div class="control"><input class="input" id="email-smtp-host" name="email_smtp_host" type="text" maxlength="253" value="{{ settings.email_smtp_host }}" placeholder="smtp.example.com"{% if overrides.email_smtp_host %} disabled{% endif %}></div>
        {{ help.env_help(overrides, 'email_smtp_host') }}
    </div>
    <div class="column is-half field">
        <label class="label" for="email-smtp-port">Port</label>
        <div class="control"><input class="input" id="email-smtp-port" name="email_smtp_port" type="number" min="1" max="65535" step="1" value="{{ settings.email_smtp_port }}"{% if overrides.email_smtp_port %} disabled{% endif %}></div>
        {{ help.env_help(overrides, 'email_smtp_port') }}
    </div>
    <div class="column is-half field">
        <label class="label" for="email-smtp-username">Username</label>
        <div class="control"><input class="input" id="email-smtp-username" name="email_smtp_username" type="text" maxlength="255" value="{{ settings.email_smtp_username }}" placeholder="Optional"{% if overrides.email_smtp_username %} disabled{% endif %}></div>
        {{ help.env_help(overrides, 'email_smtp_username') }}
    </div>
    <div class="column is-half field">
        <label class="label" for="email-smtp-encryption">Encryption</label>
        <div class="control">
            <div class="select is-fullwidth">
                <select id="email-smtp-encryption" name="email_smtp_encryption"{% if overrides.email_smtp_encryption %} disabled{% endif %}>
                    {% for value, label in constant('App\\Service\\Email\\Provider\\SmtpProvider::ENCRYPTION') %}
                        <option value="{{ value }}"{% if settings.email_smtp_encryption == value %} selected{% endif %}>{{ label }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>
        {{ help.env_help(overrides, 'email_smtp_encryption') }}
    </div>
</div>

{% extends 'base.html.twig' %}

{% block title %}{{ example_source == 'ecommerce' ? 'Ecommerce examples' : 'Event examples' }} - {{ app_branding.name }}{% endblock %}

{% block body %}
<div class="event-examples-page">
    <h1 class="title">{{ example_source == 'ecommerce' ? 'Ecommerce examples' : 'Event examples' }}</h1>
    <p class="subtitle">{% if example_source == 'ecommerce' %}A flat ecommerce starting point with typed properties and money in minor units. This recipe does not change your saved model.{% else %}Synthetic request JSON from the saved data model. No events are read or sent.{% endif %}</p>
    {{ component('DataModel:Navigation', {current_model_page: 'app_event_examples'}) }}
    <div class="buttons">
        <a class="button" href="{{ path('app_event_examples') }}"{% if example_source == 'model' %} aria-current="page"{% endif %}>Saved model examples</a>
        <a class="button" href="{{ path('app_event_examples_ecommerce') }}"{% if example_source == 'ecommerce' %} aria-current="page"{% endif %}>Ecommerce recipe</a>
    </div>

    {% if bundle is null %}
        <div class="notification is-danger" role="alert">Saved event examples are unavailable. Correct the active data model configuration and try again.</div>
    {% else %}
        <div class="notification is-info">
            Replace the website token placeholder with a registered website's public ingestion token. Enhanced collection requires an actual consent choice; copying the example does not obtain consent.
        </div>
        <p class="mb-4"><a class="button is-primary" href="{{ path('app_event_examples_download', {example: example_source}) }}">Download examples and consent rules</a></p>
        {% if recommended_model_yaml %}
            <div class="notification is-warning">Review and merge the recommended property definitions into your existing model before using this recipe. Do not replace unrelated model settings. Ecommerce properties require enhanced consent by default.</div>
        {% endif %}

        {% set example_modes = example_source == 'ecommerce' ? ['enhanced', 'anonymous'] : ['anonymous', 'enhanced'] %}
        {% for mode in example_modes %}
            {% set purchase_example = example_source == 'ecommerce' and mode == 'enhanced' %}
            <details class="box"{% if loop.first %} open{% endif %}>
                <summary class="title is-4">{% if purchase_example %}Ecommerce purchase JSON{% else %}{{ mode == 'anonymous' ? 'Anonymous collection JSON' : 'Enhanced collection JSON' }}{% endif %}</summary>
                <p class="mb-3">
                    {% if purchase_example %}
                        A complete purchase request body for <code>POST /api/receive</code>, to submit only after explicit analytics consent.
                        Visitor and session identifiers are fixed synthetic examples; copying <code>"granted"</code> does not obtain consent.
                    {% elseif mode == 'anonymous' %}
                        {% if example_source == 'ecommerce' %}
                            This recipe's ecommerce properties require enhanced consent, so <code>eventData</code> is empty without consent.
                        {% else %}
                            Includes only modeled properties allowed without enhanced consent.
                        {% endif %}
                        The server generates the UTC hour; there are no visitor or session identifiers.
                    {% else %}
                        Includes modeled properties that can be submitted after explicit consent.
                        Visitor and session identifiers shown here are fixed synthetic examples.
                    {% endif %}
                </p>
                <pre tabindex="0" aria-label="{{ purchase_example ? 'Ecommerce purchase request JSON' : mode|capitalize ~ ' request JSON' }}"><code id="example-{{ mode }}">{{ payloads[mode] }}</code></pre>
                <div class="buttons mt-3">
                    {{ component('Ui:CopyButton', {
                        target: 'example-' ~ mode,
                        status: 'example-copy-status',
                        label: 'Copy ' ~ (purchase_example ? 'purchase' : mode) ~ ' JSON',
                        success: 'JSON copied.',
                        fallback: 'Automatic copying is unavailable. Use your browser’s Copy command to copy the selected JSON.',
                        class: 'button',
                        'data-copy-example': 'example-' ~ mode
                    }) }}
                    <a class="button is-light" href="{{ path('app_event_examples_download', {mode: mode, example: example_source}) }}">Download {{ purchase_example ? 'purchase' : mode }} example and rules</a>
                </div>
            </details>
        {% endfor %}
        <p id="example-copy-status" class="help mb-4" role="status" aria-live="polite"></p>

        {% if recommended_model_yaml %}
            <details class="box">
                <summary class="title is-4">Recommended ecommerce model (YAML)</summary>
                <p class="mb-3">Money is stored in integer minor units. For USD, <code>4999</code> means $49.99. The currency determines its minor unit. Keep currencies separate in calculations; Float and Double are approximate numbers.</p>
                <pre tabindex="0" aria-label="Recommended ecommerce YAML"><code id="ecommerce-model-yaml">{{ recommended_model_yaml }}</code></pre>
                {{ component('Ui:CopyButton', {
                    target: 'ecommerce-model-yaml',
                    status: 'example-copy-status',
                    label: 'Copy recommended YAML',
                    success: 'YAML copied.',
                    fallback: 'Automatic copying is unavailable. Use your browser’s Copy command to copy the selected YAML.',
                    class: 'button mt-3',
                    'data-copy-example': 'ecommerce-model-yaml',
                    'data-copy-format': 'YAML'
                }) }}
            </details>
        {% endif %}

        <details class="box">
            <summary class="title is-4">{{ example_source == 'ecommerce' ? 'Recommended property rules' : 'Saved property rules' }} ({{ bundle.properties|length }})</summary>
            {% if bundle.properties %}
                <div class="table-container"><table class="table is-fullwidth">
                    <thead><tr><th>JSON key</th><th>Value type</th><th>Where it can be submitted</th><th>Mapped URL parameters</th></tr></thead>
                    <tbody>{% for property in bundle.properties %}
                        <tr>
                            <td><code>{{ property.key }}</code></td>
                            <td>{{ property.type|default('scalar') }}</td>
                            <td>{% if property.collection == 'anonymous_and_enhanced' %}Anonymous and enhanced{% elseif property.collection == 'enhanced_only' %}Enhanced consent required{% else %}Reserved marker or reporting-only key; omitted from request properties{% endif %}</td>
                            <td>{{ property.query_parameters ? property.query_parameters|join(', ') : 'None' }}</td>
                        </tr>
                    {% endfor %}</tbody>
                </table></div>
            {% else %}<p>The saved model defines no custom properties. The request examples use an empty JSON object for event data.</p>{% endif %}
        </details>

        <details class="box">
            <summary class="title is-4">Using these examples</summary>
            <div class="content"><ul>{% for note in bundle.notes %}<li>{{ note }}</li>{% endfor %}</ul></div>
            <p>For a headless export, run <code>php bin/console app:analytics:examples{% if example_source == 'ecommerce' %} --example=ecommerce{% endif %}</code>. Add <code>--mode=anonymous</code> or <code>--mode=enhanced</code> to select one example.</p>
        </details>
    {% endif %}
</div>
{% endblock %}

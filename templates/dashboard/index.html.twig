{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<h1 class="title">Dashboard</h1>
<h2 class="subtitle">Welcome, {{ app.user.username }}!</h2>

<div class="box">
    <div class="level">
        <div class="level-left">
            <div class="level-item">
                <h3 class="title is-4">
                    <span class="icon-text">
                        <span class="icon">
                            <i class="fas fa-globe"></i>
                        </span>
                        <span>Your Websites</span>
                    </span>
                </h3>
            </div>
        </div>
        <div class="level-right">
            <div class="level-item">
                <button class="button is-primary js-modal-trigger" data-target="add-website-modal">
                    <span class="icon">
                        <i class="fas fa-plus"></i>
                    </span>
                    <span>Add Website</span>
                </button>
            </div>
        </div>
    </div>

    {% if websites is empty %}
        <div class="notification is-info is-light">
            <p>You haven't added any websites yet.</p>
            <p class="mt-3">Click the "Add Website" button above to create your first website.</p>
        </div>
    {% endif %}
    <div class="tabs is-boxed">
        <ul>
            {% for website in websites %}
                <li {% if loop.first %}class="is-active"{% endif %} data-tab="website-{{ loop.index }}">
                    <a>
                        <span class="icon is-small"><i class="fas fa-globe"></i></span>
                        <span>{{ website.name }}</span>
                    </a>
                </li>
            {% endfor %}
            <li {% if websites is empty %}class="is-active"{% endif %} data-tab="settings">
                <a>
                    <span class="icon is-small"><i class="fas fa-cog"></i></span>
                    <span>Settings</span>
                </a>
            </li>
        </ul>
    </div>

        {% for website in websites %}
            <div class="tab-content {% if not loop.first %}is-hidden{% endif %}" id="website-{{ loop.index }}">
                <div class="content">
                    <h4 class="title is-5">{{ website.name }}</h4>
                    <p><strong>Domain:</strong> <code>{{ website.domain }}</code></p>
                    <p><strong>Website Token:</strong> <code>{{ website.token }}</code></p>

                    <h5 class="title is-6 mt-5">
                        <span class="icon-text">
                            <span class="icon">
                                <i class="fas fa-code"></i>
                            </span>
                            <span>Integration Code</span>
                        </span>
                    </h5>

                    <div class="notification is-light">
                        <p class="mb-3">Add this code to your website's <code>&lt;head&gt;</code> section:</p>
                        <pre><code>&lt;script&gt;
  window.{{ js_namespace }} = {
    endpoint: '{{ app_host }}/api/receive',
    websiteToken: '{{ website.token }}'
  };
&lt;/script&gt;
&lt;script src="{{ app_host }}/aggregate.js" defer&gt;&lt;/script&gt;</code></pre>
                        <button class="button is-small is-info mt-3 copy-btn" data-clipboard-target="#code-{{ loop.index }}">
                            <span class="icon">
                                <i class="fas fa-copy"></i>
                            </span>
                            <span>Copy to Clipboard</span>
                        </button>
                        <textarea id="code-{{ loop.index }}" class="is-hidden">&lt;script&gt;
  window.{{ js_namespace }} = {
    endpoint: '{{ app_host }}/api/receive',
    websiteToken: '{{ website.token }}'
  };
&lt;/script&gt;
&lt;script src="{{ app_host }}/aggregate.js" defer&gt;&lt;/script&gt;</textarea>
                    </div>

                    <h5 class="title is-6 mt-5">
                        <span class="icon-text">
                            <span class="icon">
                                <i class="fas fa-chart-line"></i>
                            </span>
                            <span>Track Custom Events</span>
                        </span>
                    </h5>

                    <div class="notification is-light">
                        <p class="mb-2">Page views are tracked automatically when <code>{{ js_namespace }}.js</code> loads.</p>
                        <p class="mb-3">Use <code>emit(...)</code> for custom events/goals:</p>
                        <pre><code>// Track a button click
window.{{ js_namespace }}.emit('button_click', {
  button_id: 'signup',
  button_text: 'Sign Up Now'
}, 'signup_goal');

// Track form submission
window.{{ js_namespace }}.emit('form_submit', {
  form_name: 'contact',
  form_fields: 3
}, 'lead_submit');

// Track video play
window.{{ js_namespace }}.emit('video_play', {
  video_id: 'intro-video',
  video_duration: 120
}, 'video_engagement');</code></pre>
                    </div>

                    <h5 class="title is-6 mt-5">
                        <span class="icon-text">
                            <span class="icon">
                                <i class="fas fa-user-shield"></i>
                            </span>
                            <span>Consent Management (Optional)</span>
                        </span>
                    </h5>

                    <div class="notification is-light">
                        <p class="mb-3">For privacy compliance, enable Tier 2 tracking after user consent:</p>
                        <pre><code>// Enable consent-based tracking
window.{{ js_namespace }}.setConsent(true);

// Withdraw consent
window.{{ js_namespace }}.setConsent(false);</code></pre>
                        <p class="mt-3"><em>By default, Tier 1 (cookieless) tracking is active without consent.</em></p>
                    </div>

                    <div class="mt-5">
                        <form action="{{ path('app_website_delete', {token: website.token}) }}" method="post" onsubmit="return confirm('Are you sure you want to delete this website? This action cannot be undone.');">
                            <button type="submit" class="button is-danger is-outlined">
                                <span class="icon">
                                    <i class="fas fa-trash"></i>
                                </span>
                                <span>Delete Website</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        {% endfor %}

        <div class="tab-content {% if websites is not empty %}is-hidden{% endif %}" id="settings">
            <div class="columns">
                <div class="column is-6">
                    <form action="{{ path('app_settings_save') }}" method="post">
                        <h4 class="title is-5">Application Configuration</h4>
                        <p class="subtitle is-6">Stored in <code>config/aggregate.yaml</code></p>

                        <div class="field">
                            <label class="label">App Host</label>
                            <div class="control has-icons-left">
                                <input class="input" type="url" name="app_host" value="{{ app_host }}" required placeholder="https://analytics.example.com">
                                <span class="icon is-small is-left">
                                    <i class="fas fa-link"></i>
                                </span>
                            </div>
                            <p class="help">Public URL where this app is hosted. Used for JS generation and documentation.</p>
                        </div>

                        <div class="field">
                            <label class="label">JavaScript Namespace</label>
                            <div class="control has-icons-left">
                                <input class="input" type="text" name="js_namespace" value="{{ js_namespace }}" required placeholder="Aggregate">
                                <span class="icon is-small is-left">
                                    <i class="fas fa-terminal"></i>
                                </span>
                            </div>
                            <p class="help">The global JS variable name (e.g., <code>window.{{ js_namespace }}</code>).</p>
                        </div>

                        <div class="field">
                            <label class="label">Rate Limit (per minute)</label>
                            <div class="control has-icons-left">
                                <input class="input" type="number" name="rate_limit" value="{{ rate_limit }}" required min="1">
                                <span class="icon is-small is-left">
                                    <i class="fas fa-tachometer-alt"></i>
                                </span>
                            </div>
                            <p class="help">Maximum number of events allowed per IP per minute.</p>
                        </div>

                        <div class="field">
                            <div class="control">
                                <button type="submit" class="button is-link">
                                    <span class="icon"><i class="fas fa-save"></i></span>
                                    <span>Save Settings</span>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="column is-5 is-offset-1">
                    <div class="message is-info">
                        <div class="message-header">
                            <p>YAML Fallback</p>
                        </div>
                        <div class="message-body content">
                            <p>You can always edit these settings directly in:</p>
                            <pre><code>config/aggregate.yaml</code></pre>
                            <p>Manual changes in the YAML file will be reflected in this UI after a page refresh.</p>
                            <p><strong>Note:</strong> Sensitive keys like <code>daily_salt_secret</code> can only be changed manually in the YAML file for security.</p>
                        </div>
                    </div>
                </div>
            </div>

            {% if is_granted('ROLE_ADMIN') %}
                <hr>
                <div class="columns">
                    <div class="column is-5">
                        <h4 class="title is-5">Add User</h4>
                        <p class="subtitle is-6">Create dashboard users and set their initial passwords.</p>

                        <form action="{{ path('app_user_create') }}" method="post">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('create_user') }}">

                            <div class="field">
                                <label class="label">Username</label>
                                <div class="control has-icons-left">
                                    <input class="input" type="text" name="username" required placeholder="new-user">
                                    <span class="icon is-small is-left">
                                        <i class="fas fa-user"></i>
                                    </span>
                                </div>
                            </div>

                            <div class="field">
                                <label class="label">Password</label>
                                <div class="control has-icons-left">
                                    <input class="input" type="password" name="password" minlength="8" required placeholder="Minimum 8 characters">
                                    <span class="icon is-small is-left">
                                        <i class="fas fa-lock"></i>
                                    </span>
                                </div>
                            </div>

                            <div class="field">
                                <label class="checkbox">
                                    <input type="checkbox" name="is_admin" value="1">
                                    Grant administrator access
                                </label>
                            </div>

                            <div class="field">
                                <div class="control">
                                    <button type="submit" class="button is-link">
                                        <span class="icon"><i class="fas fa-user-plus"></i></span>
                                        <span>Create User</span>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="column is-7">
                        <h4 class="title is-5">Set User Password</h4>
                        <p class="subtitle is-6">Reset passwords for existing accounts.</p>

                        {% if users is empty %}
                            <div class="notification is-info is-light">
                                No users found.
                            </div>
                        {% else %}
                            <div class="table-container">
                                <table class="table is-fullwidth is-striped is-hoverable is-size-7">
                                    <thead>
                                    <tr>
                                        <th>User</th>
                                        <th>Roles</th>
                                        <th>Created</th>
                                        <th>New Password</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for user in users %}
                                        <tr>
                                            <td>{{ user.username }}</td>
                                            <td>
                                                {% for role in user.roles %}
                                                    <span class="tag is-info is-light">{{ role }}</span>
                                                {% endfor %}
                                            </td>
                                            <td>{{ user.createdAt|date('Y-m-d H:i') }}</td>
                                            <td>
                                                <form action="{{ path('app_user_password_update', {id: user.id}) }}" method="post" class="is-flex is-align-items-center" style="gap: 0.5rem;">
                                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('update_user_password_' ~ user.id) }}">
                                                    <input class="input is-small" type="password" name="new_password" minlength="8" required placeholder="Minimum 8 chars">
                                                    <button type="submit" class="button is-small is-warning is-light">
                                                        <span class="icon"><i class="fas fa-key"></i></span>
                                                        <span>Update</span>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </div>
</div>

<div class="box mt-5">
    <h3 class="title is-4">
        <span class="icon-text">
            <span class="icon">
                <i class="fas fa-user-cog"></i>
            </span>
            <span>Account Management</span>
        </span>
    </h3>

    <div class="content">
        <p><strong>Username:</strong> {{ app.user.username }}</p>
        <p><strong>Roles:</strong>
            {% for role in app.user.roles %}
                <span class="tag is-info">{{ role }}</span>
            {% endfor %}
        </p>
    </div>

    <div class="mt-4">
        <h5 class="title is-6">
            <span class="icon-text">
                <span class="icon">
                    <i class="fas fa-cogs"></i>
                </span>
                <span>Worker Status</span>
            </span>
        </h5>
        <div class="notification is-light">
            <p>The worker runs outside the dashboard and should be managed by Docker, systemd, or Supervisor.</p>
            <p class="mt-2"><strong>Command:</strong> <code>php bin/console messenger:consume async --time-limit=3600 --memory-limit=128M</code></p>
            <p class="help mt-2">See <code>docs/systemd/aggregate-worker.service</code> or <code>docs/supervisor/aggregate-worker.conf</code> for production examples.</p>
        </div>
    </div>
</div>

<!-- Add Website Modal -->
<div id="add-website-modal" class="modal">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title">
                <span class="icon-text">
                    <span class="icon">
                        <i class="fas fa-plus"></i>
                    </span>
                    <span>Add New Website</span>
                </span>
            </p>
            <button class="delete" aria-label="close"></button>
        </header>
        <form action="{{ path('app_website_create') }}" method="post">
            <section class="modal-card-body">
                <div class="field">
                    <label class="label" for="website-name">Website Name</label>
                    <div class="control has-icons-left">
                        <input class="input" type="text" id="website-name" name="name" placeholder="My Awesome Site" required>
                        <span class="icon is-small is-left">
                            <i class="fas fa-tag"></i>
                        </span>
                    </div>
                    <p class="help">A friendly name to identify this website</p>
                </div>

                <div class="field">
                    <label class="label" for="website-domain">Domain</label>
                    <div class="control has-icons-left">
                        <input class="input" type="text" id="website-domain" name="domain" placeholder="example.com" required>
                        <span class="icon is-small is-left">
                            <i class="fas fa-globe"></i>
                        </span>
                    </div>
                    <p class="help">The domain where analytics will be tracked (without http://)</p>
                </div>
            </section>
            <footer class="modal-card-foot">
                <button type="submit" class="button is-success">
                    <span class="icon">
                        <i class="fas fa-check"></i>
                    </span>
                    <span>Create Website</span>
                </button>
                <button type="button" class="button js-modal-close">Cancel</button>
            </footer>
        </form>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    // Modal handling
    document.addEventListener('DOMContentLoaded', () => {
        // Open modal
        document.querySelectorAll('.js-modal-trigger').forEach(trigger => {
            trigger.addEventListener('click', () => {
                const modal = document.getElementById(trigger.dataset.target);
                modal.classList.add('is-active');
            });
        });

        // Close modal
        function closeModal(modal) {
            modal.classList.remove('is-active');
        }

        document.querySelectorAll('.modal .delete, .modal .js-modal-close, .modal-background').forEach(closeBtn => {
            closeBtn.addEventListener('click', () => {
                const modal = closeBtn.closest('.modal');
                closeModal(modal);
            });
        });

        // Tab switching
        const tabs = document.querySelectorAll('[data-tab]');
        tabs.forEach(tab => {
            tab.addEventListener('click', (e) => {
                e.preventDefault();
                const targetId = tab.getAttribute('data-tab');

                // Remove active class from all tabs
                tabs.forEach(t => t.classList.remove('is-active'));
                // Add active to clicked tab
                tab.classList.add('is-active');

                // Hide all tab contents
                document.querySelectorAll('.tab-content').forEach(content => {
                    content.classList.add('is-hidden');
                });

                // Show target content
                document.getElementById(targetId).classList.remove('is-hidden');
            });
        });

        // Copy to clipboard
        document.querySelectorAll('.copy-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const targetId = btn.getAttribute('data-clipboard-target');
                const textarea = document.querySelector(targetId);
                textarea.select();
                document.execCommand('copy');

                btn.classList.add('is-success');
                btn.querySelector('span:last-child').textContent = 'Copied!';

                setTimeout(() => {
                    btn.classList.remove('is-success');
                    btn.querySelector('span:last-child').textContent = 'Copy to Clipboard';
                }, 2000);
            });
        });
    });
</script>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Dashboard | {{ app_branding.name }}{% endblock %}

{% block body %}
<h1 class="title">Dashboard</h1>
<h2 class="subtitle">Welcome, {{ app.user.username }}!</h2>

<div class="box">
    <div class="level">
        <div class="level-left">
            <div class="level-item">
                <h3 class="title is-4">
                    <span class="icon-text">
                        <span class="icon">
                            <i class="fas fa-globe"></i>
                        </span>
                        <span>Your Websites</span>
                    </span>
                </h3>
            </div>
        </div>
        <div class="level-right">
            <div class="level-item">
                <button class="button is-primary js-modal-trigger" data-target="add-website-modal">
                    <span class="icon">
                        <i class="fas fa-plus"></i>
                    </span>
                    <span>Add Website</span>
                </button>
            </div>
        </div>
    </div>

    {% if websites is empty %}
        <div class="notification is-info is-light">
            <p>You haven't added any websites yet.</p>
            <p class="mt-3">Click the "Add Website" button above to create your first website.</p>
        </div>
    {% endif %}
    <div class="tabs is-boxed">
        <ul>
            {% for website in websites %}
                <li {% if loop.first %}class="is-active"{% endif %} data-tab="website-{{ loop.index }}">
                    <a>
                        <span class="icon is-small"><i class="fas fa-globe"></i></span>
                        <span>{{ website.name }}</span>
                    </a>
                </li>
            {% endfor %}
            <li {% if websites is empty %}class="is-active"{% endif %} data-tab="settings">
                <a>
                    <span class="icon is-small"><i class="fas fa-cog"></i></span>
                    <span>Settings</span>
                </a>
            </li>
        </ul>
    </div>

        {% for website in websites %}
            <div class="tab-content {% if not loop.first %}is-hidden{% endif %}" id="website-{{ loop.index }}">
                <div class="content">
                    <h4 class="title is-5">{{ website.name }}</h4>
                    <p><strong>Domain:</strong> <code>{{ website.domain }}</code></p>
                    <p><strong>Website Token:</strong> <code>{{ website.token }}</code></p>

                    <h5 class="title is-6 mt-5">
                        <span class="icon-text">
                            <span class="icon">
                                <i class="fas fa-code"></i>
                            </span>
                            <span>Integration Code</span>
                        </span>
                    </h5>

                    <div class="notification is-light">
                        <p class="mb-3">Add this code to your website's <code>&lt;head&gt;</code> section:</p>
                        <pre><code>&lt;script&gt;
  window.{{ js_namespace }} = {
    endpoint: '{{ app_host }}/api/receive',
    websiteToken: '{{ website.token }}'
  };
&lt;/script&gt;
&lt;script src="{{ app_host }}/aggregate.js" defer referrerpolicy="no-referrer"&gt;&lt;/script&gt;</code></pre>
                        <button class="button is-small is-info mt-3 copy-btn" data-clipboard-target="#code-{{ loop.index }}">
                            <span class="icon">
                                <i class="fas fa-copy"></i>
                            </span>
                            <span>Copy to Clipboard</span>
                        </button>
                        <textarea id="code-{{ loop.index }}" class="is-hidden">&lt;script&gt;
  window.{{ js_namespace }} = {
    endpoint: '{{ app_host }}/api/receive',
    websiteToken: '{{ website.token }}'
  };
&lt;/script&gt;
&lt;script src="{{ app_host }}/aggregate.js" defer referrerpolicy="no-referrer"&gt;&lt;/script&gt;</textarea>
                    </div>

                    <h5 class="title is-6 mt-5">
                        <span class="icon-text">
                            <span class="icon">
                                <i class="fas fa-chart-line"></i>
                            </span>
                            <span>Track Custom Events</span>
                        </span>
                    </h5>

                    <div class="notification is-light">
                        <p class="mb-2">An anonymous <code>view</code> event is measured automatically when <code>{{ js_namespace }}.js</code> loads.</p>
                        <p class="mb-3">Use <code>emit(...)</code> at any time for named interactions. Without enhanced consent, the safe event name and coarse context are retained, custom properties are omitted, and a goal is retained only when its enabled definition in <code>config/goals.yaml</code> permits anonymous use.</p>
                        <p class="mb-3">Keep event and goal codes fixed and non-identifying: start with a letter; use at most 100 characters from letters, numbers, <code>_ . : -</code>; and never insert user-entered values.</p>
                        <pre><code>// Track a button click
window.{{ js_namespace }}.emit('button_click', {
  button_id: 'signup',
  button_text: 'Sign Up Now'
}, 'signup');

// Track form submission
window.{{ js_namespace }}.emit('form_submit', {
  form_name: 'contact',
  form_fields: 3
}, 'lead');

// Track video play
window.{{ js_namespace }}.emit('video_play', {
  video_id: 'intro-video',
  video_duration: 120
});</code></pre>
                        <p class="mt-3">A disallowed goal is dropped while the event remains recorded. The SDK logs a generic console warning without echoing the submitted value.</p>
                    </div>

                    <h5 class="title is-6 mt-5">
                        <span class="icon-text">
                            <span class="icon">
                                <i class="fas fa-user-shield"></i>
                            </span>
                            <span>Enhanced Analytics Consent</span>
                        </span>
                    </h5>

                    <div class="notification is-light">
                        <p class="mb-3">Enable identifiers, event properties, and exact dimensions only after the visitor accepts enhanced analytics. Goal codes remain server-allowlisted in both modes:</p>
                        <pre><code>// Accept enhanced analytics
window.{{ js_namespace }}.setConsent(true);

// Reject or withdraw enhanced analytics
window.{{ js_namespace }}.setConsent(false);</code></pre>
                        <p class="mt-3"><em>Rejecting enhanced analytics removes browser identifiers and event details. Coarse page-view and named-event rows continue unless an administrator disables collection or excludes this path.</em></p>
                    </div>

                    <div class="mt-5">
                        <form action="{{ path('app_website_delete', {token: website.token}) }}" method="post" onsubmit="return confirm('Are you sure you want to delete this website? This action cannot be undone.');">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('delete_website_' ~ website.token) }}">
                            <button type="submit" class="button is-danger is-outlined">
                                <span class="icon">
                                    <i class="fas fa-trash"></i>
                                </span>
                                <span>Delete Website</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        {% endfor %}

        <div class="tab-content {% if websites is not empty %}is-hidden{% endif %}" id="settings">
            <div class="columns">
                <div class="column is-6">
                    <form action="{{ path('app_settings_save') }}" method="post">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('app_settings') }}">
                        <h4 class="title is-5">Application Configuration</h4>
                        <p class="subtitle is-6">Stored in <code>config/aggregate.yaml</code></p>

                        <div class="field">
                            <label class="label">App Host</label>
                            <div class="control has-icons-left">
                                <input class="input" type="url" name="app_host" value="{{ app_host }}" required placeholder="https://analytics.example.com">
                                <span class="icon is-small is-left">
                                    <i class="fas fa-link"></i>
                                </span>
                            </div>
                            <p class="help">Public URL where this app is hosted. Used for JS generation and documentation.</p>
                        </div>

                        <div class="field">
                            <label class="label">JavaScript Namespace</label>
                            <div class="control has-icons-left">
                                <input class="input" type="text" name="js_namespace" value="{{ js_namespace }}" required placeholder="Aggregate">
                                <span class="icon is-small is-left">
                                    <i class="fas fa-terminal"></i>
                                </span>
                            </div>
                            <p class="help">The global JS variable name (e.g., <code>window.{{ js_namespace }}</code>).</p>
                        </div>

                        <div class="field">
                            <label class="label">Rate Limit (per minute)</label>
                            <div class="control has-icons-left">
                                <input class="input" type="number" name="rate_limit" value="{{ rate_limit }}" required min="1">
                                <span class="icon is-small is-left">
                                    <i class="fas fa-tachometer-alt"></i>
                                </span>
                            </div>
                            <p class="help">Maximum number of events allowed per IP per minute.</p>
                        </div>

                        <div class="field">
                            <div class="control">
                                <button type="submit" class="button is-link">
                                    <span class="icon"><i class="fas fa-save"></i></span>
                                    <span>Save Settings</span>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="column is-5 is-offset-1">
                    <div class="message is-info">
                        <div class="message-header">
                            <p>YAML Fallback</p>
                        </div>
                        <div class="message-body content">
                            <p>You can always edit these settings directly in:</p>
                            <pre><code>config/aggregate.yaml</code></pre>
                            <p>Manual changes in the YAML file will be reflected in this UI after a page refresh.</p>
                            <p>Settings supplied as server environment variables take precedence over values saved here.</p>
                        </div>
                    </div>
                </div>
            </div>

            {% if is_granted('ROLE_ADMIN') %}
                <hr>
                <div class="columns">
                    <div class="column is-6">
                        <h4 class="title is-5">White-label Branding</h4>
                        <p class="subtitle is-6">Customize the identity shown throughout the application.</p>

                        <form action="{{ path('app_branding_settings_save') }}" method="post" enctype="multipart/form-data">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('branding_settings') }}">
                            {% if not app_branding.name_overridden %}
                                <input type="hidden" name="_original_brand_name" value="{{ app_branding.name }}">
                            {% endif %}
                            {% if not app_branding.logo_text_overridden %}
                                <input type="hidden" name="_original_brand_logo_text" value="{{ app_branding.logo_text }}">
                            {% endif %}

                            <div class="field">
                                <label class="label" for="brand-name">Brand name</label>
                                <div class="control has-icons-left">
                                    <input class="input" type="text" id="brand-name" name="brand_name" value="{{ app_branding.name }}" maxlength="100" required{% if app_branding.name_overridden %} disabled aria-describedby="brand-name-help"{% endif %}>
                                    <span class="icon is-small is-left"><i class="fas fa-signature"></i></span>
                                </div>
                                <p class="help" id="brand-name-help">
                                    {% if app_branding.name_overridden %}
                                        Controlled by the <code>BRAND_NAME</code> environment variable.
                                    {% else %}
                                        Replaces the product name in page titles, headings, and application help text.
                                    {% endif %}
                                </p>
                            </div>

                            <div class="field">
                                <label class="label" for="brand-logo-text">Logo text</label>
                                <div class="control has-icons-left">
                                    <input class="input" type="text" id="brand-logo-text" name="brand_logo_text" value="{{ app_branding.logo_text }}" maxlength="100" placeholder="{{ app_branding.name }}"{% if app_branding.logo_text_overridden %} disabled aria-describedby="brand-logo-text-help"{% endif %}>
                                    <span class="icon is-small is-left"><i class="fas fa-font"></i></span>
                                </div>
                                <p class="help" id="brand-logo-text-help">
                                    {% if app_branding.logo_text_overridden %}
                                        Controlled by the <code>BRAND_LOGO_TEXT</code> environment variable.
                                    {% else %}
                                        The wordmark beside the image. Leave it empty for an image-only logo; without a valid image, the brand name is used for accessibility.
                                    {% endif %}
                                </p>
                            </div>

                            {% if app_branding.has_logo %}
                                <div class="field">
                                    <p class="label">Current logo</p>
                                    <div class="control">
                                        <img src="{{ path('app_branding_logo', {v: app_branding.logo_version}) }}" alt="{{ app_branding.name }} logo" style="display:block; max-width:320px; max-height:120px; object-fit:contain;">
                                    </div>
                                </div>
                            {% endif %}

                            {% if app_branding.logo_path_overridden %}
                                <div class="notification is-info is-light">
                                    The logo path is controlled by the <code>BRAND_LOGO_PATH</code> environment variable. Change or remove that override to upload or remove a logo here.
                                </div>
                            {% endif %}

                            <div class="field">
                                <label class="label" for="brand-logo">Upload logo</label>
                                <div class="control">
                                    <input class="input" type="file" id="brand-logo" name="brand_logo" accept="image/png,image/jpeg,image/webp" {% if app_branding.logo_path_overridden %}disabled{% endif %}>
                                </div>
                                <p class="help">PNG, JPEG, or WebP; maximum 2 MiB, 4096 × 4096 pixels, and 16 megapixels. SVG is not accepted. Remove embedded metadata before uploading; image bytes are served as supplied.</p>
                            </div>

                            {% if app_branding.has_logo and not app_branding.logo_path_overridden %}
                                <div class="field">
                                    <label class="checkbox">
                                        <input type="checkbox" name="remove_brand_logo" value="1">
                                        Remove the current logo
                                    </label>
                                </div>
                            {% endif %}

                            <hr>
                            <h5 class="title is-6">Theme colors</h5>
                            <p class="help mb-3">Use hexadecimal colors. Three-digit values in YAML are expanded to six digits.</p>
                            {% if app_branding.theme.contrast_fallback %}
                                <div class="notification is-warning is-light" role="alert">
                                    The configured text, background, and surface colors do not meet the minimum 4.5:1 text contrast. Safe defaults are active until that palette is corrected.
                                </div>
                            {% endif %}
                            {% set theme_colors = [
                                {key: 'primary_color', config: 'brand_primary_color', label: 'Primary', help: 'Primary actions and highlights.'},
                                {key: 'accent_color', config: 'brand_accent_color', label: 'Accent', help: 'Links, secondary actions, and active tabs.'},
                                {key: 'navbar_color', config: 'brand_navbar_color', label: 'Navigation', help: 'Navigation bar background.'},
                                {key: 'background_color', config: 'brand_background_color', label: 'Page background', help: 'Application page background.'},
                                {key: 'surface_color', config: 'brand_surface_color', label: 'Surface', help: 'Cards, boxes, tables, and dialogs.'},
                                {key: 'text_color', config: 'brand_text_color', label: 'Text', help: 'Primary interface text.'}
                            ] %}
                            <div class="columns is-multiline">
                                {% for color in theme_colors %}
                                    {% set color_id = color.config|replace({'_': '-'}) %}
                                    {% set color_overridden = app_branding.theme[color.key ~ '_overridden'] %}
                                    <div class="column is-half">
                                        <div class="field">
                                            <label class="label" for="{{ color_id }}">{{ color.label }}</label>
                                            <div class="control">
                                                <input class="input" type="color" id="{{ color_id }}" name="{{ color.config }}" value="{{ app_branding.theme[color.key] }}"{% if color_overridden %} disabled aria-describedby="{{ color_id }}-help"{% endif %}>
                                                {% if not color_overridden %}
                                                    <input type="hidden" name="_original_{{ color.config }}" value="{{ app_branding.theme[color.key] }}">
                                                {% endif %}
                                            </div>
                                            <p class="help" id="{{ color_id }}-help">
                                                {% if color_overridden %}
                                                    Controlled by <code>{{ color.config|upper }}</code>.
                                                {% else %}
                                                    {{ color.help }} <code>{{ app_branding.theme[color.key] }}</code>
                                                {% endif %}
                                            </p>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>

                            <h5 class="title is-6">Fonts</h5>
                            <div class="field">
                                <label class="label" for="brand-font-family">Interface font stack</label>
                                <div class="control has-icons-left">
                                    <input class="input" type="text" id="brand-font-family" name="brand_font_family" value="{{ app_branding.theme.font_family }}" maxlength="200" required{% if app_branding.theme.font_family_overridden %} disabled aria-describedby="brand-font-family-help"{% endif %}>
                                    {% if not app_branding.theme.font_family_overridden %}
                                        <input type="hidden" name="_original_brand_font_family" value="{{ app_branding.theme.font_family }}">
                                    {% endif %}
                                    <span class="icon is-small is-left"><i class="fas fa-font"></i></span>
                                </div>
                                <p class="help" id="brand-font-family-help">
                                    {% if app_branding.theme.font_family_overridden %}
                                        Controlled by <code>BRAND_FONT_FAMILY</code>.
                                    {% else %}
                                        Comma-separated local or system families, for example <code>Inter, Arial, sans-serif</code>. Remote fonts are not downloaded.
                                    {% endif %}
                                </p>
                            </div>

                            <div class="field">
                                <label class="label" for="brand-heading-font-family">Heading and wordmark font stack</label>
                                <div class="control has-icons-left">
                                    <input class="input" type="text" id="brand-heading-font-family" name="brand_heading_font_family" value="{{ app_branding.theme.heading_font_family }}" maxlength="200" required{% if app_branding.theme.heading_font_family_overridden %} disabled aria-describedby="brand-heading-font-family-help"{% endif %}>
                                    {% if not app_branding.theme.heading_font_family_overridden %}
                                        <input type="hidden" name="_original_brand_heading_font_family" value="{{ app_branding.theme.heading_font_family }}">
                                    {% endif %}
                                    <span class="icon is-small is-left"><i class="fas fa-font"></i></span>
                                </div>
                                <p class="help" id="brand-heading-font-family-help">
                                    {% if app_branding.theme.heading_font_family_overridden %}
                                        Controlled by <code>BRAND_HEADING_FONT_FAMILY</code>.
                                    {% else %}
                                        Applied to headings and the navigation wordmark. Use fonts already available in visitors' browsers.
                                    {% endif %}
                                </p>
                            </div>

                            <div class="field">
                                <div class="control">
                                    <button type="submit" class="button is-link"{% if app_branding.name_overridden and app_branding.logo_text_overridden and app_branding.logo_path_overridden and app_branding.theme.all_overridden %} disabled{% endif %}>
                                        <span class="icon"><i class="fas fa-palette"></i></span>
                                        <span>Save Branding</span>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="column is-5 is-offset-1">
                        <div class="message is-info">
                            <div class="message-header"><p>YAML configuration</p></div>
                            <div class="message-body content">
                                <p>Non-UI deployments can configure the same identity and theme in <code>config/aggregate.yaml</code>:</p>
                                <pre><code>environments:
  prod:
    brand_name: "Example Analytics"
    brand_logo_text: "Example"
    brand_logo_path: "/srv/branding/logo.png"
    brand_primary_color: "#00D1B2"
    brand_accent_color: "#485FC7"
    brand_navbar_color: "#14161A"
    brand_background_color: "#F5F5F5"
    brand_surface_color: "#FFFFFF"
    brand_text_color: "#363636"
    brand_font_family: "Inter, Arial, sans-serif"
    brand_heading_font_family: "Georgia, serif"</code></pre>
                                <p>Use the active environment when the file has an <code>environments</code> section; flat files may place these branding keys at their root. The logo path may be absolute or relative to the project root, and the PHP process must be able to read it.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <hr>
                <div class="columns">
                    <div class="column is-6">
                        <h4 class="title is-5">Analytics Collection</h4>
                        <p class="subtitle is-6">Collection, sensitive-path, and coarse-geography controls stored in <code>config/aggregate.yaml</code>.</p>

                        <form action="{{ path('app_anonymous_settings_save') }}" method="post">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('anonymous_settings') }}">

                            <div class="field">
                                <label class="checkbox">
                                    <input type="checkbox" name="anonymous_tracking_enabled" value="1" {% if anonymous_tracking_enabled %}checked{% endif %}>
                                    Enable analytics collection
                                </label>
                                <p class="help">When disabled, the server rejects anonymous and consented enhanced events.</p>
                            </div>

                            <div class="field">
                                <label class="label" for="anonymous-excluded-paths">Excluded paths</label>
                                <div class="control">
                                    <textarea class="textarea is-family-monospace" id="anonymous-excluded-paths" name="anonymous_excluded_paths" rows="6" placeholder="/account/*&#10;/checkout/**&#10;/health">{{ anonymous_excluded_paths|join('\n') }}</textarea>
                                </div>
                                <p class="help">One path or glob per line. Query strings and fragments are never accepted. Matching paths are excluded from anonymous and enhanced collection.</p>
                            </div>

                            <hr>
                            <h5 class="title is-6">Coarse Geography (Optional)</h5>

                            <div class="field">
                                <label class="checkbox">
                                    <input type="checkbox" name="anonymous_geo_enabled" value="1" {% if anonymous_geo_enabled %}checked{% endif %}>
                                    Derive coarse geography from the request IP
                                </label>
                                <p class="help">Off by default. The lookup uses only a local MMDB file; the IP and detailed lookup record are not added to the event or queue. Failed lookups leave geography empty without rejecting the event.</p>
                            </div>

                            <div class="field">
                                <label class="label" for="anonymous-geo-level">Stored geography level</label>
                                <div class="control">
                                    <div class="select is-fullwidth">
                                        <select id="anonymous-geo-level" name="anonymous_geo_level" required>
                                            <option value="macro_region" {% if anonymous_geo_level == 'macro_region' %}selected{% endif %}>Macro-region (recommended)</option>
                                            <option value="country" {% if anonymous_geo_level == 'country' %}selected{% endif %}>Country</option>
                                        </select>
                                    </div>
                                </div>
                                <p class="help">Macro-region stores a continent-level code such as <code>continent:NA</code>. Country stores an ISO country code such as <code>country:US</code>. This is approximate network-exit geography—not a visitor's precise physical location. City, subdivision, postcode, and coordinates are never retained.</p>
                            </div>

                            <div class="field">
                                <label class="label" for="anonymous-geo-database-path">Local GeoIP database path</label>
                                <div class="control">
                                    <input class="input is-family-monospace" type="text" id="anonymous-geo-database-path" name="anonymous_geo_database_path" value="{{ anonymous_geo_database_path }}" maxlength="4096" placeholder="/var/lib/GeoIP/GeoLite2-Country.mmdb">
                                </div>
                                <p class="help">Use a local absolute path (recommended) or a path inside the project root to a read-only GeoLite2-Country-compatible <code>.mmdb</code>. URI schemes, project-directory escapes, UNC/network shares, and Windows device paths are rejected. The application does not download a database or call a GeoIP web service.</p>
                            </div>

                            <div class="field">
                                <div class="control">
                                    <button type="submit" class="button is-link">
                                        <span class="icon"><i class="fas fa-shield-alt"></i></span>
                                        <span>Save Collection Settings</span>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="column is-5 is-offset-1">
                        <div class="message is-warning is-light">
                            <div class="message-header">
                                <p>What rejection means</p>
                            </div>
                            <div class="message-body content">
                                <p><strong>Reject</strong> disables enhanced analytics: no visitor ID, session ID, cookie, event properties, or exact dimensions.</p>
                                <p>Anonymous rows retain a safe event name, UTC hour bucket, sanitized path, coarse referrer/device/viewport buckets, optional coarse geography, and—when configured—an allowlisted goal. They may still be personal data in context; the BI views group them and suppress low-volume cells.</p>
                                <p>IP geolocation is itself processing of personal data in many jurisdictions, even though the analytics event does not retain the IP. Enable it only after documenting a legal basis and notice appropriate to the deployment.</p>
                            </div>
                        </div>

                        <div class="mt-5">
                            <h4 class="title is-5">BI Disclosure Thresholds</h4>
                            <p class="subtitle is-6">Stored directly in <code>analytics_privacy_settings</code> and used immediately by the BI views.</p>

                            {% if analytics_privacy_settings_error %}
                                <div class="notification is-danger is-light">
                                    The stored thresholds could not be loaded, so safe defaults are shown below. Saving valid values will repair a missing or invalid singleton row. If the table or columns are missing, run the database migrations first.
                                </div>
                            {% endif %}

                            <form action="{{ path('app_analytics_privacy_settings_save') }}" method="post">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('analytics_privacy_settings') }}">

                                <div class="field">
                                    <label class="label" for="anonymous-min-cell-count">Minimum BI cell count</label>
                                    <div class="control">
                                        <input class="input" type="number" id="anonymous-min-cell-count" name="anonymous_min_cell_count" value="{{ anonymous_min_cell_count }}" min="2" max="1000" required>
                                    </div>
                                    <p class="help">Default: 5; allowed range: 2–1000. <code>bi_anonymous_events_v1</code> exposes completed UTC-hour cells and <code>bi_anonymous_goals_v1</code> exposes completed UTC-day goal cells meeting this count.</p>
                                </div>

                                <div class="field">
                                    <label class="label" for="anonymous-geo-min-cell-count">Minimum geography BI cell count</label>
                                    <div class="control">
                                        <input class="input" type="number" id="anonymous-geo-min-cell-count" name="anonymous_geo_min_cell_count" value="{{ anonymous_geo_min_cell_count }}" min="10" max="1000" required>
                                    </div>
                                    <p class="help">Default: 25; allowed range: 10–1000. <code>bi_anonymous_geo_events_v1</code> exposes completed UTC-day cells with primary and secondary suppression.</p>
                                </div>

                                <div class="field">
                                    <div class="control">
                                        <button type="submit" class="button is-link">
                                            <span class="icon"><i class="fas fa-database"></i></span>
                                            <span>Save BI Thresholds</span>
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <hr>
                <div class="columns">
                    <div class="column is-5">
                        <h4 class="title is-5">Add User</h4>
                        <p class="subtitle is-6">Create dashboard users and set their initial passwords.</p>

                        <form action="{{ path('app_user_create') }}" method="post">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('create_user') }}">

                            <div class="field">
                                <label class="label">Username</label>
                                <div class="control has-icons-left">
                                    <input class="input" type="text" name="username" required placeholder="new-user">
                                    <span class="icon is-small is-left">
                                        <i class="fas fa-user"></i>
                                    </span>
                                </div>
                            </div>

                            <div class="field">
                                <label class="label">Password</label>
                                <div class="control has-icons-left">
                                    <input class="input" type="password" name="password" minlength="8" required placeholder="Minimum 8 characters">
                                    <span class="icon is-small is-left">
                                        <i class="fas fa-lock"></i>
                                    </span>
                                </div>
                            </div>

                            <div class="field">
                                <label class="checkbox">
                                    <input type="checkbox" name="is_admin" value="1">
                                    Grant administrator access
                                </label>
                            </div>

                            <div class="field">
                                <div class="control">
                                    <button type="submit" class="button is-link">
                                        <span class="icon"><i class="fas fa-user-plus"></i></span>
                                        <span>Create User</span>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="column is-7">
                        <h4 class="title is-5">Set User Password</h4>
                        <p class="subtitle is-6">Reset passwords for existing accounts.</p>

                        {% if users is empty %}
                            <div class="notification is-info is-light">
                                No users found.
                            </div>
                        {% else %}
                            <div class="table-container">
                                <table class="table is-fullwidth is-striped is-hoverable is-size-7">
                                    <thead>
                                    <tr>
                                        <th>User</th>
                                        <th>Roles</th>
                                        <th>Created</th>
                                        <th>New Password</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for user in users %}
                                        <tr>
                                            <td>{{ user.username }}</td>
                                            <td>
                                                {% for role in user.roles %}
                                                    <span class="tag is-info is-light">{{ role }}</span>
                                                {% endfor %}
                                            </td>
                                            <td>{{ user.createdAt|date('Y-m-d H:i') }}</td>
                                            <td>
                                                <form action="{{ path('app_user_password_update', {id: user.id}) }}" method="post" class="is-flex is-align-items-center" style="gap: 0.5rem;">
                                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('update_user_password_' ~ user.id) }}">
                                                    <input class="input is-small" type="password" name="new_password" minlength="8" required placeholder="Minimum 8 chars">
                                                    <button type="submit" class="button is-small is-warning is-light">
                                                        <span class="icon"><i class="fas fa-key"></i></span>
                                                        <span>Update</span>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </div>
</div>

<div class="box mt-5">
    <h3 class="title is-4">
        <span class="icon-text">
            <span class="icon">
                <i class="fas fa-user-cog"></i>
            </span>
            <span>Account Management</span>
        </span>
    </h3>

    <div class="content">

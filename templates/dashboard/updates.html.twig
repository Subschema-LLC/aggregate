{% extends 'base.html.twig' %}

{% block title %}Updates - {{ app_branding.name }}{% endblock %}

{% block body %}
    {% set statuses = {
        up_to_date: {label: 'Up to date', color: 'success'},
        available: {label: 'Update available', color: 'info'},
        ahead: {label: 'Local checkout is ahead', color: 'warning'},
        diverged: {label: 'Local and remote history have diverged', color: 'warning'},
        unknown: {label: 'Update status unknown', color: 'warning'},
        error: {label: 'Update check failed', color: 'danger'},
        unavailable: {label: 'Update checking unavailable', color: 'warning'}
    } %}
    {% set status = statuses[update_status.state]|default(statuses.unknown) %}

    <div class="level">
        <div class="level-left">
            <div>
                <h1 class="title">Application updates</h1>
                <p class="subtitle">Check this installation against the same branch on GitHub.</p>
            </div>
        </div>
        <div class="level-right">
            <a class="button" href="{{ path('app_dashboard') }}">
                <span class="icon"><i class="fas fa-arrow-left" aria-hidden="true"></i></span>
                <span>Dashboard</span>
            </a>
        </div>
    </div>

    <div class="notification is-{{ status.color }} is-light" role="status">
        <p class="has-text-weight-semibold">{{ status.label }}</p>
        <p>{{ update_status.message }}</p>
        {% if update_status.compare_url %}
            <p class="mt-2"><a href="{{ update_status.compare_url }}">Review changes on GitHub</a></p>
        {% endif %}
    </div>

    <div class="box">
        <h2 class="title is-4">Installed source</h2>
        <div class="table-container">
            <table class="table is-fullwidth">
                <tbody>
                    <tr>
                        <th scope="row">Repository</th>
                        <td><a href="{{ update_repository_url }}">{{ update_repository }}</a></td>
                    </tr>
                    <tr>
                        <th scope="row">Branch</th>
                        <td>{{ update_status.branch ?? 'Unavailable' }}</td>
                    </tr>
                    <tr>
                        <th scope="row">Installed revision</th>
                        <td>{% if update_status.current_commit %}<code>{{ update_status.current_commit }}</code>{% else %}Unavailable{% endif %}</td>
                    </tr>
                    <tr>
                        <th scope="row">Latest remote revision</th>
                        <td>{% if update_status.latest_commit %}<code>{{ update_status.latest_commit }}</code>{% else %}Unavailable{% endif %}</td>
                    </tr>
                    <tr>
                        <th scope="row">Last checked</th>
                        <td>
                            {% if update_status.checked_at is not null %}
                                <time datetime="{{ update_status.checked_at|date('c', 'UTC') }}">{{ update_status.checked_at|date('Y-m-d H:i:s', 'UTC') }} UTC</time>
                            {% else %}
                                Not checked
                            {% endif %}
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <form method="post" action="{{ path('app_updates_refresh') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('application_updates_refresh') }}">
            <button class="button is-primary" type="submit">
                <span class="icon"><i class="fas fa-rotate" aria-hidden="true"></i></span>
                <span>Check now</span>
            </button>
            <p class="help">Results are cached for one hour. Use this button to request a fresh check.</p>
        </form>
    </div>

    <div class="content box">
        <h2 class="title is-4">Deploy an update</h2>
        <p>Run these commands from the application checkout on the server as your deployment user. They also work with the dashboard disabled.</p>
        <p>Check the current branch for changes:</p>
        <pre><code>php bin/console app:updates:check --refresh</code></pre>
        <p>Before pulling, review the changes, back up the database and configuration, and prepare any required maintenance window. Follow the <a href="{{ update_repository_url }}{% if update_status.branch %}/blob/{{ update_status.branch|url_encode }}/DEPLOYMENT.md#updates{% endif %}">deployment guide</a>, including pausing collection and workers before privacy migrations.</p>
        <p>Pull the available source update:</p>
        <pre><code>php bin/console app:updates:pull</code></pre>
        <p>The dashboard checks update status; source updates run through the CLI so the web process does not need permission to change application files.</p>
        <p>Complete your deployment after pulling: install Composer dependencies, apply database migrations, clear and warm the production cache, compile dashboard assets, and restart long-running workers.</p>
        <p>If this is a private repository, configure <code>AGGREGATE_GITHUB_TOKEN</code> in the server environment for update checks. Source pulls use the deployment user's Git credentials.</p>
    </div>
{% endblock %}

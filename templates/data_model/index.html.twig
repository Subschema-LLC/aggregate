{% extends 'base.html.twig' %}

{% block title %}Data model - {{ app_branding.name }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        [data-property-row] summary { overflow-wrap: anywhere; }
        @media (max-width: 768px) {
            .model-mappings thead { display: none; }
            .model-mappings tbody, .model-mappings tr, .model-mappings td { display: block; }
            .model-mappings tr { border-bottom: 1px solid currentColor; padding: 0.75rem 0; }
            .model-mappings td { border: 0; padding: 0.5rem 0; }
            .model-mappings td[data-label]::before { content: attr(data-label); display: block; font-weight: 600; margin-bottom: 0.5rem; }
        }
    </style>
{% endblock %}

{% block body %}
    <h1 class="title">Data model</h1>
    <p class="subtitle">Define custom properties, campaign capture, consent requirements, and reporting columns. Download the saved model to share with your analytics implementation developers.</p>

    {% if configuration_error %}<div class="notification is-danger" role="alert">{{ configuration_error }}</div>{% endif %}
    {% include 'data_model/_navigation.html.twig' with {current_model_page: 'app_data_model'} %}
    {% if unsaved_property %}<div class="notification is-info" role="status"><code>{{ unsaved_property }}</code> has been added to this form. Review its settings and save to apply the change.</div>{% endif %}
    {% if addition_error %}<div class="notification is-warning" role="alert">{{ addition_error }}</div>{% endif %}

    <div class="notification is-info">
        <strong>Anonymous UTM recommendation:</strong> use at most <code>utm_medium</code>, with broad values such as <code>email</code>, <code>social</code>, or <code>cpc</code>. All UTM properties require enhanced consent by default.
        You can override this recommendation by selecting “Allow without consent” for any property. More detailed source, campaign, term, content, or ID values can reveal specific campaigns, searches, or identifiers. Review the actual values and privacy implications before enabling them for anonymous collection. Free-text identifiers can appear even in <code>utm_medium</code>; the setting does not make supplied values anonymous.
    </div>
    {% if detailed_anonymous_utms %}
        <div class="notification is-warning" role="alert"><strong>Anonymous UTM recommendation overridden.</strong> The saved model permits detailed UTM data without consent in: <code>{{ detailed_anonymous_utms|join(', ') }}</code>. Review campaign tagging and disclosures for this additional detail.</div>
    {% endif %}

    <form action="{{ path('app_data_model_save') }}" method="post" id="data-model-form">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('data_model_settings') }}">
        <section class="box">
            <h2 class="title is-4">Custom data configurations</h2>
            <p>Expand a custom data JSON property to edit its type, consent, and optional reporting columns. Property names are literal top-level JSON keys. Leave both reporting columns empty to collect a property without exposing it in custom reporting views. Explicitly allowing a property without consent adds it to the server-enforced anonymous whitelist.</p>
            <p class="help mb-3">Descriptions belong to the shared implementation model. Values must be flat strings, numbers, booleans, or null; nested data is discarded. Unlisted custom properties still require enhanced consent. The organization marker <code>{{ marker_name|default('orgInternalTraffic') }}</code> remains controlled by the browser marker and is always allowed in anonymous mode.</p>
            <div id="property-rows">
                {% for key, property in model.custom_data_properties %}
                    <details class="box" data-property-row{% if key == unsaved_property %} open{% endif %}>
                        <summary><strong data-property-label>{{ key }}</strong></summary>
                        {% include 'data_model/_property_fields.html.twig' with {index: loop.index0, key: key, property: property} %}
                    </details>
                {% endfor %}
            </div>
            <button class="button" type="button" id="add-property">Add property</button>
            <p class="help">Explicit types reject mismatched values without coercion; null is allowed. Integer values must be whole safe JSON numbers. Float and Double both use approximate double precision for portable reporting. Up to 50 properties. Reporting columns use unique lowercase letters, digits, and underscores, starting with a letter. After views are deployed, keep their aliases and order; append new columns at the end.</p>
        </section>
        <section class="box">
            <h2 class="title is-4">UTM and query parameters</h2>
            <p>Map selected parameters from the current page URL to defined properties. For aliases sharing a destination, the first configured parameter with a nonblank value wins. Explicit properties passed to <code>emit()</code> take precedence.</p>
            <p class="help mb-3">Matching is case-sensitive. The tracker does not save attribution to cookies or local storage, carry it across pages, or capture the full query string. Removing a mapping stops automatic capture of that parameter. URL parameters are strings; send numeric and boolean typed values through emit() or JSON requests instead.</p>
            <div class="table-container">
                <table class="table is-fullwidth model-mappings">
                    <thead><tr><th>URL parameter</th><th>Destination JSON key</th><th><span class="is-sr-only">Actions</span></th></tr></thead>
                    <tbody id="mapping-rows">
                        {% for parameter, property in model.query_parameter_mappings %}
                            <tr>
                                <td data-label="URL parameter"><input class="input" aria-label="URL parameter" name="mappings[{{ loop.index0 }}][parameter]" value="{{ parameter }}" maxlength="64" required></td>
                                <td data-label="Destination JSON key"><input class="input" aria-label="Destination JSON key" name="mappings[{{ loop.index0 }}][property]" value="{{ property }}" maxlength="64" required></td>
                                <td><button class="button is-light" type="button" data-remove-row>Remove</button></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <button class="button" type="button" id="add-mapping">Add parameter mapping</button>
            <p class="help">Up to 100 mappings. Names begin with a letter and may contain letters, digits, underscores, dots, or hyphens (64 characters maximum). The organization marker cannot be set through a query parameter.</p>
        </section>
        <div class="buttons">
            <button class="button is-primary" type="submit"{% if configuration_error %} disabled{% endif %}>Save model</button>
            {% if not configuration_error %}<a class="button" href="{{ path('app_data_model_download') }}">Download saved YAML</a>{% endif %}
        </div>
        <p class="help mb-5">Saves only these model settings to the active environment in <code>config/aggregate.yaml</code> or its environment-specific file. Collection changes affect future requests; they do not erase existing data. Apply reporting changes from the Reporting views page after saving.</p>
    </form>

    <template id="property-row-template"><details class="box" data-property-row open>
        <summary><strong data-property-label>New property</strong></summary>
        {% include 'data_model/_property_fields.html.twig' with {index: 'new', key: '', property: {}} %}
    </details></template>
    <template id="mapping-row-template"><tr>
        <td data-label="URL parameter"><input class="input" aria-label="URL parameter" data-field="parameter" maxlength="64" required></td>
        <td data-label="Destination JSON key"><input class="input" aria-label="Destination JSON key" data-field="property" maxlength="64" required></td>
        <td><button class="button is-light" type="button" data-remove-row>Remove</button></td>
    </tr></template>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            var propertyIndex = {{ model.custom_data_properties|length }};
            var mappingIndex = {{ model.query_parameter_mappings|length }};
            function addRow(kind, key) {
                var isProperty = kind === 'property';
                var container = document.getElementById(kind + '-rows');
                if (container.children.length >= (isProperty ? 50 : 100)) return;
                var row = document.getElementById(kind + '-row-template').content.firstElementChild.cloneNode(true);
                var index = isProperty ? propertyIndex++ : mappingIndex++;
                row.querySelectorAll('[data-field]').forEach(function (field) {
                    field.name = (isProperty ? 'properties' : 'mappings') + '[' + index + '][' + field.dataset.field + ']';
                });
                if (isProperty) {
                    row.querySelectorAll('[data-field]').forEach(function (field) {
                        var previousId = field.id;
                        field.id = 'property-' + index + '-' + field.dataset.field;
                        var label = row.querySelector('label[for="' + previousId + '"]');
                        if (label) label.htmlFor = field.id;
                    });
                }
                if (key) row.querySelector('[data-field="key"]').value = key;
                container.appendChild(row);
                row.querySelector('input').focus();
            }
            document.getElementById('add-property').addEventListener('click', function () { addRow('property'); });
            document.getElementById('add-mapping').addEventListener('click', function () { addRow('mapping'); });
            document.getElementById('data-model-form').addEventListener('click', function (event) {
                var button = event.target.closest('[data-remove-row]');
                if (button) button.closest('[data-property-row], tr').remove();
            });
            document.getElementById('property-rows').addEventListener('input', function (event) {
                if (event.target.dataset.field === 'key') {
                    event.target.closest('[data-property-row]').querySelector('[data-property-label]').textContent = event.target.value || 'New property';
                }
            });
            // Native validation can identify an invalid field inside a closed property.
            document.getElementById('data-model-form').addEventListener('invalid', function (event) {
                var property = event.target.closest('[data-property-row]');
                if (property) property.open = true;
            }, true);
        }());
    </script>
{% endblock %}

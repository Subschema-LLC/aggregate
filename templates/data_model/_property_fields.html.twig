{% set consent_required = property.consent_required is defined ? property.consent_required : true %}
<div class="columns is-multiline mt-3">
    <div class="column is-half">
        <label class="label" for="property-{{ index }}-key">JSON key</label>
        <input class="input" id="property-{{ index }}-key" data-field="key" name="properties[{{ index }}][key]" value="{{ key }}" maxlength="128" required>
    </div>
    <div class="column is-half">
        <label class="label" for="property-{{ index }}-type">JSON value type</label>
        <div class="select is-fullwidth"><select id="property-{{ index }}-type" data-field="type" name="properties[{{ index }}][type]">
            {% for type, label in {scalar: 'Any flat scalar (existing behavior)', string: 'String', integer: 'Integer', float: 'Float (JSON number)', double: 'Double (JSON number)', boolean: 'Boolean'} %}
                <option value="{{ type }}"{% if property.type|default('scalar') == type %} selected{% endif %}>{{ label }}</option>
            {% endfor %}
        </select></div>
    </div>
    <div class="column is-half">
        <label class="label" for="property-{{ index }}-consent">Collection</label>
        <div class="select is-fullwidth"><select id="property-{{ index }}-consent" data-field="consent_required" name="properties[{{ index }}][consent_required]">
            <option value="1"{% if consent_required %} selected{% endif %}>Require enhanced consent</option>
            <option value="0"{% if not consent_required %} selected{% endif %}>Allow without consent</option>
        </select></div>
    </div>
    <div class="column is-half">
        <label class="label" for="property-{{ index }}-description">Description</label>
        <input class="input" id="property-{{ index }}-description" data-field="description" name="properties[{{ index }}][description]" value="{{ property.description|default('') }}" maxlength="1000">
    </div>
    <div class="column is-half">
        <label class="label" for="property-{{ index }}-column">Text reporting column (optional)</label>
        <input class="input" id="property-{{ index }}-column" data-field="column" name="properties[{{ index }}][column]" value="{{ property.column|default('') }}" maxlength="63" pattern="[a-z][a-z0-9_]{0,62}">
    </div>
    <div class="column is-half">
        <label class="label" for="property-{{ index }}-numeric_column">Numeric reporting column (optional)</label>
        <input class="input" id="property-{{ index }}-numeric_column" data-field="numeric_column" name="properties[{{ index }}][numeric_column]" value="{{ property.numeric_column|default('') }}" maxlength="63" pattern="[a-z][a-z0-9_]{0,62}">
        <p class="help">Requires Integer, Float, or Double. Adds a separate column for calculations and preserves the existing text column.</p>
    </div>
</div>
<button class="button is-light" type="button" data-remove-row>Remove property</button>

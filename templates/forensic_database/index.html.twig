{% extends 'base.html.twig' %}

{% block title %}Sync: Forensic database - {{ app_branding.name }}{% endblock %}

{% macro env_help(overrides, key) %}{% if attribute(overrides, key) %}<p class="help">Controlled by <code>{{ key|upper }}</code>.</p>{% endif %}{% endmacro %}

{#
    Settings and status only. This page never reads or shows forensic rows:
    they are read in the forensic database, with its own database accounts.
#}
{% block body %}
{% import _self as help %}
{% set running = status.views|filter(view => view.status == 'running')|length > 0 %}
{% set interval = settings.forensic_database_interval_minutes %}
<div class="reporting-database-page"
     data-controller="pages--reporting-database--index"
     data-pages--reporting-database--index-status-url-value="{{ path('app_forensic_database_status') }}"
     data-pages--reporting-database--index-running-value="{{ running or sync_requested_at ? 'true' : 'false' }}"
     data-pages--reporting-database--index-since-value="{{ sync_requested_at ?? 0 }}">
    <div class="level">
        <div class="level-left">
            <div>
                <h1 class="title">Sync</h1>
                <p class="subtitle">Copy reporting views to another destination on a schedule.</p>
            </div>
        </div>
        <div class="level-right">
            {{ component('Ui:CardControls', {class: 'page-card-controls mb-0'}) }}
        </div>
    </div>
    {{ component('Sync:Navigation', {current: 'app_forensic_database', destinations: sync_destinations}) }}
    <p class="mb-3">Copy the raw events, the archive tables and the private views into a separate, restricted database, for investigating problems without long queries on the application database. Visitor and session IDs are replaced by hashes made with a new random key at every sync; the key is never stored, so no hash can be traced back to a browser.</p>
    {{ component('Ui:DocsLink', {topic: 'reporting.forensic-database', label: 'Forensic database guide'}) }}
    <p class="help mb-3">This page holds settings only. Read the copies in the forensic database itself, with a read-only account limited to the people who investigate problems.</p>

    {% if configuration_error %}<div class="notification is-danger" role="alert">{{ configuration_error }}</div>{% endif %}

    <section class="box" aria-labelledby="forensic-database-summary-title">
        <h2 class="title is-5" id="forensic-database-summary-title">
            {% if settings.forensic_database_enabled %}
                <span class="tag is-success is-medium mr-2">On</span> Copying {{ status.views|length }} table{{ status.views|length == 1 ? '' : 's' }} and view{{ status.views|length == 1 ? '' : 's' }} every {{ interval >= 60 ? (interval / 60) ~ ' hour' ~ (interval > 60 ? 's' : '') : interval ~ ' minutes' }}
            {% else %}
                <span class="tag is-light is-medium mr-2">Off</span> Sync is turned off
            {% endif %}
        </h2>
        <p>Each sync replaces a copy with the current contents of its table or view in one step. Deletions in Aggregate, including retention, reach the copies at the next sync; the forensic database’s own backups keep them until those expire.</p>
        {% if status.scheduler_late %}
            <div class="notification is-warning is-light mt-3" role="status">
                <p><strong>The scheduled sync is not running.</strong> {% if status.last_run %}The last copy started {{ status.last_run|date('Y-m-d H:i', 'UTC') }} UTC.{% else %}Nothing has been copied yet.{% endif %} Set up the server’s scheduled task: <a href="{{ path('app_scheduled_tasks') }}">Scheduled tasks</a> shows the steps for this server. With cron, add this line to the crontab of the user that runs Aggregate:</p>
                <pre class="mt-2 reporting-database-code"><code>{{ cron_line }}</code></pre>
            </div>
        {% endif %}
        <div class="buttons mt-4">
            <button class="button" type="submit" form="forensic-database-test"{% if connection_error %} disabled{% endif %}>
                <span class="icon"><i class="fas fa-plug-circle-check" aria-hidden="true"></i></span><span>Test connection</span>
            </button>
            <button class="button is-primary" type="submit" form="forensic-database-sync"{% if configuration_error or connection_error or not settings.forensic_database_enabled or background_problem or running or sync_requested_at %} disabled{% endif %}>
                <span class="icon"><i class="fas fa-database" aria-hidden="true"></i></span><span>{{ running or sync_requested_at ? 'Syncing…' : 'Sync now' }}</span>
            </button>
        </div>
        {% if background_problem and settings.forensic_database_enabled %}<p class="help">{{ background_problem }}</p>{% endif %}
    </section>

    {# 1. Restrict access #}
    <section class="box" aria-labelledby="forensic-database-access-title">
        <h2 class="title is-4" id="forensic-database-access-title">1. Restrict access</h2>
        {{ component('Ui:DocsLink', {topic: 'reporting.forensic-database-access', label: 'Restrict and mark the database'}) }}
        <p class="mt-3">Create a database of its own for forensic copies, separate from the application and reporting databases, and give read access to it only to the people who investigate problems. Aggregate writes there only once the database says so:</p>
        <ul class="mt-2 mb-3">
            <li><strong>MariaDB 10.5 or later, PostgreSQL:</strong> add <code>{{ mark }}{% if application_database %} source={{ application_database }}{% endif %}</code> to the database’s comment. A database marked as a read-only reporting copy for BI users is always refused.</li>
            <li><strong>MySQL, SQL Server, SQLite:</strong> these keep no database comment, so confirm here instead.</li>
        </ul>
        <form method="post" action="{{ path('app_forensic_database_access') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('forensic_database_settings') }}">
            <div class="field">
                <div class="control"><div class="select"><select id="forensic-database-access" name="access_restricted" aria-label="Access confirmation for engines that cannot be marked"{% if overrides.forensic_database_access_restricted %} disabled{% endif %}>
                    <option value="0"{% if not settings.forensic_database_access_restricted %} selected{% endif %}>Not confirmed</option>
                    <option value="1"{% if settings.forensic_database_access_restricted %} selected{% endif %}>Confirmed restricted</option>
                </select></div></div>
                {{ help.env_help(overrides, 'forensic_database_access_restricted') }}
            </div>
            {% if not settings.forensic_database_access_restricted %}
                <label class="checkbox reporting-database-confirm">
                    <input type="checkbox" name="access_confirmed" value="1">
                    I confirm that only the people who investigate problems can read the forensic database, and that its copies of raw events are protected like the application database.
                </label>
            {% endif %}
            <button class="button is-primary mt-3" type="submit"{% if configuration_error or overrides.forensic_database_access_restricted %} disabled{% endif %}>Save</button>
        </form>
    </section>

    {# 2. Connection #}
    <section class="box" aria-labelledby="forensic-database-connection-title">
        <h2 class="title is-4" id="forensic-database-connection-title">2. Connect the forensic database</h2>
        {{ component('Ui:DocsLink', {topic: 'reporting.forensic-database-setup', label: 'Create the database and its users'}) }}
        {% if location %}
            <p class="notification is-success is-light mt-4">Forensic database: <strong>{{ location }}</strong>.</p>
        {% else %}
            <p class="notification is-warning is-light mt-4">{{ connection_error }}</p>
        {% endif %}
        <p>Enter the forensic database and a user that can create and drop tables in it. Aggregate tests the connection, checks the mark or your confirmation, and saves it to <code>.env.local</code> on the server as <code>FORENSIC_DATABASE_URL</code>.</p>
        {% if connection_problem %}
            <p class="notification is-info is-light mt-3">{{ connection_problem }}</p>
        {% else %}
            <form id="forensic-database-connection" method="post" action="{{ path('app_forensic_database_connection') }}" class="mt-4" autocomplete="off">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('forensic_database_settings') }}">
                <fieldset class="field">
                    <legend class="label">Database type</legend>
                    <div class="control">
                        {% for value, type in types %}
                            <label class="radio mr-4">
                                <input type="radio" name="type" value="{{ value }}" data-pages--reporting-database--index-target="type" data-action="pages--reporting-database--index#showType"{% if connection.type == value %} checked{% endif %}{% if not type.available %} disabled{% endif %}>
                                {{ type.label }}{% if not type.available %} <span class="has-text-grey">(PHP lacks {{ type.extension }})</span>{% endif %}
                            </label>
                        {% endfor %}
                    </div>
                </fieldset>
                <div data-pages--reporting-database--index-target="serverFields">
                    <div class="columns">
                        <div class="column field">
                            <label class="label" for="forensic-database-host">Server</label>
                            <div class="control"><input class="input" id="forensic-database-host" name="host" type="text" maxlength="255" value="{{ connection.type != 'sqlite' ? connection.host : 'localhost' }}" spellcheck="false"></div>
                        </div>
                        <div class="column is-one-quarter field">
                            <label class="label" for="forensic-database-port">Port</label>
                            <div class="control"><input class="input" id="forensic-database-port" name="port" type="text" inputmode="numeric" maxlength="5" value="{{ connection.type != 'sqlite' ? connection.port : '' }}" placeholder="Default"></div>
                        </div>
                    </div>
                    <div class="columns">
                        <div class="column field">
                            <label class="label" for="forensic-database-user">User name</label>
                            <div class="control"><input class="input" id="forensic-database-user" name="user" type="text" maxlength="128" value="{{ connection.user }}" spellcheck="false"></div>
                        </div>
                        <div class="column field">
                            <label class="label" for="forensic-database-password">Password</label>
                            <div class="control"><input class="input" id="forensic-database-password" name="password" type="password" maxlength="1024" autocomplete="new-password" placeholder="{{ connection.has_password ? 'Saved; leave empty to keep it' : '' }}"></div>
                        </div>
                    </div>
                </div>
                <div class="field">
                    <label class="label" for="forensic-database-name">Database name, or SQLite file</label>
                    <div class="control"><input class="input" id="forensic-database-name" name="database" type="text" maxlength="255" value="{{ connection.database }}" placeholder="aggregate_forensic, or var/forensic.db for SQLite" spellcheck="false"></div>
                    <p class="help">Use a database of its own: Aggregate refuses the application and reporting databases.</p>
                </div>
                <div class="field" data-pages--reporting-database--index-target="sqlsrvFields">
                    <label class="checkbox"><input type="checkbox" name="trust_certificate" value="1"{% if connection.trust_certificate %} checked{% endif %}> Trust the server certificate <span class="has-text-grey">(SQL Server with a self-signed certificate)</span></label>
                </div>
                <div class="buttons">
                    <button class="button is-primary" type="submit">Test and save</button>
                    {% if connection_saved_here %}<button class="button is-danger is-light" type="submit" form="forensic-database-remove-connection">Remove connection</button>{% endif %}
                </div>
            </form>
            <p class="help">The password is stored only in <code>.env.local</code>, never shown here or logged. Leave it empty to keep the saved one while the type, server and user stay the same. From the command line: <code>php bin/console app:forensic-database:configure</code>.</p>
        {% endif %}
    </section>

    {# 3. Tables and views #}
    <form method="post" action="{{ path('app_forensic_database_views') }}" class="box" aria-labelledby="forensic-database-views-title">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('forensic_database_settings') }}">
        <h2 class="title is-4" id="forensic-database-views-title">3. Choose what to copy</h2>
        {{ component('Ui:DocsLink', {topic: 'reporting.forensic-database-copies', label: 'What each copy contains'}) }}
        <div class="notification is-warning is-light mt-4">
            Everything here is row-level or unsuppressed data, outside Aggregate’s suppression. Visitor and session IDs are hashed, but one browser’s events stay linked within a copy, so the copies are pseudonymous personal data, not anonymous.
        </div>
        <fieldset class="field">
            <legend class="label">Table copies</legend>
            <p class="help mb-2">Raw tables, every column, which no other sync copies.</p>
            {% for table, description in forensic_tables %}
                <label class="checkbox reporting-database-view">
                    <input type="checkbox" name="tables[]" value="{{ table }}" data-pages--reporting-database--index-target="private" data-action="pages--reporting-database--index#togglePrivate" data-saved="{{ table in settings.forensic_database_tables ? '1' : '0' }}"{% if table in settings.forensic_database_tables %} checked{% endif %}{% if overrides.forensic_database_tables %} disabled{% endif %}>
                    <code>{{ table }}</code> <span class="has-text-grey">{{ description }}</span>
                </label>
            {% endfor %}
            {{ help.env_help(overrides, 'forensic_database_tables') }}
        </fieldset>
        <fieldset class="field">
            <legend class="label">Private views</legend>
            <p class="help mb-2">The private reporting views, as they are.</p>
            {% for view, description in private_views %}
                <label class="checkbox reporting-database-view">
                    <input type="checkbox" name="views[]" value="{{ view }}" data-pages--reporting-database--index-target="private" data-action="pages--reporting-database--index#togglePrivate" data-saved="{{ view in settings.forensic_database_views ? '1' : '0' }}"{% if view in settings.forensic_database_views %} checked{% endif %}{% if overrides.forensic_database_views %} disabled{% endif %}>
                    <code>{{ view }}</code> <span class="has-text-grey">{{ description }}</span>
                </label>
            {% endfor %}
            {{ help.env_help(overrides, 'forensic_database_views') }}
        </fieldset>
        <label class="checkbox reporting-database-confirm" data-pages--reporting-database--index-target="confirmation">
            <input type="checkbox" name="confirmed" value="1">
            I confirm that what I added may be copied to the forensic database, for investigating problems only.
        </label>
        <button class="button is-primary mt-4" type="submit"{% if configuration_error %} disabled{% endif %}>Save</button>
    </form>

    {# 4. Schedule #}
    <form method="post" action="{{ path('app_forensic_database_schedule') }}" class="box" aria-labelledby="forensic-database-schedule-title">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('forensic_database_settings') }}">
        <h2 class="title is-4" id="forensic-database-schedule-title">4. Schedule</h2>
        {{ component('Ui:DocsLink', {topic: 'reporting.forensic-database-schedule', label: 'Scheduling'}) }}
        <div class="columns mt-3">
            <div class="column field">
                <label class="label" for="forensic-database-enabled">Sync</label>
                <div class="control"><div class="select"><select id="forensic-database-enabled" name="enabled"{% if overrides.forensic_database_enabled %} disabled{% endif %}>
                    <option value="0"{% if not settings.forensic_database_enabled %} selected{% endif %}>Off</option>
                    <option value="1"{% if settings.forensic_database_enabled %} selected{% endif %}>On</option>
                </select></div></div>
                {{ help.env_help(overrides, 'forensic_database_enabled') }}
            </div>
            <div class="column field">
                <label class="label" for="forensic-database-interval">Every</label>
                <div class="control"><div class="select"><select id="forensic-database-interval" name="interval"{% if overrides.forensic_database_interval_minutes %} disabled{% endif %}>
                    {% for minutes in intervals %}
                        <option value="{{ minutes }}"{% if interval == minutes %} selected{% endif %}>{{ minutes < 60 ? minutes ~ ' minutes' : (minutes == 60 ? '1 hour' : (minutes / 60) ~ ' hours') }}</option>
                    {% endfor %}
                </select></div></div>
                {{ help.env_help(overrides, 'forensic_database_interval_minutes') }}
            </div>
        </div>
        <p class="mb-3">The server’s scheduled task copies them, about once per interval. Each sync reads every selected table whole from the application database and rehashes every identifier, so <code>forensic_events_v1</code> is rewritten each time: once a day, the default, keeps that load low.</p>
        <button class="button is-primary" type="submit"{% if configuration_error %} disabled{% endif %}>Save schedule</button>
    </form>

    {# Status: names, counts and times only, never rows. #}
    <section class="box" aria-labelledby="forensic-database-status-title">
        <h2 class="title is-4" id="forensic-database-status-title">Sync status</h2>
        {% if status.views is empty %}
            <p>Nothing is selected.</p>
        {% else %}
            <div class="table-container">
                <table class="table is-fullwidth is-striped reporting-database-status">
                    <thead><tr><th scope="col">Copy</th><th scope="col">Status</th><th scope="col">Last successful sync</th><th scope="col">Rows</th><th scope="col">Next sync</th><th scope="col">Details</th></tr></thead>
                    <tbody>
                    {% for view in status.views %}
                        <tr>
                            <th scope="row"><code>{{ view.view }}</code></th>
                            <td>
                                {% if view.status == 'succeeded' %}<span class="tag is-success is-light">Copied</span>
                                {% elseif view.status == 'failed' %}<span class="tag is-danger is-light">Failed</span>
                                {% elseif view.status == 'running' %}<span class="tag is-info is-light">Copying…</span>
                                {% else %}<span class="tag is-light">Not copied yet</span>{% endif %}
                            </td>
                            <td>{{ view.succeeded_at ? view.succeeded_at|date('Y-m-d H:i', 'UTC') ~ ' UTC' : '—' }}</td>
                            <td>{{ view.row_count is not null ? view.row_count|number_format : '—' }}</td>
                            <td>{{ not settings.forensic_database_enabled ? 'Off' : (view.next_due ? view.next_due|date('Y-m-d H:i', 'UTC') ~ ' UTC' : 'Next run') }}</td>
                            <td class="reporting-database-message">{{ view.message ?? '' }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
        <p class="help">From the command line: <code>php bin/console app:forensic-database:check</code> shows this status and tests the connection; <code>php bin/console app:forensic-database:sync --force</code> copies now.</p>
    </section>

    {# Forms submitted by buttons above. #}
    <form id="forensic-database-test" method="post" action="{{ path('app_forensic_database_test') }}" hidden><input type="hidden" name="_csrf_token" value="{{ csrf_token('forensic_database_settings') }}"></form>
    <form id="forensic-database-sync" method="post" action="{{ path('app_forensic_database_sync') }}" hidden><input type="hidden" name="_csrf_token" value="{{ csrf_token('forensic_database_settings') }}"></form>
    <form id="forensic-database-remove-connection" method="post" action="{{ path('app_forensic_database_connection_remove') }}" hidden data-turbo-confirm="Remove the forensic database connection from .env.local? Copies already made stay in that database."><input type="hidden" name="_csrf_token" value="{{ csrf_token('forensic_database_settings') }}"></form>
</div>
{% endblock %}

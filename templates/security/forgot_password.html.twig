{% extends 'base.html.twig' %}

{% block title %}Forgot password | {{ app_branding.name }}{% endblock %}

{% block body %}
<div class="columns is-centered py-5">
    <div class="column is-10-mobile is-7-tablet is-5-desktop">
        <div class="card">
            <div class="card-content p-5">
                <div class="has-text-centered mb-4">
                    <div class="mb-3">
                        {{ component('Branding:Identity', {branding: app_branding}) }}
                    </div>
                    <h1 class="title is-4 mb-1">Reset your password</h1>
                    <p class="subtitle is-6">How to recover access to your account</p>
                </div>

                {% if mfa_required|default(false) %}
                    <div class="notification is-info is-light mb-4">
                        Two-step sign-in is required on this installation, so emailed sign-in codes cannot sign in on their own.
                    </div>
                {% else %}
                    <div class="notification is-info is-light mb-4">
                        Emailed sign-in codes are not enabled on this installation.
                    </div>
                {% endif %}

                <div class="content is-size-6">
                    <p><strong>Standard users:</strong> Ask an administrator to set a new password for your account under <strong>Administration &rarr; Users</strong>.</p>
                    <p><strong>Administrators &amp; server operators:</strong> Reset any user’s password from the application directory on the server:</p>
                    <pre><code>php bin/console app:user:reset-password &lt;username&gt;</code></pre>
                    {% if not (mfa_required|default(false)) %}
                        <p class="is-size-7 has-text-grey">To let users with an email address sign in with a one-time code and reset their own password, an administrator can configure transactional email and turn on <strong>Sign-in codes</strong> under <strong>Administration &rarr; Email</strong>.</p>
                    {% endif %}
                </div>

                <div class="mt-5">
                    <a class="button is-primary is-fullwidth" href="{{ path('app_login') }}">
                        <span class="icon is-small mr-1"><i class="fas fa-arrow-left" aria-hidden="true"></i></span>
                        <span>Back to sign in</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
